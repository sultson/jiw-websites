{
  "name": "@jiw/monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "ship": "set -a; [ ! -f .env ] || . ./.env; set +a; pnpm -r run --if-present ship",
    "ship:dry-run": "set -a; [ ! -f .env ] || . ./.env; set +a; pnpm -r run --if-present ship:dry-run",
    "dev:my-kim-nails": "pnpm --filter @jiw/my-kim-nails dev",
    "dev:nail-it-rosmalen": "pnpm --filter @jiw/nail-it-rosmalen dev",
    "dev:anart": "pnpm --filter @jiw/anart dev",
    "dev:claires-skincare": "pnpm --filter @jiw/claires-skincare dev",
    "dev:salon-lazoa": "pnpm --filter @jiw/salon-lazoa dev",
    "dev:smooth-by-lau": "pnpm --filter @jiw/smooth-by-lau dev",
    "dev:rn-schilders": "pnpm --filter @jiw/rn-schilders dev",
    "dev:beautique-jeanine": "pnpm --filter @jiw/beautique-jeanine dev",
    "dev:xenon": "pnpm --filter @jiw/xenon dev",
    "dev:adriaan-totaalonderhoud": "pnpm --filter @jiw/adriaan-totaalonderhoud dev",
    "dev:maefluence": "pnpm --filter @jiw/maefluence dev",
    "dev:zk-beauty": "pnpm --filter @jiw/zk-beauty dev",
    "dev:resq-protec": "pnpm --filter @jiw/resq-protec dev",
    "dev:klashorst": "pnpm --filter @jiw/klashorst dev",
    "dev:klashorst-studio": "pnpm --filter @jiw/klashorst-studio dev",
    "dev:toonoverleven": "pnpm --filter @jiw/toonoverleven dev",
    "dev:winterswijkvakantiehuis": "pnpm --filter @jiw/winterswijkvakantiehuis dev",
    "dev:fleurig": "pnpm --filter @jiw/fleurig dev",
    "dev:3-diaspora": "pnpm --filter @jiw/3-diaspora dev",
    "dev:mts-badkamers": "pnpm --filter @jiw/mts-badkamers dev",
    "dev:expat-relocation-landers": "pnpm --filter @jiw/expat-relocation-landers dev",
    "dev:installatie-veilig": "pnpm --filter @jiw/installatie-veilig dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "wrangler": "^4.85.0"
  }
}
