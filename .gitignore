# mts-badkamers bouwt met build.mjs naar apps/mts-badkamers/site/. Die map is
# half bron, half bouwsel: styles.css, app.js, f/, video/, poster/, de losse
# svg's en icon.png horen in git, de rest wordt gegenereerd.
apps/mts-badkamers/site/index.html
apps/mts-badkamers/site/404.html
apps/mts-badkamers/site/sitemap.xml
apps/mts-badkamers/site/robots.txt
