---
import Layout from '../components/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { route } from '../lib/i18n';
---

<Layout
  lang="nl"
  title="Pagina niet gevonden | Omnia Dental"
  description="Deze pagina bestaat niet of is verplaatst."
  pathNl="/404"
  pathEn="/404"
  noindex
>
  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-sage/25 to-gold/25 text-sage-ink">
      <Icon name="tooth" size={32} />
    </span>
    <p class="mt-8 font-display text-7xl text-ink">404</p>
    <h1 class="mt-3 font-display text-2xl text-ink md:text-3xl">Deze pagina konden we niet vinden</h1>
    <p class="mt-3 max-w-md text-pretty text-ink-soft">
      De pagina bestaat niet of is verplaatst. Ga terug naar de homepagina of bekijk onze behandelingen.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href={route('home', 'nl')} variant="primary" icon="arrow">Naar de homepagina</Button>
      <Button href={route('treatments', 'nl')} variant="ghost" iconRight="arrow">Behandelingen</Button>
    </div>
  </section>
</Layout>
