---
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SpoedView from '../../components/SpoedView.astro';
import { route } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
---

<Layout
  lang="en"
  title="Dental emergency | Hoofddorp | Omnia Dental"
  description="Acute toothache or a broken tooth in Hoofddorp? See what you can do and report your emergency. Call us as early in the day as possible."
  pathNl={route('spoed', 'nl')}
  pathEn={route('spoed', 'en')}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: route('home', 'en') },
    { name: 'Emergency', path: route('spoed', 'en') },
  ])]}
>
  <PageHeader
    lang="en"
    eyebrow="Emergency care"
    title="Dental emergency"
    subtitle="Acute pain, a broken tooth or swelling? We are happy to help you quickly. Read exactly what you can do below."
    current="Emergency"
  />
  <SpoedView lang="en" />
</Layout>
