---
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { route } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
---

<Layout
  lang="en"
  title="Patient reviews | Dentist Hoofddorp | Omnia Dental"
  description="Read reviews from patients of Omnia Dental in Hoofddorp. From anxious patients to complex treatments, discover why people choose our practice."
  pathNl={route('reviews', 'nl')}
  pathEn={route('reviews', 'en')}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: route('home', 'en') },
    { name: 'Reviews', path: route('reviews', 'en') },
  ])]}
>
  <PageHeader
    lang="en"
    eyebrow="Reviews"
    title="What patients say about us"
    subtitle="Stories from patients about their visit to our practice, from a nerve-racking first check-up to more involved treatments."
    current="Reviews"
  />
  <div class="py-14"><ReviewsSection lang="en" showAll heading="Reviews from our patients" /></div>
  <CtaBanner lang="en" />
</Layout>
