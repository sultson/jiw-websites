---
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AboutView from '../../components/AboutView.astro';
import { route } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';
---

<Layout
  lang="en"
  title="About us | Dentist Naresh Gangaram Panday | Hoofddorp"
  description="Meet Omnia Dental and dentist Naresh Gangaram Panday in Hoofddorp. Broad expertise, personal attention and all dental care under one roof."
  pathNl={route('about', 'nl')}
  pathEn={route('about', 'en')}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: route('home', 'en') },
    { name: 'About', path: route('about', 'en') },
  ])]}
>
  <PageHeader
    lang="en"
    eyebrow="About Omnia Dental"
    title="One trusted team for your whole mouth"
    subtitle="A modern dental practice in Hoofddorp where broad expertise and personal attention come together."
    current="About"
  />
  <AboutView lang="en" />
</Layout>
