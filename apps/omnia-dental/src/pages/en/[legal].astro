---
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LegalView from '../../components/LegalView.astro';
import { legalDocs } from '../../data/legal';
import { route } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';

const legalKeyToRoute = {
  privacy: 'privacy',
  cookie: 'cookie',
  terms: 'terms',
  conduct: 'conduct',
  complaints: 'complaints',
} as const;

export function getStaticPaths() {
  const keyToRoute = {
    privacy: 'privacy',
    cookie: 'cookie',
    terms: 'terms',
    conduct: 'conduct',
    complaints: 'complaints',
  } as const;
  return legalDocs.map((doc) => ({
    params: { legal: route(keyToRoute[doc.key], 'en').replace('/en/', '') },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const routeKey = legalKeyToRoute[doc.key];
---

<Layout
  lang="en"
  title={doc.metaTitle.en}
  description={doc.metaDescription.en}
  pathNl={route(routeKey, 'nl')}
  pathEn={route(routeKey, 'en')}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Home', path: route('home', 'en') },
    { name: doc.title.en, path: route(routeKey, 'en') },
  ])]}
>
  <PageHeader lang="en" eyebrow="Legal" title={doc.title.en} current={doc.title.en} />
  <LegalView doc={doc} lang="en" />
</Layout>
