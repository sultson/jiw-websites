---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqView from '../components/FaqView.astro';
import { route } from '../lib/i18n';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo';
import { faqItems } from '../data/faq';
---

<Layout
  lang="nl"
  title="Veelgestelde vragen | Tandarts Hoofddorp | Omnia Dental"
  description="Antwoorden op veelgestelde vragen over inschrijven, afspraken, tarieven, vergoeding en spoed bij Omnia Dental, uw tandarts in Hoofddorp."
  pathNl={route('faq', 'nl')}
  pathEn={route('faq', 'en')}
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: route('home', 'nl') },
      { name: 'Veelgestelde vragen', path: route('faq', 'nl') },
    ]),
    faqJsonLd(faqItems.map((i) => ({ q: i.q.nl, a: i.a.nl }))),
  ]}
>
  <PageHeader
    lang="nl"
    eyebrow="Veelgestelde vragen"
    title="Antwoord op uw vragen"
    subtitle="Van inschrijven en afspraken tot tarieven, vergoeding en spoed. Vindt u uw vraag niet? Neem gerust contact met ons op."
    current="Veelgestelde vragen"
  />
  <FaqView lang="nl" />
</Layout>
