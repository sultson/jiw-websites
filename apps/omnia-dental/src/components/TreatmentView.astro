---
import Icon from './Icon.astro';
import Button from './Button.astro';
import CtaBanner from './CtaBanner.astro';
import FaqList from './FaqList.astro';
import TreatmentCard from './TreatmentCard.astro';
import { site } from '../data/site';
import { t, route, type Lang } from '../lib/i18n';
import { treatments, categoryMeta, treatmentIcon } from '../data/treatments';
import type { Treatment } from '../data/types';

interface Props {
  treatment: Treatment;
  lang: Lang;
}
const { treatment: tt, lang } = Astro.props;
const tr = t(lang);
const cat = categoryMeta[tt.category];
const icon = treatmentIcon[tt.key] ?? 'tooth';
const imageBase = tt.image.replace(/\.webp$/, '');
const related = treatments.filter((x) => x.category === tt.category && x.key !== tt.key).slice(0, 3);
const relatedFill =
  related.length < 3
    ? treatments.filter((x) => x.key !== tt.key && !related.includes(x)).slice(0, 3 - related.length)
    : [];
const relatedAll = [...related, ...relatedFill];

const whatParas = tt.what[lang].split('\n\n');
---

<!-- Breadcrumb -->
<nav class="container-x pt-8 text-[0.85rem]" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5 text-ink-mute">
    <li><a href={route('home', lang)} class="hover:text-ink">{lang === 'nl' ? 'Home' : 'Home'}</a></li>
    <li><Icon name="chevronRight" size={14} /></li>
    <li><a href={route('treatments', lang)} class="hover:text-ink">{tr.nav.treatments}</a></li>
    <li><Icon name="chevronRight" size={14} /></li>
    <li class="font-medium text-ink-soft" aria-current="page">{tt.name[lang]}</li>
  </ol>
</nav>

<!-- Hero -->
<section class="container-x grid items-center gap-10 py-10 lg:grid-cols-2 lg:py-14">
  <div class="reveal">
    <p class="eyebrow flex items-center gap-2">
      <Icon name={cat.icon as any} size={15} class="text-gold-deep" />
      {cat.label[lang]}
    </p>
    <h1 class="mt-3 font-display text-[2.4rem] leading-[1.06] text-ink md:text-5xl">{tt.name[lang]}</h1>
    {tt.duration && (
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-sage/12 px-3.5 py-1.5 text-[0.85rem] font-medium text-sage-ink">
        <Icon name="clock" size={15} /> {tt.duration[lang]}
      </p>
    )}
    <p class="mt-5 max-w-xl text-pretty text-lg leading-relaxed text-ink-soft">{tt.intro[lang]}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={route('contact', lang)} variant="primary" size="lg" icon="calendar" appointmentTrigger>{tr.cta.intake}</Button>
      <Button href={site.phone.href} variant="ghost" size="lg" icon="phone">{site.phone.display}</Button>
    </div>
  </div>

  <div class="reveal" data-delay="100ms">
    <div class={`relative overflow-hidden rounded-section surface-ring shadow-lift ${tt.imageKind === 'illustration' ? 'bg-gradient-to-br from-cream-deep to-stone p-3' : ''}`}>
      <img
        src={`${imageBase}-672.webp`}
        srcset={`${imageBase}-420.webp 420w, ${imageBase}-672.webp 672w, ${tt.image} 860w`}
        sizes="(min-width: 1024px) 560px, 100vw"
        alt={tt.imageAlt[lang]}
        width="720"
        height="560"
        fetchpriority="high"
        class={`w-full ${tt.imageKind === 'illustration' ? 'aspect-[4/3] rounded-3xl object-cover' : 'aspect-[4/3] object-cover'}`}
      />
      {tt.imageKind === 'photo' && <div class="hairline-gold absolute inset-x-0 top-0 h-px"></div>}
    </div>
  </div>
</section>

<!-- What + for whom -->
<section class="container-x mt-10">
  <div class="grid gap-10 lg:grid-cols-[1.3fr_0.7fr]">
    <div class="reveal">
      <h2 class="font-display text-2xl text-ink md:text-3xl">{lang === 'nl' ? 'Wat houdt het in?' : 'What does it involve?'}</h2>
      <div class="mt-5 space-y-4 text-pretty leading-relaxed text-ink-soft">
        {whatParas.map((para) => <p>{para}</p>)}
      </div>
    </div>
    <aside class="reveal" data-delay="80ms">
      <div class="card p-6">
        <h3 class="flex items-center gap-2 font-display text-xl text-ink">
          <Icon name="user" size={18} class="text-sage-deep" />
          {lang === 'nl' ? 'Voor wie?' : 'For whom?'}
        </h3>
        <p class="mt-3 text-pretty text-[0.95rem] leading-relaxed text-ink-soft">{tt.forWhom[lang]}</p>
      </div>
    </aside>
  </div>
</section>

<!-- Steps -->
{tt.steps.length > 0 && (
  <section class="container-x mt-20">
    <div class="max-w-2xl reveal">
      <p class="eyebrow">{lang === 'nl' ? 'De behandeling' : 'The treatment'}</p>
      <h2 class="mt-3 font-display text-2xl text-ink md:text-3xl">{lang === 'nl' ? 'Zo verloopt het bij ons' : 'How it goes with us'}</h2>
    </div>
    <ol class="mt-10 grid gap-5 md:grid-cols-2">
      {tt.steps.map((step, i) => (
        <li class="card flex gap-5 p-6 reveal" data-delay={`${(i % 2) * 80}ms`}>
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-sage/25 to-gold/30 font-display text-lg text-ink">
            {i + 1}
          </span>
          <div>
            <h3 class="font-display text-lg text-ink">{step.title[lang]}</h3>
            <p class="mt-1.5 text-pretty text-[0.92rem] leading-relaxed text-ink-soft">{step.body[lang]}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

<!-- Benefits -->
{tt.benefits.length > 0 && (
  <section class="container-x mt-20">
    <div class="overflow-hidden rounded-section bg-gradient-to-br from-cream-deep to-stone p-8 surface-ring md:p-12">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div class="reveal">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/70 text-gold-deep shadow-sm"><Icon name={icon as any} size={24} /></span>
          <h2 class="mt-5 font-display text-2xl text-ink md:text-3xl">{lang === 'nl' ? 'Waarom kiezen voor deze behandeling' : 'Why choose this treatment'}</h2>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 reveal" data-delay="100ms">
          {tt.benefits.map((benefit) => (
            <li class="flex items-start gap-3 rounded-2xl bg-white/55 p-4 surface-ring">
              <Icon name="checkCircle" size={20} class="mt-0.5 shrink-0 text-sage-deep" />
              <span class="text-[0.92rem] leading-relaxed text-ink-soft">{benefit[lang]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<!-- FAQ -->
{tt.faq.length > 0 && (
  <section class="container-x mt-20">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <p class="eyebrow">{lang === 'nl' ? 'Vragen' : 'Questions'}</p>
        <h2 class="mt-3 font-display text-2xl text-ink md:text-3xl">{lang === 'nl' ? 'Over ' + tt.name[lang].toLowerCase() : 'About ' + tt.name[lang].toLowerCase()}</h2>
      </div>
      <div class="reveal" data-delay="80ms">
        <FaqList items={tt.faq} lang={lang} />
      </div>
    </div>
  </section>
)}

<!-- Related -->
{relatedAll.length > 0 && (
  <section class="container-x mt-24">
    <div class="mb-10 flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl text-ink md:text-3xl reveal">{lang === 'nl' ? 'Andere behandelingen' : 'Other treatments'}</h2>
      <a href={route('treatments', lang)} class="hidden items-center gap-1.5 text-[0.9rem] font-semibold text-sage-ink link-underline sm:inline-flex reveal">
        {tr.cta.allTreatments} <Icon name="arrow" size={15} />
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {relatedAll.map((rt, i) => (
        <div class="reveal" data-delay={`${(i % 3) * 70}ms`}><TreatmentCard treatment={rt} lang={lang} /></div>
      ))}
    </div>
  </section>
)}

<div class="mt-24"><CtaBanner lang={lang} /></div>
