---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { route, type Lang } from '../lib/i18n';
import { legalDocs } from '../data/legal';
import type { LegalDoc } from '../data/types';

interface Props {
  doc: LegalDoc;
  lang: Lang;
}
const { doc, lang } = Astro.props;

const legalKeyToRoute = {
  privacy: 'privacy',
  cookie: 'cookie',
  terms: 'terms',
  conduct: 'conduct',
  complaints: 'complaints',
} as const;

const others = legalDocs.filter((d) => d.key !== doc.key);
const updated = new Date(doc.lastUpdated).toLocaleDateString(lang === 'nl' ? 'nl-NL' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section class="container-x py-14">
  <div class="grid gap-12 lg:grid-cols-[1.4fr_0.6fr] lg:items-start">
    <article class="max-w-2xl">
      <p class="flex items-center gap-2 text-[0.85rem] text-ink-mute reveal">
        <Icon name="clock" size={14} />
        {lang === 'nl' ? 'Laatst bijgewerkt op' : 'Last updated'} {updated}
      </p>
      <p class="mt-5 text-pretty text-lg leading-relaxed text-ink-soft reveal">{doc.intro[lang]}</p>

      <div class="mt-10 space-y-10">
        {doc.sections.map((sec, i) => (
          <section class="reveal" data-delay={`${Math.min(i, 4) * 40}ms`}>
            <h2 class="font-display text-xl text-ink md:text-2xl">{sec.heading[lang]}</h2>
            <div class="mt-3 space-y-3 text-pretty leading-relaxed text-ink-soft">
              {sec.body.map((para) => <p>{para[lang]}</p>)}
            </div>
            {sec.bullets && sec.bullets.length > 0 && (
              <ul class="mt-4 space-y-2.5">
                {sec.bullets.map((b) => (
                  <li class="flex items-start gap-3 text-ink-soft">
                    <Icon name="check" size={18} class="mt-1 shrink-0 text-sage-deep" />
                    <span class="leading-relaxed">{b[lang]}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <div class="mt-12 rounded-2xl bg-cream-deep/60 p-6">
        <h2 class="font-display text-lg text-ink">{lang === 'nl' ? 'Vragen over dit document?' : 'Questions about this document?'}</h2>
        <p class="mt-2 text-[0.92rem] text-ink-soft">
          {lang === 'nl' ? 'Neem gerust contact met ons op.' : 'Feel free to contact us.'}
        </p>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-[0.92rem]">
          <a href={`mailto:${site.email}`} class="inline-flex items-center gap-1.5 font-semibold text-sage-ink link-underline"><Icon name="mail" size={15} />{site.email}</a>
          <a href={site.phone.href} class="inline-flex items-center gap-1.5 font-semibold text-sage-ink link-underline"><Icon name="phone" size={15} />{site.phone.display}</a>
        </div>
      </div>
    </article>

    <aside class="lg:sticky lg:top-28 reveal" data-delay="100ms">
      <div class="card p-6">
        <h2 class="font-display text-lg text-ink">{lang === 'nl' ? 'Overige documenten' : 'Other documents'}</h2>
        <ul class="mt-4 space-y-1">
          {others.map((d) => (
            <li>
              <a href={route(legalKeyToRoute[d.key], lang)} class="flex items-center justify-between gap-2 rounded-lg px-2 py-2 text-[0.92rem] text-ink-soft transition-colors hover:bg-cream hover:text-ink">
                {d.title[lang]}
                <Icon name="chevronRight" size={15} class="text-ink-mute" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>
