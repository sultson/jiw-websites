---
import Icon from './Icon.astro';
import TreatmentCard from './TreatmentCard.astro';
import CtaBanner from './CtaBanner.astro';
import { treatmentsByCategory, categoryMeta } from '../data/treatments';
import { type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const groups = treatmentsByCategory();
---

<section class="container-x py-14">
  {groups.map((group, gi) => (
    <div class={gi === 0 ? '' : 'mt-16'}>
      <div class="mb-8 flex items-center gap-3 reveal">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-sage/25 to-gold/25 text-sage-ink">
          <Icon name={categoryMeta[group.category].icon as any} size={22} />
        </span>
        <h2 class="font-display text-2xl text-ink md:text-3xl">{categoryMeta[group.category].label[lang]}</h2>
        <span class="h-px flex-1 bg-ink/8"></span>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {group.items.map((tt, i) => (
          <div class="reveal" data-delay={`${(i % 3) * 70}ms`}><TreatmentCard treatment={tt} lang={lang} /></div>
        ))}
      </div>
    </div>
  ))}
</section>

<div class="mt-6"><CtaBanner lang={lang} /></div>
