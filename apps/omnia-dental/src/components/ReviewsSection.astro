---
import Icon from './Icon.astro';
import { type Lang } from '../lib/i18n';
import { reviews } from '../data/reviews';
import { treatmentByKey } from '../data/treatments';

interface Props {
  lang: Lang;
  heading?: string;
  showAll?: boolean;
}
const { lang, heading, showAll = false } = Astro.props;
const list = showAll ? reviews : reviews.slice(0, 6);
---

<section class="container-x">
  <div class="mb-12 max-w-xl reveal">
    <p class="eyebrow">{lang === 'nl' ? 'Ervaringen' : 'Reviews'}</p>
    <h2 class="mt-3 font-display text-3xl text-ink md:text-[2.5rem]">
      {heading ?? (lang === 'nl' ? 'Wat patiënten over ons zeggen' : 'What patients say about us')}
    </h2>
  </div>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {list.map((review, i) => {
      const treatment = review.treatmentKey ? treatmentByKey(review.treatmentKey) : undefined;
      return (
        <figure class="card flex flex-col p-6 reveal" data-delay={`${(i % 3) * 80}ms`}>
          <div class="flex items-center justify-between">
            <div class="flex">
              {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} class="text-gold" fill="currentColor" />)}
            </div>
            {treatment && (
              <span class="rounded-full bg-sage/12 px-2.5 py-1 text-[0.72rem] font-semibold text-sage-ink">
                {treatment.name[lang]}
              </span>
            )}
          </div>
          <blockquote class="mt-4 flex-1 text-pretty leading-relaxed text-ink-soft">“{review.body[lang]}”</blockquote>
          <figcaption class="mt-5 flex items-center gap-3 border-t border-ink/8 pt-4">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-sage/30 to-gold/30 font-display text-lg text-ink">
              {review.name.charAt(0)}
            </span>
            <span>
              <span class="block text-[0.92rem] font-semibold text-ink">{review.name}</span>
              {review.context && <span class="block text-[0.8rem] text-ink-mute">{review.context[lang]}</span>}
            </span>
          </figcaption>
        </figure>
      );
    })}
  </div>
</section>
