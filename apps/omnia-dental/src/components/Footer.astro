---
import Icon from './Icon.astro';
import { site, dayLabels } from '../data/site';
import { t, route, treatmentPath, type Lang } from '../lib/i18n';
import { treatments } from '../data/treatments';
import { legalDocs } from '../data/legal';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const year = 2026;

const legalKeyToRoute = {
  privacy: 'privacy',
  cookie: 'cookie',
  terms: 'terms',
  conduct: 'conduct',
  complaints: 'complaints',
} as const;

const featured = treatments.slice(0, 6);
---

<footer class="relative mt-24 bg-ink text-cream/85">
  <div class="hairline-gold h-px w-full opacity-80"></div>

  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-12">
    <!-- Brand + NAP -->
    <div class="lg:col-span-4">
      <div class="flex items-center gap-3">
        <img src="/images/omnia-logo-mark-96.webp" alt="" width="48" height="48" class="h-12 w-12 object-contain" />
        <span class="flex flex-col leading-none">
          <span class="font-display text-2xl text-cream">Omnia</span>
          <span class="text-[0.62rem] font-bold uppercase tracking-[0.32em] text-gold">Dental</span>
        </span>
      </div>
      <p class="mt-5 max-w-xs text-pretty text-[0.95rem] leading-relaxed text-cream/70">
        {lang === 'nl'
          ? 'Uw tandarts in Hoofddorp. Alle tandheelkundige zorg onder één dak, van controle tot implantaat.'
          : 'Your dentist in Hoofddorp. All dental care under one roof, from check-up to implant.'}
      </p>

      <div class="mt-6 space-y-3 text-[0.92rem]">
        <a href={site.maps.directions} target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 text-cream/80 hover:text-cream">
          <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-gold" />
          <span>{site.address.line1}, {site.address.line2}<br />{site.address.postalCode} {site.address.city}</span>
        </a>
        <a href={site.phone.href} class="flex items-center gap-3 text-cream/80 hover:text-cream">
          <Icon name="phone" size={18} class="shrink-0 text-gold" />
          {site.phone.display}
        </a>
        <a href={`mailto:${site.email}`} class="flex items-center gap-3 text-cream/80 hover:text-cream">
          <Icon name="mail" size={18} class="shrink-0 text-gold" />
          {site.email}
        </a>
      </div>

      <div class="mt-6 flex gap-2.5">
        <a href={site.phone.whatsapp} target="_blank" rel="noopener noreferrer" class="flex h-10 w-10 items-center justify-center rounded-full bg-cream/8 text-cream/80 transition-colors hover:bg-gold hover:text-ink" aria-label="WhatsApp">
          <Icon name="whatsapp" size={18} />
        </a>
        <a href={`mailto:${site.email}`} class="flex h-10 w-10 items-center justify-center rounded-full bg-cream/8 text-cream/80 transition-colors hover:bg-gold hover:text-ink" aria-label="E-mail">
          <Icon name="mail" size={18} />
        </a>
        <a href={site.phone.href} class="flex h-10 w-10 items-center justify-center rounded-full bg-cream/8 text-cream/80 transition-colors hover:bg-gold hover:text-ink" aria-label={tr.common.phone}>
          <Icon name="phone" size={18} />
        </a>
      </div>
    </div>

    <!-- Treatments -->
    <div class="lg:col-span-3">
      <h2 class="text-[0.78rem] font-bold uppercase tracking-[0.16em] text-gold">{tr.footer.treatments}</h2>
      <ul class="mt-4 space-y-2.5 text-[0.92rem]">
        {featured.map((tItem) => (
          <li>
            <a href={treatmentPath(tItem.slug[lang], lang)} class="text-cream/70 hover:text-cream">{tItem.name[lang]}</a>
          </li>
        ))}
        <li>
          <a href={route('treatments', lang)} class="inline-flex items-center gap-1 font-semibold text-gold hover:text-gold/80">
            {tr.cta.allTreatments} <Icon name="arrow" size={14} />
          </a>
        </li>
      </ul>
    </div>

    <!-- Service & legal -->
    <div class="lg:col-span-2">
      <h2 class="text-[0.78rem] font-bold uppercase tracking-[0.16em] text-gold">{tr.footer.service}</h2>
      <ul class="mt-4 space-y-2.5 text-[0.92rem]">
        <li><a href={route('tarieven', lang)} class="text-cream/70 hover:text-cream">{tr.nav.tarieven}</a></li>
        <li><a href={route('about', lang)} class="text-cream/70 hover:text-cream">{tr.nav.about}</a></li>
        <li><a href={route('reviews', lang)} class="text-cream/70 hover:text-cream">{tr.nav.reviews}</a></li>
        <li><a href={route('faq', lang)} class="text-cream/70 hover:text-cream">{tr.nav.faq}</a></li>
        <li><a href={route('contact', lang)} class="text-cream/70 hover:text-cream">{tr.nav.contact}</a></li>
        <li><a href={route('spoed', lang)} class="text-cream/70 hover:text-cream">{tr.nav.spoed}</a></li>
      </ul>
      <h2 class="mt-7 text-[0.78rem] font-bold uppercase tracking-[0.16em] text-gold">{tr.footer.legal}</h2>
      <ul class="mt-4 space-y-2.5 text-[0.92rem]">
        {legalDocs.map((doc) => (
          <li>
            <a href={route(legalKeyToRoute[doc.key], lang)} class="text-cream/70 hover:text-cream">{doc.title[lang]}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Hours -->
    <div class="lg:col-span-3">
      <h2 class="text-[0.78rem] font-bold uppercase tracking-[0.16em] text-gold">{tr.footer.hoursHeading}</h2>
      <table class="mt-4 w-full text-[0.9rem]">
        <tbody>
          {site.hours.map((h) => (
            <tr class="border-b border-cream/8 last:border-0">
              <td class="py-1.5 text-cream/70">{dayLabels[h.day][lang]}</td>
              <td class="py-1.5 text-right tabular-nums text-cream/85">
                {h.open && h.close ? `${h.open} - ${h.close}` : tr.common.closed}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="mt-5 rounded-2xl border border-[#a4533f]/40 bg-[#a4533f]/15 p-4 text-[0.85rem] leading-relaxed text-cream/85">
        <p class="flex items-center gap-2 font-semibold text-[#e8a48f]">
          <Icon name="alert" size={16} /> {tr.common.emergency}
        </p>
        <p class="mt-1.5">{tr.footer.disclaimerEmergency}</p>
        <a href={route('spoed', lang)} class="mt-2 inline-flex items-center gap-1 font-semibold text-gold hover:text-gold/80">
          {lang === 'nl' ? 'Spoedhulp aanvragen' : 'Request emergency care'} <Icon name="arrow" size={14} />
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="container-x flex flex-col items-center justify-between gap-3 py-6 text-[0.82rem] text-cream/55 sm:flex-row">
      <p>
        © {year} {site.name}. {tr.footer.rightsReserved}
        <span class="mx-2 hidden sm:inline">·</span>
        <br class="sm:hidden" />
        {tr.footer.bigLabel}: {site.owner.bigNumber}
      </p>
      <p>
        {tr.footer.builtBy}
        <a href="https://jouwidealewebsite.nl" target="_blank" rel="noopener noreferrer" class="font-semibold text-cream/75 hover:text-gold">Jouw Ideale Website</a>
      </p>
    </div>
  </div>
</footer>
