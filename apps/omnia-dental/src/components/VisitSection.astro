---
import Icon from './Icon.astro';
import Button from './Button.astro';
import OpeningStatus from './OpeningStatus.astro';
import { site, dayLabels } from '../data/site';
import { t, route, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const todayIdx = (new Date().getDay() + 6) % 7; // not used for static; visual only
---

<section class="container-x">
  <div class="grid gap-8 lg:grid-cols-2">
    <!-- Info -->
    <div class="reveal">
      <p class="eyebrow">{lang === 'nl' ? 'Bezoek de praktijk' : 'Visit the practice'}</p>
      <h2 class="mt-3 font-display text-3xl text-ink md:text-[2.5rem]">
        {lang === 'nl' ? 'Welkom in Hoofddorp' : 'Welcome in Hoofddorp'}
      </h2>
      <p class="mt-4 max-w-md text-pretty text-ink-soft">
        {lang === 'nl'
          ? 'Onze praktijk aan de Manenburgdreef is goed bereikbaar met de auto en het openbaar vervoer. Loop gerust binnen of plan vooraf uw afspraak.'
          : 'Our practice on Manenburgdreef is easy to reach by car and public transport. Feel free to drop by or plan your appointment in advance.'}
      </p>

      <div class="mt-7 space-y-4">
        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sage/15 text-sage-ink"><Icon name="pin" size={20} /></span>
          <div>
            <p class="text-sm font-semibold text-ink">{tr.common.address}</p>
            <p class="text-ink-soft">{site.address.line1}, {site.address.line2}<br />{site.address.postalCode} {site.address.city}</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sage/15 text-sage-ink"><Icon name="phone" size={20} /></span>
          <div>
            <p class="text-sm font-semibold text-ink">{tr.common.phone}</p>
            <a href={site.phone.href} class="text-ink-soft link-underline">{site.phone.display}</a>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sage/15 text-sage-ink"><Icon name="mail" size={20} /></span>
          <div>
            <p class="text-sm font-semibold text-ink">{tr.common.email}</p>
            <a href={`mailto:${site.email}`} class="text-ink-soft link-underline">{site.email}</a>
          </div>
        </div>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button href={site.maps.directions} variant="ghost" icon="pin" external>{tr.cta.directions}</Button>
        <Button href={route('contact', lang)} variant="primary" icon="calendar" appointmentTrigger>{tr.cta.intakeShort}</Button>
      </div>
    </div>

    <!-- Hours + map -->
    <div class="reveal" data-delay="100ms">
      <div class="card overflow-hidden">
        <div class="flex items-center justify-between gap-4 border-b border-ink/8 px-6 py-5">
          <div class="flex items-center gap-2.5">
            <Icon name="clock" size={20} class="text-gold-deep" />
            <h3 class="font-display text-xl text-ink">{tr.common.openingHours}</h3>
          </div>
          <OpeningStatus lang={lang} class="rounded-full bg-cream px-3 py-1.5 text-[0.82rem] surface-ring" />
        </div>
        <table class="w-full px-2 text-[0.95rem]">
          <tbody>
            {site.hours.map((h, i) => (
              <tr class={`border-b border-ink/6 last:border-0 ${i === todayIdx ? 'bg-cream/60' : ''}`}>
                <td class="py-3 pl-6 text-ink-soft">{dayLabels[h.day][lang]}</td>
                <td class="py-3 pr-6 text-right tabular-nums font-medium text-ink">
                  {h.open && h.close ? `${h.open} - ${h.close}` : <span class="text-ink-mute">{tr.common.closed}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-5 overflow-hidden rounded-3xl surface-ring shadow-card">
        <iframe
          src={site.maps.embed}
          title={lang === 'nl' ? 'Locatie Omnia Dental Hoofddorp' : 'Omnia Dental Hoofddorp location'}
          width="100%"
          height="260"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
