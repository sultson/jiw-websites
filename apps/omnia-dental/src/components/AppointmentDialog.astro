---
import Icon from './Icon.astro';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const f = tr.form;

const copy = {
  nl: {
    title: 'Afspraak maken',
    intro: 'Laat uw gegevens achter. We bellen u terug om rustig een passend moment te plannen.',
    close: 'Sluiten',
    reason: 'Afspraak of intake',
    message: 'Waarvoor wilt u een afspraak maken?',
    messagePlaceholder: 'Bijvoorbeeld: controle, pijnklacht, kennismaking of een vraag over een behandeling.',
    send: 'Aanvraag versturen',
  },
  en: {
    title: 'Make an appointment',
    intro: 'Leave your details. We will call you back to plan a suitable time.',
    close: 'Close',
    reason: 'Appointment or intake',
    message: 'What would you like to make an appointment for?',
    messagePlaceholder: 'For example: check-up, pain complaint, first visit or a question about a treatment.',
    send: 'Send request',
  },
}[lang];
---

<div id="appointment-dialog" class="fixed inset-0 z-[80] hidden" role="dialog" aria-modal="true" aria-labelledby="appointment-title">
  <button
    id="appointment-backdrop"
    class="absolute inset-0 bg-ink/45 opacity-0 transition-opacity duration-300"
    type="button"
    aria-label={copy.close}
  ></button>

  <div
    id="appointment-panel"
    class="appointment-panel absolute inset-x-0 bottom-0 max-h-[92svh] overflow-y-auto rounded-t-[1.4rem] bg-cream p-5 shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] md:left-1/2 md:top-1/2 md:bottom-auto md:max-h-[86vh] md:w-[min(43rem,calc(100vw-3rem))] md:rounded-section md:p-7"
  >
    <div class="flex items-start justify-between gap-5">
      <div>
        <p class="eyebrow">{tr.common.newPatients}</p>
        <h2 id="appointment-title" class="mt-2 font-display text-2xl text-ink md:text-3xl">{copy.title}</h2>
        <p class="mt-2 max-w-xl text-pretty text-[0.95rem] leading-relaxed text-ink-soft">{copy.intro}</p>
      </div>
      <button id="appointment-close" type="button" class="btn btn-ghost !px-3 !py-3 shrink-0" aria-label={copy.close}>
        <Icon name="x" size={19} />
      </button>
    </div>

    <div id="appointment-success" class="mt-6 hidden rounded-2xl bg-white/75 p-6 text-center surface-ring">
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-sage/20 text-sage-deep">
        <Icon name="checkCircle" size={30} />
      </span>
      <h3 class="mt-4 font-display text-xl text-ink">{f.successTitle}</h3>
      <p class="mt-2 text-pretty text-sm text-ink-soft">{f.successBody}</p>
    </div>

    <form id="appointment-form" class="mt-6" data-form-path="/api/forms/contact" novalidate>
      <input type="hidden" name="reason" value={copy.reason} />
      <input type="hidden" name="cf-turnstile-response" value="dev" />
      <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-[0.85rem] font-semibold text-ink">{f.firstName} *</span>
          <input name="firstName" type="text" required autocomplete="given-name" class="form-input" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-[0.85rem] font-semibold text-ink">{f.lastName} <span class="font-normal text-ink-mute">({f.optional})</span></span>
          <input name="lastName" type="text" autocomplete="family-name" class="form-input" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-[0.85rem] font-semibold text-ink">{f.phone} *</span>
          <input name="phone" type="tel" required autocomplete="tel" class="form-input" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-[0.85rem] font-semibold text-ink">{f.email} <span class="font-normal text-ink-mute">({f.optional})</span></span>
          <input name="email" type="email" autocomplete="email" class="form-input" />
        </label>
      </div>

      <label class="mt-4 block">
        <span class="mb-1.5 block text-[0.85rem] font-semibold text-ink">{copy.message} *</span>
        <textarea name="message" rows="4" required class="form-input resize-y" placeholder={copy.messagePlaceholder}></textarea>
      </label>

      <fieldset class="mt-4">
        <legend class="mb-2 text-[0.85rem] font-semibold text-ink">{f.preferredContact}</legend>
        <div class="flex flex-wrap gap-2">
          {['Telefoon', 'E-mail', 'WhatsApp'].map((pref, i) => (
            <label class="cursor-pointer">
              <input type="radio" name="preferredContact" value={lang === 'en' && pref === 'Telefoon' ? 'Phone' : pref} class="peer sr-only" checked={i === 0} />
              <span class="inline-flex rounded-full bg-white/70 px-4 py-2 text-[0.88rem] font-medium text-ink-soft surface-ring transition-colors peer-checked:bg-ink peer-checked:text-cream">{lang === 'en' && pref === 'Telefoon' ? 'Phone' : pref}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <p id="appointment-error" class="mt-4 hidden rounded-xl bg-[#a4533f]/10 px-4 py-3 text-[0.9rem] text-[#8f4030]"></p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <button type="submit" class="btn btn-primary px-7 py-4">
          <span class="appointment-label">{copy.send}</span>
          <Icon name="arrow" size={18} />
        </button>
        <p class="text-[0.8rem] leading-snug text-ink-mute sm:max-w-[18rem] sm:text-right">{f.consent}</p>
      </div>
    </form>
  </div>
</div>

<style>
  .form-input {
    width: 100%;
    border-radius: 0.9rem;
    background: #fffdf8;
    padding: 0.8rem 1rem;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px rgba(46, 46, 46, 0.14);
    transition: box-shadow 0.25s ease;
    font-size: 0.95rem;
  }
  .form-input::placeholder {
    color: var(--color-ink-mute);
  }
  .form-input:focus {
    outline: none;
    box-shadow:
      inset 0 0 0 1.5px var(--color-sage-deep),
      0 0 0 4px rgba(126, 152, 143, 0.16);
  }
  .form-input:user-invalid {
    box-shadow: inset 0 0 0 1.5px #c47d6f;
  }
  .appointment-panel {
    transform: translateY(100%);
  }
  #appointment-dialog.appointment-open .appointment-panel {
    transform: translateY(0);
  }
  @media (min-width: 768px) {
    .appointment-panel {
      transform: translate(-50%, 2rem);
    }
    #appointment-dialog.appointment-open .appointment-panel {
      transform: translate(-50%, -50%);
    }
  }
</style>

<script>
  (() => {
    const dialog = document.getElementById('appointment-dialog');
    const panel = document.getElementById('appointment-panel');
    const backdrop = document.getElementById('appointment-backdrop');
    const closeBtn = document.getElementById('appointment-close');
    const form = document.getElementById('appointment-form') as HTMLFormElement | null;
    const success = document.getElementById('appointment-success');
    const errorBox = document.getElementById('appointment-error');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = form?.querySelector<HTMLElement>('.appointment-label');
    const originalLabel = label?.textContent ?? '';
    let lastFocus: Element | null = null;

    if (!dialog || !panel || !backdrop) return;

    const open = (trigger?: Element | null) => {
      lastFocus = trigger ?? document.activeElement;
      dialog.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      dialog.classList.add('appointment-open');
      backdrop.classList.remove('opacity-0');
      closeBtn?.focus();
    };

    const close = () => {
      dialog.classList.remove('appointment-open');
      backdrop.classList.add('opacity-0');
      document.body.style.overflow = '';
      setTimeout(() => dialog.classList.add('hidden'), 300);
      if (lastFocus instanceof HTMLElement) lastFocus.focus();
    };

    document.querySelectorAll('[data-appointment-trigger="true"]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open(trigger);
      });
    });

    closeBtn?.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !dialog.classList.contains('hidden')) close();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox?.classList.add('hidden');
      if ((form.elements.namedItem('company') as HTMLInputElement)?.value) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitBtn?.setAttribute('disabled', 'true');
      if (label) label.textContent = document.documentElement.lang === 'en' ? 'Sending...' : 'Versturen...';

      try {
        const res = await fetch(form.dataset.formPath ?? '/api/forms/contact', { method: 'POST', body: new FormData(form) });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };
        if (!res.ok || !data.ok) throw new Error(data.message || 'error');
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } catch (err) {
        if (errorBox) {
          errorBox.textContent =
            (err as Error).message && (err as Error).message !== 'error'
              ? (err as Error).message
              : document.documentElement.lang === 'en'
                ? 'Your request could not be sent. Please try again or call us directly.'
                : 'Uw aanvraag kon niet worden verstuurd. Probeer het opnieuw of bel ons direct.';
          errorBox.classList.remove('hidden');
        }
        submitBtn?.removeAttribute('disabled');
        if (label) label.textContent = originalLabel;
      }
    });
  })();
</script>
