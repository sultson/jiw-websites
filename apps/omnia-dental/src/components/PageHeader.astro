---
import Icon from './Icon.astro';
import { route, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  subtitle?: string;
  /** Breadcrumb trail: [{label, href}] excluding Home (added automatically) and current. */
  crumbs?: { label: string; href: string }[];
  current?: string;
  align?: 'left' | 'center';
}
const { lang, eyebrow, title, subtitle, crumbs = [], current, align = 'left' } = Astro.props;
const alignCls = align === 'center' ? 'mx-auto text-center items-center' : '';
---

<section class="relative overflow-hidden border-b border-ink/8">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-24 top-[-30%] h-80 w-80 rounded-full bg-sage/14 blur-[100px]"></div>
    <div class="absolute right-[-8%] top-[10%] h-72 w-72 rounded-full bg-gold/12 blur-[100px]"></div>
  </div>
  <div class="container-x py-12 md:py-16">
    {(current || crumbs.length > 0) && (
      <nav class={`mb-6 text-[0.83rem] ${align === 'center' ? 'flex justify-center' : ''}`} aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 text-ink-mute">
          <li><a href={route('home', lang)} class="hover:text-ink">Home</a></li>
          {crumbs.map((c) => (
            <>
              <li><Icon name="chevronRight" size={13} /></li>
              <li><a href={c.href} class="hover:text-ink">{c.label}</a></li>
            </>
          ))}
          {current && (
            <>
              <li><Icon name="chevronRight" size={13} /></li>
              <li class="font-medium text-ink-soft" aria-current="page">{current}</li>
            </>
          )}
        </ol>
      </nav>
    )}
    <div class={`flex max-w-2xl flex-col ${alignCls}`}>
      <p class="eyebrow reveal">{eyebrow}</p>
      <h1 class="mt-3 font-display text-[2.4rem] leading-[1.05] text-ink md:text-5xl reveal">{title}</h1>
      {subtitle && <p class="mt-5 text-pretty text-lg leading-relaxed text-ink-soft reveal">{subtitle}</p>}
    </div>
  </div>
</section>
