---
import Icon from './Icon.astro';
import { type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const themes = [
  {
    key: 'warm',
    swatch: ['#fcf8ee', '#a2b9b2', '#e9c583', '#2e2e2e'],
    name: { nl: 'Warm & persoonlijk', en: 'Warm & personal' },
    desc: {
      nl: 'Zachte cremetinten, een heldere Inter-letter en ronde, luchtige vormen.',
      en: 'Soft cream tones, clean Inter type and round, airy shapes.',
    },
    feel: { nl: 'Uitnodigend · boetiek', en: 'Inviting · boutique' },
  },
  {
    key: 'professional',
    swatch: ['#f3f6f8', '#4d7c88', '#2f8aa0', '#16242c'],
    name: { nl: 'Klinisch & strak', en: 'Clinical & crisp' },
    desc: {
      nl: 'Koele blauwgroene tinten, strakke hoeken en een compacte, zakelijke opzet.',
      en: 'Cool teal-blue tones, sharp corners and a compact, businesslike layout.',
    },
    feel: { nl: 'Modern medisch · vertrouwen', en: 'Modern medical · trust' },
  },
  {
    key: 'mono',
    swatch: ['#ffffff', '#0a0a0a', '#8f8f8c', '#000000'],
    name: { nl: 'Strak zwart-wit', en: 'Bold black & white' },
    desc: {
      nl: 'Helder zwart op wit, een stevige grotesk en strakke, hoekige vlakken.',
      en: 'Stark black on white, a heavy grotesk and sharp, angular shapes.',
    },
    feel: { nl: 'Editorial · high-contrast', en: 'Editorial · high-contrast' },
  },
];

const ui = {
  nl: {
    btn: 'Stijl',
    title: 'Kies een stijlrichting',
    subtitle: 'Conceptweergave. Bekijk drie complete richtingen en kies uw favoriet.',
    badge: 'Concept',
    active: 'Actief',
    note: 'Alleen ter beoordeling zichtbaar, niet voor bezoekers.',
  },
  en: {
    btn: 'Style',
    title: 'Choose a style direction',
    subtitle: 'Concept preview. Explore three complete directions and pick your favourite.',
    badge: 'Concept',
    active: 'Active',
    note: 'Visible for review only, not to visitors.',
  },
}[lang];
---

<!-- Desktop-only style-direction switcher (shown at >=xl, where the mobile
     floating CTA is hidden, so they never overlap). -->
<div id="theme-switcher" class="fixed bottom-4 left-4 z-[55] xl:bottom-6 xl:left-auto xl:right-6">
  <!-- Panel -->
  <div
    id="theme-panel"
    class="pointer-events-none absolute bottom-[calc(100%+0.75rem)] left-0 w-[min(22rem,calc(100vw-2rem))] origin-bottom-left translate-y-3 scale-95 opacity-0 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] xl:left-auto xl:right-0 xl:origin-bottom-right"
    role="dialog"
    aria-label={ui.title}
  >
    <div class="overflow-hidden rounded-3xl border border-ink/10 bg-[#ffffff] shadow-[0_30px_70px_-30px_rgba(20,20,20,0.5)]">
      <div class="flex items-start justify-between gap-3 border-b border-ink/8 bg-gradient-to-br from-cream to-cream-deep px-5 py-4">
        <div>
          <p class="flex items-center gap-2">
            <span class="rounded-full bg-ink px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-wider text-cream">{ui.badge}</span>
          </p>
          <h2 class="mt-2 font-display text-xl leading-tight text-ink">{ui.title}</h2>
          <p class="mt-1 text-[0.82rem] leading-snug text-ink-mute">{ui.subtitle}</p>
        </div>
        <button id="theme-close" class="shrink-0 rounded-full p-1.5 text-ink-mute transition-colors hover:bg-ink/8 hover:text-ink" aria-label="Sluiten">
          <Icon name="x" size={18} />
        </button>
      </div>

      <div class="space-y-2 p-3">
        {themes.map((th) => (
          <button
            type="button"
            class="theme-option group/opt flex w-full items-center gap-3.5 rounded-2xl border border-transparent p-3 text-left transition-all hover:border-ink/10 hover:bg-cream/70 data-[active=true]:border-sage-deep/40 data-[active=true]:bg-sage/8"
            data-theme-key={th.key}
          >
            <span class="relative flex h-12 w-12 shrink-0 overflow-hidden rounded-xl shadow-inner ring-1 ring-ink/10">
              {th.swatch.map((c) => <span class="flex-1" style={`background:${c}`}></span>)}
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-center gap-2">
                <span class="font-display text-[1.02rem] text-ink">{th.name[lang]}</span>
                <span class="check hidden items-center gap-1 rounded-full bg-sage-deep px-1.5 py-0.5 text-[0.6rem] font-bold uppercase tracking-wide text-white">
                  <Icon name="check" size={11} /> {ui.active}
                </span>
              </span>
              <span class="mt-0.5 block text-[0.8rem] leading-snug text-ink-soft">{th.desc[lang]}</span>
              <span class="mt-1 block text-[0.72rem] font-semibold uppercase tracking-wide text-gold-deep">{th.feel[lang]}</span>
            </span>
          </button>
        ))}
      </div>
      <p class="border-t border-ink/8 px-5 py-2.5 text-[0.72rem] text-ink-mute">{ui.note}</p>
    </div>
  </div>

  <!-- Trigger — deliberately neutral/system-styled so it reads as an external
       review tool, not part of the site's own design. -->
  <button
    id="theme-toggle"
    class="flex items-center gap-1.5 rounded-md border border-black/15 bg-white/85 px-2.5 py-1.5 text-[0.72rem] font-medium text-neutral-500 shadow-sm backdrop-blur-sm transition-colors hover:bg-white hover:text-neutral-800"
    style="font-family: ui-sans-serif, system-ui, -apple-system, sans-serif; letter-spacing: 0;"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <Icon name="palette" size={14} />
    <span>{ui.btn}</span>
  </button>
</div>

<script>
  const KEY = 'omnia-theme';
  const root = document.documentElement;
  const wrap = document.getElementById('theme-switcher');
  const panel = document.getElementById('theme-panel');
  const toggle = document.getElementById('theme-toggle');
  const closeBtn = document.getElementById('theme-close');
  const options = Array.from(document.querySelectorAll<HTMLElement>('.theme-option'));

  const current = () => root.dataset.theme || 'warm';

  function markActive() {
    const cur = current();
    options.forEach((opt) => {
      const active = opt.dataset.themeKey === cur;
      opt.dataset.active = String(active);
      const chip = opt.querySelector<HTMLElement>('.check');
      if (chip) chip.classList.toggle('hidden', !active);
      if (chip) chip.classList.toggle('inline-flex', active);
    });
  }

  function applyTheme(key: string) {
    if (key === 'warm') root.removeAttribute('data-theme');
    else root.dataset.theme = key;
    try {
      localStorage.setItem(KEY, key);
    } catch {}
    markActive();
  }

  let open = false;
  function setOpen(next: boolean) {
    open = next;
    toggle?.setAttribute('aria-expanded', String(next));
    if (!panel) return;
    if (next) {
      panel.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-3', 'scale-95');
    } else {
      panel.classList.add('pointer-events-none', 'opacity-0', 'translate-y-3', 'scale-95');
    }
  }

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(!open);
  });
  closeBtn?.addEventListener('click', () => setOpen(false));
  options.forEach((opt) =>
    opt.addEventListener('click', () => {
      applyTheme(opt.dataset.themeKey || 'warm');
    }),
  );
  document.addEventListener('click', (e) => {
    if (open && wrap && !wrap.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
  });

  markActive();
</script>
