---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { PAGES, type Lang, type LanderContent } from '../sites';

interface Props {
  lang: Lang;
  c: LanderContent;
  page: keyof typeof PAGES;
  chrome: boolean;
}
const { lang, c, page, chrome } = Astro.props;
const other: Lang = lang === 'nl' ? 'en' : 'nl';
const home = PAGES.home[lang];
---

<!-- No service menu: the header exists to keep the visitor in the funnel (brief §22). -->
<header class="sticky top-0 z-40 border-b border-line bg-cream/95 backdrop-blur-sm">
  <div class="container-site flex h-16 items-center justify-between gap-6 md:h-[4.6rem]">
    <a href={home} aria-label="Immigration Services NL"><Wordmark /></a>

    <div class="flex items-center gap-2 md:gap-6">
      {chrome && (
        <nav class="hidden items-center gap-7 lg:flex">
          {c.nav.links.map((l) => (
            <a
              href={l.href}
              class="relative py-1 text-[0.92rem] font-medium text-ink-soft transition-colors after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:origin-left after:scale-x-0 after:bg-flame after:transition-transform hover:text-deep hover:after:scale-x-100"
            >
              {l.label}
            </a>
          ))}
        </nav>
      )}

      <!-- Always reachable: on these pages the foreign partner is often the one
           searching, on a phone, and cannot read the Dutch version. -->
      <a
        href={PAGES[page][other]}
        hreflang={other}
        aria-label={c.nav.langSwitch}
        class="inline-flex items-center gap-1.5 rounded-lg border border-line px-2.5 py-1.5 text-[0.78rem] font-semibold text-ink-soft transition-colors hover:border-deep hover:text-deep sm:px-3"
      >
        <Icon name="globe" size={14} />
        <span class="sm:hidden">{other.toUpperCase()}</span>
        <span class="hidden sm:inline">{c.nav.langSwitch}</span>
      </a>

      {chrome && (
        <!-- On a phone the sticky bottom bar carries the CTA (brief §23), so the
             header keeps the wordmark and the language switch on one line. -->
        <a
          href={c.nav.cta.href}
          class="btn btn-flame hidden px-4 py-2.5 text-[0.86rem] sm:inline-flex sm:px-5"
          data-track="cta_click"
          data-situation="Header"
        >
          {c.nav.cta.label}
        </a>
      )}
    </div>
  </div>
</header>
