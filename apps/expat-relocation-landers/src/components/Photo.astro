---
import { asset } from '../lib/assets';
import { intrinsicSize } from '../lib/imageSize';

/**
 * One generated photo plus its 640w variant. Every image in public/images ships
 * as `name.jpg` and `name-640.jpg` (scripts/optimize-images.mjs), so the srcset
 * is derived from the source path rather than repeated at every call site, and
 * both variants get the same cache-busting version.
 *
 * width/height are read from the file itself at build time. They used to be
 * hard-coded at 1264x848, which was true until the hero became a 4:5 portrait
 * and the bands became 21:9 — a wrong ratio here is a layout shift on a phone,
 * because the width/height attributes win over any CSS aspect-ratio.
 * Where a caller crops with object-cover plus a height class, that class wins,
 * which is the point: the attributes only have to be right for the uncropped
 * case.
 */
interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
}
const {
  src,
  alt,
  sizes = '(min-width: 1024px) 40rem, 100vw',
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;
const wide = asset(src);
const narrow = asset(src.replace(/\.jpg$/, '-640.jpg'));
const { width, height } = intrinsicSize(src);
---

<img
  src={wide}
  srcset={`${narrow} 640w, ${wide} 1264w`}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
/>
