---
import type { LanderContent } from '../sites';

interface Props {
  c: LanderContent;
}
const { c } = Astro.props;
---

<section class="section bg-mist">
  <div class="container-site max-w-3xl">
    <h1 class="display-2">{c.privacy.heading}</h1>
    <p class="mt-4 text-[0.88rem] text-ink-soft">{c.privacy.updated}</p>

    <div class="mt-10 border-t border-line">
      {c.privacy.sections.map((s) => (
        <section class="border-b border-line py-8">
          <h2 class="text-[1.22rem]">{s.heading}</h2>
          <div class="prose-lander mt-3 text-[0.98rem] leading-relaxed text-ink-soft">
            {s.body.map((p) => <p>{p}</p>)}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
