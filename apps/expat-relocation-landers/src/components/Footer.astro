---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { brand, whatsappUrl } from '../lib/brand';
import { PAGES, type Lang, type LanderContent } from '../sites';

interface Props {
  lang: Lang;
  c: LanderContent;
}
const { lang, c } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-deeper text-white/70">
  <div class="container-site py-14 md:py-18">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr] md:gap-12">
      <div>
        <Wordmark tone="light" />
        <p class="mt-5 max-w-sm text-[0.94rem] leading-relaxed">{c.footer.about}</p>
      </div>

      <div>
        <h2 class="border-t border-white/25 pt-3 text-[0.72rem] font-bold uppercase tracking-[0.16em] text-white">
          {c.footer.contactHeading}
        </h2>
        <ul class="mt-5 grid gap-3 text-[0.94rem]">
          <li>
            <a href={`tel:${brand.phone.e164}`} class="inline-flex items-center gap-2.5 transition-colors hover:text-white">
              <Icon name="phone" size={15} />{brand.phone.display}
            </a>
          </li>
          <li>
            <a
              href={whatsappUrl(c.whatsapp.text)}
              target="_blank"
              rel="noopener"
              data-track="whatsapp_click"
              class="inline-flex items-center gap-2.5 transition-colors hover:text-white"
            >
              <Icon name="whatsapp" size={15} />{brand.whatsapp.display}
            </a>
          </li>
          <li>
            <a href={`mailto:${brand.email}`} class="inline-flex items-center gap-2.5 transition-colors hover:text-white">
              <Icon name="mail" size={15} />{brand.email}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="border-t border-white/25 pt-3 text-[0.72rem] font-bold uppercase tracking-[0.16em] text-white">
          {c.footer.legalHeading}
        </h2>
        <address class="mt-5 text-[0.94rem] not-italic leading-relaxed">
          {brand.legalName}<br />
          {brand.address.line1}<br />
          {brand.address.postcode} {brand.address.city}<br />
          KvK {brand.kvk}
        </address>
        <a
          href={PAGES.privacy[lang]}
          class="mt-4 inline-block text-[0.94rem] underline underline-offset-4 transition-colors hover:text-white"
        >
          {c.footer.privacy}
        </a>
      </div>
    </div>

    <!-- Independence statement, required on every page (brief §26). -->
    <p class="mt-14 border-t border-white/14 pt-8 text-[0.79rem] leading-relaxed text-white/50">
      {c.disclaimer}
    </p>
    <p class="mt-6 text-[0.79rem] text-white/40">
      © {year} Immigration Services NL. {c.footer.rights}
    </p>
  </div>
</footer>
