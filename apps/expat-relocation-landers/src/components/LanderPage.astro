---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import LeadForm from './LeadForm.astro';
import { brand, whatsappUrl } from '../lib/brand';
import type { Lang, LanderContent } from '../sites';

interface Props {
  lang: Lang;
  c: LanderContent;
}
const { lang, c } = Astro.props;
// Destructured so TypeScript keeps the narrowing inside the .map() callbacks
// below; the optional sections are what make one template serve eight briefs.
const { explain, packages, journey, routing, distinction, steps, band, aside } = c;

// The tab number in front of each section label. Sections are optional per
// lander, so the count is built from what this page actually renders rather
// than hard-coded, and the numbering never skips.
const order = [
  explain && 'explain',
  packages && 'packages',
  journey && 'journey',
  routing && 'routing',
  distinction && 'distinction',
  'help',
  steps && 'steps',
  'reviews',
  'faq',
  'final',
].filter(Boolean) as string[];
const num = (key: string) => String(order.indexOf(key) + 1).padStart(2, '0');

// The badge strip is what keeps two cards of different heights aligned at the
// top, so it is drawn on every card as soon as one card carries a label.
const cardBadges = packages?.cards.some((card) => card.badge) ?? false;
---

<!--
  1. HERO + SHORT INTRODUCTION + LEAD FORM (brief §8).

  Warm paper, one very large headline, and the lead form built as a letterhead
  beside it. The photograph is not a rounded card floating in the layout: it
  runs the full width of the viewport directly underneath, so the first scroll
  hands the visitor a full-bleed picture of the thing they are trying to reach.
-->
<section class="bg-cream">
  <div class="container-site grid gap-10 py-10 lg:grid-cols-[1.06fr_0.94fr] lg:gap-16 lg:py-16">
    <div class="lg:pr-6">
      {c.hero.route ? (
        <p
          class="flex flex-col gap-1.5 text-[0.76rem] font-bold uppercase tracking-[0.15em] text-ink-soft sm:flex-row sm:items-center sm:gap-3.5"
        >
          <span class="flex items-center gap-2.5">
            <span class="h-2 w-2 shrink-0 rounded-full bg-line-strong" aria-hidden="true"></span>
            {c.hero.route.from}
          </span>
          <span class="ml-[0.19rem] h-3.5 w-[2px] bg-line-strong sm:ml-0 sm:h-[2px] sm:w-8" aria-hidden="true"></span>
          <span class="flex items-center gap-2.5 text-deep">
            <span class="h-2 w-2 shrink-0 rounded-full bg-flame" aria-hidden="true"></span>
            {c.hero.route.to}
          </span>
        </p>
      ) : (
        <p class="tab">{c.hero.eyebrow}</p>
      )}

      <h1 class="display-1 mt-6" set:html={c.hero.h1} />

      <div class="prose-lander lede mt-6 max-w-[35rem] text-ink-soft">
        {c.hero.intro.map((p) => <p>{p}</p>)}
      </div>

      <ul class="mt-8 grid max-w-[36rem] gap-x-8 gap-y-3 sm:grid-cols-2">
        {c.hero.benefits.map((b) => (
          <li class="flex items-start gap-2.5 text-[0.96rem] leading-snug">
            <span class="tick mt-0.5"><Icon name="check" size={12} /></span>
            {b}
          </li>
        ))}
      </ul>

      {c.hero.offer && (
        <div class="mt-9 max-w-[31rem]">
          <div class="ticket flex items-center gap-5 border-l-[6px] border-l-flame">
            <div>
              <p class="text-[0.72rem] font-bold uppercase tracking-[0.14em] text-ink-soft">{c.hero.offer.name}</p>
              <p class="figure-num mt-1.5 text-[1.6rem] leading-none text-deep">{c.hero.offer.price}</p>
            </div>
          </div>
          <p class="mt-3 text-[0.77rem] leading-relaxed text-ink-soft">{c.hero.offer.note}</p>
        </div>
      )}

      <div class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
        <a href={c.hero.cta.href} class="btn btn-flame" data-track="cta_click" data-situation={c.hero.cta.situation}>
          {c.hero.cta.label}
          <Icon name="arrow" size={17} />
        </a>
        <a
          href={`tel:${brand.phone.e164}`}
          class="inline-flex items-center gap-2.5 text-[0.98rem] font-semibold text-deep underline decoration-flame decoration-2 underline-offset-[6px] hover:text-flame-ink"
        >
          <Icon name="phone" size={16} />{brand.phone.display}
        </a>
      </div>
      <p class="mt-4 text-[0.87rem] leading-snug text-ink-soft">{c.hero.note}</p>
    </div>

    <div id="aanvraag" class="scroll-mt-24 lg:sticky lg:top-24 lg:self-start">
      <LeadForm lang={lang} c={c} id="lead-hero" source="Hero" fields="short" />
    </div>
  </div>
</section>

<!-- The hero photograph, full width. -->
<Photo
  src={c.hero.photo.src}
  alt={c.hero.photo.alt}
  sizes="100vw"
  loading="eager"
  fetchpriority="high"
  class="h-[15rem] w-full object-cover object-[50%_30%] sm:h-[21rem] lg:h-[28rem]"
/>

<!-- 2. TRUST BAR (brief §8 section 2). Substantiated claims only. -->
<section class="bg-deep text-white">
  <div class="container-site grid md:grid-cols-4">
    {c.stats.map((s) => (
      <div class="border-t border-white/14 py-6 first:border-t-0 md:border-l md:border-t-0 md:py-10 md:pl-8 md:first:border-l-0 md:first:pl-0">
        <p class="figure-num text-[1.5rem] leading-none text-flame-light md:text-[1.7rem]">{s.value}</p>
        <p class="mt-2.5 text-[0.9rem] leading-snug text-white/72">{s.label}</p>
      </div>
    ))}
  </div>
</section>

{explain && (
  <!-- 3. RECOGNITION + SHORT INFORMATION (brief §8 section 3).
       A wall of situations in the visitor's own words, laid out as a hairline
       grid rather than a checklist, so the section reads "this is us". -->
  <section class="section bg-sand" id={routing ? 'uitleg' : 'situatie'}>
    <div class="container-site grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="tab"><span class="tab-num">{num('explain')}</span>{explain.eyebrow}</p>
        <h2 class="display-2 mt-6">{explain.heading}</h2>
        <div class="prose-lander mt-6 text-[1.02rem] leading-relaxed text-ink-soft">
          {explain.body.map((p) => <p>{p}</p>)}
        </div>
        <a
          href={explain.cta.href}
          class="btn btn-ink mt-8"
          data-track="cta_click"
          data-situation={explain.cta.situation}
        >
          {explain.cta.label}
          <Icon name="arrow" size={16} />
        </a>
      </div>

      <div>
        <ul class="grid gap-px overflow-hidden rounded-2xl border border-line-strong bg-line-strong sm:grid-cols-2">
          {explain.points.map((p) =>
            explain.pointsStyle === 'quotes' ? (
              <li class="bg-cream px-6 py-6">
                <span class="block text-flame"><Icon name="quote" size={20} /></span>
                <p class="mt-3 font-display text-[1.04rem] font-medium leading-snug text-deep">{p}</p>
              </li>
            ) : (
              <li class="flex items-start gap-3 bg-cream px-6 py-6 text-[0.98rem] leading-snug">
                <span class="tick-quiet mt-0.5"><Icon name="check" size={12} /></span>
                {p}
              </li>
            ),
          )}
        </ul>

        <div class="mt-4">
          <Photo
            src={explain.photo.src}
            alt={explain.photo.alt}
            sizes="(min-width: 1024px) 44rem, 100vw"
            class="h-[15rem] w-full rounded-2xl object-cover sm:h-[20rem]"
          />
          <div class="relative mx-5 -mt-12 rounded-2xl bg-deep p-6 text-[0.96rem] leading-relaxed text-white sm:mx-9 sm:max-w-lg md:p-7">
            {explain.photoNote}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{packages && (
  <!-- 4. CHOOSE THE RIGHT LEVEL OF ASSISTANCE. Two clearly defined services,
       one lead form behind both (brief §9: never eight competing boxes). The
       primary goal is the only dark object on a warm page, so the eye has
       nowhere else to go. -->
  <section class="section bg-cream" id="begeleiding">
    <div class="container-site">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab"><span class="tab-num">{num('packages')}</span>{packages.eyebrow}</p>
          <h2 class="display-2 mt-6">{packages.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{packages.intro}</p>
      </div>

      <div class="mt-14 grid items-start gap-6 lg:grid-cols-2 lg:gap-8">
        {packages.cards.map((card) => (
          <article
            class={`flex h-full flex-col overflow-hidden rounded-2xl ${
              card.featured ? 'bg-deep text-white lg:-mt-10' : 'border border-line bg-paper'
            }`}
          >
            {cardBadges && (
              <p
                class={`px-7 py-3 text-[0.71rem] font-bold uppercase tracking-[0.14em] md:px-9 ${
                  card.featured ? 'bg-flame text-white' : 'border-b border-line text-ink-soft'
                }`}
              >
                {card.badge ?? '\u00A0'}
              </p>
            )}

            <div class="flex flex-1 flex-col p-7 md:p-9">
              <h3 class={`text-[1.4rem] md:text-[1.55rem] ${card.featured ? 'text-white' : ''}`}>{card.title}</h3>
              <p
                class={`figure-num mt-4 text-[2.3rem] leading-none md:text-[2.6rem] ${
                  card.featured ? 'text-flame-light' : 'text-deep'
                }`}
              >
                {card.price}
              </p>
              <p class={`mt-4 text-[0.97rem] leading-relaxed ${card.featured ? 'text-white/72' : 'text-ink-soft'}`}>
                {card.body}
              </p>

              {card.includesHeading && (
                <p
                  class={`mt-8 border-t pt-4 text-[0.71rem] font-bold uppercase tracking-[0.15em] ${
                    card.featured ? 'border-white/20 text-white/60' : 'border-line text-ink-soft'
                  }`}
                >
                  {card.includesHeading}
                </p>
              )}
              <ul class="mt-5 flex-1 grid gap-2.5">
                {card.includes.map((i) => (
                  <li
                    class={`flex items-start gap-3 text-[0.95rem] leading-relaxed ${
                      card.featured ? 'text-white/88' : ''
                    }`}
                  >
                    <span class={card.featured ? 'mt-1 text-flame-light' : 'mt-1 text-flame-ink'}>
                      <Icon name="check" size={14} />
                    </span>
                    {i}
                  </li>
                ))}
              </ul>

              <a
                href={card.cta.href}
                class={`btn mt-9 w-full ${card.featured ? 'btn-flame' : 'btn-outline'}`}
                data-track="cta_click"
                data-situation={card.cta.situation}
              >
                {card.cta.label}
                {card.featured && <Icon name="arrow" size={16} />}
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-10 max-w-3xl text-[0.82rem] leading-relaxed text-ink-soft">{packages.note}</p>
    </div>
  </section>
)}

{journey && (
  <!-- 5. ONE COORDINATED TRAJECTORY. The route: one line, one stop per step. -->
  <section class="section bg-sand" id="traject">
    <div class="container-site">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab"><span class="tab-num">{num('journey')}</span>{journey.eyebrow}</p>
          <h2 class="display-2 mt-6">{journey.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{journey.intro}</p>
      </div>

      <ol class="route mt-16" style="--route-ring: #f2e5d2">
        {journey.items.map((s, i) => (
          <li class="route-stop">
            <span class="route-dot"></span>
            {i < journey.items.length - 1 && <span class="route-line"></span>}
            <span class="figure-num block text-[0.8rem] tracking-[0.12em] text-flame-ink">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-[1.14rem]">{s.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-soft">{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="mt-16 flex flex-col gap-7 rounded-2xl bg-deep p-8 text-white md:flex-row md:items-center md:justify-between md:gap-12 md:p-10">
        <p class="max-w-2xl font-display text-[1.25rem] font-semibold leading-snug md:text-[1.5rem]">{journey.outcome}</p>
        <a
          href={journey.cta.href}
          class="btn btn-flame shrink-0"
          data-track="cta_click"
          data-situation={journey.cta.situation}
        >
          {journey.cta.label}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>
)}

{routing && (
  <!-- WHICH SITUATION APPLIES TO YOU -->
  <section class="section bg-cream" id="situatie">
    <div class="container-site">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab"><span class="tab-num">{num('routing')}</span>{routing.eyebrow}</p>
          <h2 class="display-2 mt-6">{routing.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{routing.intro}</p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {routing.cards.map((card) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-paper">
            <Photo
              src={card.photo.src}
              alt={card.photo.alt}
              sizes="(min-width: 1024px) 24rem, 100vw"
              class="h-44 w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-7">
              <h3 class="text-[1.2rem] leading-snug">{card.title}</h3>
              <p class="mt-3.5 flex-1 text-[0.95rem] leading-relaxed text-ink-soft">{card.body}</p>
              {card.price && (
                <p class="mt-6 border-l-[3px] border-flame bg-sand py-3 pl-4 text-[0.9rem] font-semibold text-deep">
                  {card.price}
                </p>
              )}
              <a
                href={card.cta.href}
                class="btn btn-outline mt-6 w-full text-[0.92rem]"
                data-track="cta_click"
                data-situation={card.cta.situation}
              >
                {card.cta.label}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{distinction && (
  <!-- BEFORE OR AFTER ARRIVAL -->
  <section class="section bg-sand">
    <div class="container-site">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab"><span class="tab-num">{num('distinction')}</span>{distinction.eyebrow}</p>
          <h2 class="display-2 mt-6">{distinction.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{distinction.intro}</p>
      </div>

      <div class="mt-14 grid gap-7 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
        <article class="overflow-hidden rounded-2xl bg-deep text-white">
          <div class="relative">
            <Photo
              src={distinction.abroad.photo.src}
              alt={distinction.abroad.photo.alt}
              class="h-56 w-full object-cover md:h-64"
            />
            <span class="absolute left-0 top-6 bg-flame px-4 py-2 text-[0.71rem] font-bold uppercase tracking-[0.14em] text-white">
              {distinction.abroad.badge}
            </span>
          </div>
          <div class="p-7 md:p-9">
            <h3 class="text-[1.4rem] text-white">{distinction.abroad.title}</h3>
            <p class="mt-3.5 text-[0.97rem] leading-relaxed text-white/72">{distinction.abroad.body}</p>

            <div class="mt-8 border-t border-white/20 pt-6">
              <p class="text-[0.71rem] font-bold uppercase tracking-[0.15em] text-white/60">
                {distinction.abroad.packageName}
              </p>
              <p class="figure-num mt-2 text-[2.1rem] leading-none text-flame-light">{distinction.abroad.price}</p>
              <ul class="mt-6 grid gap-2.5">
                {distinction.abroad.includes.map((i) => (
                  <li class="flex items-start gap-3 text-[0.94rem] leading-relaxed text-white/88">
                    <span class="mt-1 text-flame-light"><Icon name="check" size={14} /></span>
                    {i}
                  </li>
                ))}
              </ul>
              <p class="mt-5 text-[0.77rem] leading-relaxed text-white/55">{distinction.abroad.priceNote}</p>
            </div>

            <a
              href={distinction.abroad.cta.href}
              class="btn btn-flame mt-8 w-full"
              data-track="cta_click"
              data-situation={distinction.abroad.cta.situation}
            >
              {distinction.abroad.cta.label}
              <Icon name="arrow" size={16} />
            </a>
          </div>
        </article>

        <article class="overflow-hidden rounded-2xl border border-line bg-paper">
          <Photo
            src={distinction.inNl.photo.src}
            alt={distinction.inNl.photo.alt}
            class="h-56 w-full object-cover md:h-64"
          />
          <div class="p-7 md:p-9">
            <h3 class="text-[1.4rem]">{distinction.inNl.title}</h3>
            <div class="prose-lander mt-3.5 text-[0.97rem] leading-relaxed text-ink-soft">
              {distinction.inNl.body.map((p) => <p>{p}</p>)}
            </div>
            <a
              href={distinction.inNl.cta.href}
              class="btn btn-outline mt-8 w-full"
              data-track="cta_click"
              data-situation={distinction.inNl.cta.situation}
            >
              {distinction.inNl.cta.label}
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>
)}

<!-- 6. WHY IMMIGRATION SERVICES NL (brief §8 section 4).
     The photograph runs off the left edge of the viewport: the one place the
     layout breaks its own grid, and the reason the page reads as designed
     rather than assembled. -->
<section class="section overflow-hidden bg-cream" id="waarom">
  <div class="container-site">
    <div class="grid gap-12 lg:grid-cols-[0.98fr_1.02fr] lg:items-center lg:gap-16">
      <div class="lg:[margin-left:calc(-1*max(2rem,calc((100vw-78rem)/2+2rem)))]">
        <Photo
          src={c.help.photo.src}
          alt={c.help.photo.alt}
          sizes="(min-width: 1024px) 46rem, 100vw"
          class="aspect-[5/4] w-full rounded-2xl object-cover lg:rounded-l-none"
        />
      </div>

      <div>
        <p class="tab"><span class="tab-num">{num('help')}</span>{c.help.eyebrow}</p>
        <h2 class="display-2 mt-6">{c.help.heading}</h2>
        <p class="lede mt-6 text-ink-soft">{c.help.intro}</p>

        <ul class="mt-9 border-t border-line">
          {c.help.items.map((item, i) => (
            <li class="flex gap-5 border-b border-line py-5">
              <span class="figure-num w-7 shrink-0 pt-0.5 text-[0.85rem] text-flame-ink">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-[1.08rem]">{item.title}</h3>
                <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink-soft">{item.body}</p>
              </div>
            </li>
          ))}
        </ul>

        <a href={c.help.cta.href} class="btn btn-ink mt-9" data-track="cta_click" data-situation={c.help.cta.situation}>
          {c.help.cta.label}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

{steps && (
  <!-- HOW IT WORKS (brief §8 section 5). The route again, three stops. -->
  <section class="section bg-sand" id="werkwijze">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="tab"><span class="tab-num">{num('steps')}</span>{steps.eyebrow}</p>
        <h2 class="display-2 mt-6">{steps.heading}</h2>
        <p class="lede mt-5 text-ink-soft">{steps.intro}</p>
      </div>

      <ol class="route mt-16" style="--route-ring: #f2e5d2">
        {steps.items.map((s, i) => (
          <li class="route-stop">
            <span class="route-dot"></span>
            {i < steps.items.length - 1 && <span class="route-line"></span>}
            <span class="figure-num block text-[0.8rem] tracking-[0.12em] text-flame-ink">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-[1.14rem]">{s.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-soft">{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="mt-14">
        <a href={steps.cta.href} class="btn btn-ink" data-track="cta_click" data-situation={steps.cta.situation}>
          {steps.cta.label}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>
)}

<!-- 7. REVIEWS. Only reviews actually received (brief §21). -->
<section class="section bg-cream" id="ervaringen">
  <div class="container-site">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
      <div>
        <p class="tab"><span class="tab-num">{num('reviews')}</span>{c.reviews.eyebrow}</p>
        <h2 class="display-2 mt-6">{c.reviews.heading}</h2>
      </div>
      <p class="lede text-ink-soft lg:pb-1">{c.reviews.intro}</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {c.reviews.items.map((r) => (
        <figure class="flex h-full flex-col rounded-2xl bg-sand p-8 md:p-10">
          <span class="text-flame"><Icon name="quote" size={26} /></span>
          <blockquote class="mt-5 flex-1 font-display text-[1.28rem] font-medium leading-[1.35] text-deep md:text-[1.42rem]">
            {r.quote}
          </blockquote>
          <figcaption class="mt-8 flex items-center gap-3 border-t border-line pt-5 text-[0.9rem]">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-flame"></span>
            <span class="font-semibold text-deep">{r.name}</span>
            <span class="text-ink-soft">{r.context}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12 border-t border-line pt-7">
      <p class="text-[0.75rem] font-bold uppercase tracking-[0.15em] text-ink-soft">{c.reviews.countriesLabel}</p>
      <p class="mt-3 font-display text-[1.05rem] font-medium leading-relaxed text-deep md:text-[1.2rem]">
        {c.reviews.countries.map((country, i) => (
          <>
            {i > 0 && <span class="px-2 text-flame" aria-hidden="true">·</span>}
            {country}
          </>
        ))}
      </p>
    </div>
  </div>
</section>

{band && (
  <!-- 8. PHOTO BAND: the human reason for the procedure -->
  <section class="relative isolate overflow-hidden bg-deeper text-white">
    <Photo
      src={band.photo.src}
      alt={band.photo.alt}
      sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_45%]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-deeper/88 to-deeper/78 md:hidden"></div>
    <div
      class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-deeper/95 from-8% via-deeper/72 via-52% to-deeper/10 md:block"
    >
    </div>

    <div class="container-site py-24 md:py-32">
      <div class="max-w-xl">
        <h2 class="display-2 text-white">{band.heading}</h2>
        <p class="lede mt-6 text-white/85">{band.body}</p>
        <a href={band.cta.href} class="btn btn-flame mt-9" data-track="cta_click" data-situation={band.cta.situation}>
          {band.cta.label}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>
)}

{aside && (
  <!-- A visitor this page is not for, kept inside the group (brief §9). -->
  <section class="section-tight bg-cream">
    <div class="container-site">
      <div class="flex flex-col gap-4 border-l-[3px] border-flame pl-6 md:flex-row md:items-center md:justify-between md:gap-10">
        <div class="max-w-2xl">
          <h2 class="text-[1.15rem]">{aside.heading}</h2>
          <p class="mt-2 text-[0.96rem] leading-relaxed text-ink-soft">{aside.body}</p>
        </div>
        <a
          href={aside.href}
          class="inline-flex shrink-0 items-center gap-2 text-[0.96rem] font-semibold text-flame-ink underline underline-offset-4 hover:text-deep"
        >
          {aside.linkLabel}
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </section>
)}

<!-- 9. FAQ. CSS-only accordion, no JS gating of content. -->
<section class="section bg-sand" id="vragen">
  <div class="container-site grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="tab"><span class="tab-num">{num('faq')}</span>{c.faq.eyebrow}</p>
      <h2 class="display-2 mt-6">{c.faq.heading}</h2>
      <p class="mt-5 text-[1.02rem] leading-relaxed text-ink-soft">{c.faq.intro}</p>
      <a
        href={whatsappUrl(c.whatsapp.text)}
        target="_blank"
        rel="noopener"
        data-track="whatsapp_click"
        class="mt-6 inline-flex items-center gap-2.5 text-[0.96rem] font-semibold text-flame-ink underline underline-offset-4 hover:text-deep"
      >
        <Icon name="whatsapp" size={18} />
        {c.whatsapp.label}
      </a>
    </div>

    <div class="border-t border-line-strong">
      {c.faq.items.map((item, i) => (
        <details class="group border-b border-line-strong" open={i === 0}>
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-8 py-5 font-display text-[1.06rem] font-semibold text-deep [&::-webkit-details-marker]:hidden"
          >
            {item.q}
            <span class="faq-mark relative h-3.5 w-3.5 shrink-0" aria-hidden="true"></span>
          </summary>
          <p class="pb-6 pr-8 text-[0.98rem] leading-relaxed text-ink-soft">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 10. FINAL CTA + LEAD FORM -->
<section class="section relative isolate overflow-hidden bg-deeper text-white" id="contact">
  <Photo
    src={(c.finalCta.photo ?? c.hero.photo).src}
    alt=""
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_45%] opacity-25"
  />
  <div class="absolute inset-0 -z-10 bg-deeper/82"></div>

  <div class="container-site grid gap-12 lg:grid-cols-[0.88fr_1.12fr] lg:items-start lg:gap-16">
    <div class="lg:sticky lg:top-28">
      <p class="tab-light"><span class="text-flame-light">{num('final')}</span>{c.finalCta.eyebrow}</p>
      <h2 class="display-2 mt-6 text-white">{c.finalCta.heading}</h2>
      <p class="lede mt-6 text-white/82">{c.finalCta.body}</p>

      <ul class="mt-8 grid gap-3">
        {c.finalCta.assurances.map((a) => (
          <li class="flex items-start gap-3 text-[0.97rem] text-white/88">
            <span class="mt-1 text-flame-light"><Icon name="check" size={15} /></span>
            {a}
          </li>
        ))}
      </ul>

      <div class="mt-9 border-t border-white/16 pt-7">
        <p class="text-[0.88rem] text-white/60">{c.finalCta.directContact}</p>
        <div class="mt-3 flex flex-wrap items-center gap-x-7 gap-y-3 text-[0.98rem]">
          <a href={`tel:${brand.phone.e164}`} class="inline-flex items-center gap-2.5 text-white hover:text-flame-light">
            <Icon name="phone" size={16} />{brand.phone.display}
          </a>
          <a
            href={whatsappUrl(c.whatsapp.text)}
            target="_blank"
            rel="noopener"
            data-track="whatsapp_click"
            class="inline-flex items-center gap-2.5 text-white hover:text-flame-light"
          >
            <Icon name="whatsapp" size={17} />{brand.whatsapp.display}
          </a>
        </div>
      </div>
    </div>

    <LeadForm lang={lang} c={c} id="lead-final" source="Afsluitende CTA" fields="full" columns={2} />
  </div>
</section>
