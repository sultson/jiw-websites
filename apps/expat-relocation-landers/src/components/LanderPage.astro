    <div class="mx-auto mt-9 flex max-w-3xl flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-white/12 pt-8 text-[0.98rem]">
      <p class="text-[0.9rem] text-white/65">{c.finalCta.directContact}</p>
      <a href={`tel:${brand.phone.e164}`} class="inline-flex items-center gap-2.5 text-white hover:text-accent-bright">
        <Icon name="phone" size={16} />{brand.phone.display}
      </a>
      <a
        href={whatsappUrl(c.whatsapp.text)}
        target="_blank"
        rel="noopener"
        data-track="whatsapp_click"
        class="inline-flex items-center gap-2.5 text-white hover:text-accent-bright"
      >
        <Icon name="whatsapp" size={17} />{brand.whatsapp.display}
      </a>
    </div>
  </div>
</section>
