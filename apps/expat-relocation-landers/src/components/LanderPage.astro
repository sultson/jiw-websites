<script>
  /* --- The situation checker ---------------------------------------- *
   * Reads the three radio groups, swaps the result panel, and carries the
   * answers into the lead form: the hidden `situation` field gets a one-line
   * summary and the closing form's message box is pre-filled, so the first
   * phone call starts from something real instead of from zero.           */
  const checker = document.querySelector<HTMLElement>('[data-checker]');
  if (checker) {
    const results = JSON.parse(checker.dataset.results ?? '{}') as Record<string, { title: string; body: string }>;
    const fallback = JSON.parse(checker.dataset.default ?? '{}') as { title: string; body: string };
    const key = checker.dataset.resultKey ?? '';
    const title = checker.querySelector<HTMLElement>('[data-check-title]');
    const body = checker.querySelector<HTMLElement>('[data-check-body]');
    const cta = checker.querySelector<HTMLAnchorElement>('[data-check-cta]');
    const baseSituation = cta?.dataset.situation ?? '';

    const update = () => {
      const answers: string[] = [];
      let outcome = fallback;
      checker.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked').forEach((input) => {
        answers.push(`${input.dataset.question ?? ''} ${input.value}`);
        if (input.name === `check-${key}`) outcome = results[input.value] ?? fallback;
      });
      if (title) title.textContent = outcome.title;
      if (body) body.textContent = outcome.body;
      if (cta && answers.length) cta.dataset.situation = `${baseSituation}: ${answers.join(' | ')}`;
    };

    checker.addEventListener('change', update);

    // The answers are worth more in the message box than in a tracking field,
    // so they are written there too — but only if the visitor has not already
    // typed something of their own.
    cta?.addEventListener('click', () => {
      const lines: string[] = [];
      checker.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked').forEach((input) => {
        lines.push(`${input.dataset.question ?? ''} ${input.value}`);
      });
      if (!lines.length) return;
      document.querySelectorAll<HTMLTextAreaElement>('textarea[name="message"]').forEach((box) => {
        if (!box.value.trim()) box.value = lines.join('\n');
      });
    });
  }

  /* --- Exit intent (desktop only, once per session) ------------------ */
  const modal = document.querySelector<HTMLElement>('[data-exit-intent]');
  if (modal && window.matchMedia('(min-width: 1024px)').matches) {
    const KEY = 'isnl_exit_shown';
    const close = () => {
      modal.hidden = true;
      modal.classList.remove('flex');
    };
    const open = () => {
      if (sessionStorage.getItem(KEY)) return;
      // Never interrupt someone who is already converting.
      if (document.querySelector('form[data-lead-form] input:focus, form[data-lead-form] textarea:focus')) return;
      try {
        sessionStorage.setItem(KEY, '1');
      } catch (e) {
        /* private mode: show it once and never track it */
      }
      modal.hidden = false;
      modal.classList.add('flex');
      (window as any).dataLayer?.push({ event: 'exit_intent_shown' });
    };

    document.addEventListener('mouseout', (e) => {
      if (e.relatedTarget === null && (e as MouseEvent).clientY <= 0) open();
    });
    modal.querySelector('[data-exit-close]')?.addEventListener('click', close);
    modal.querySelector('[data-exit-accept]')?.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  }
</script>
