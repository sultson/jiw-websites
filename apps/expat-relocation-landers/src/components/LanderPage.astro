---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import LeadForm from './LeadForm.astro';
import HeroProof from './HeroProof.astro';
import Gable from './Gable.astro';
import { brand, whatsappUrl } from '../lib/brand';
import type { Lang, LanderContent } from '../sites';

interface Props {
  lang: Lang;
  c: LanderContent;
}
const { lang, c } = Astro.props;
// Destructured so TypeScript keeps the narrowing inside the .map() callbacks
// below; the optional sections are what make one template serve eight briefs.
const { explain, checker, packages, compare, journey, relationship, routing, distinction, steps, gallery, band, aside } =
  c;

const wa = whatsappUrl(c.whatsapp.text);
const waLabel = c.hero.whatsappCta ?? c.whatsapp.label;

// The trajectory strip is a horizontal scroller on a phone and one column per
// stop from md up. Static class names, so Tailwind can see them; a dynamic
// `grid-template-columns` would also apply on the phone and squeeze every
// stop into the same screen.
const JOURNEY_COLS: Record<number, string> = {
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-4',
  5: 'md:grid-cols-5',
  6: 'md:grid-cols-6',
};
const journeyCols = JOURNEY_COLS[journey?.items.length ?? 0] ?? 'md:grid-cols-4';

// The badge strip is what keeps two cards of different heights aligned at the
// top, so it is drawn on every card as soon as one card carries a label.
const cardBadges = packages?.cards.some((card) => card.badge) ?? false;
---

<!--
  1. HERO (brief §8 section 1; rebuilt after the client's 31-08 feedback,
  restyled after her own reference draft of 02-09, and thinned out on 03-09).

  Six things, no more: who this is for (chip + H1), what we do (one short
  paragraph), what you get (four benefits), what to do next (two buttons),
  what it costs (one line), and the form. The photograph of a couple runs down
  the right of the screen and the form sits on its lower edge, sharing its
  exact left and right edges so the two read as one object. WhatsApp sits
  beside the primary button, as it does in every block: for this audience it
  is the channel they already use to talk to each other across the distance.
-->
<section class="relative isolate overflow-hidden bg-deep text-white">
  <div
    class="pointer-events-none absolute -left-40 -top-40 -z-10 h-[38rem] w-[38rem] rounded-full opacity-70"
    style="background: radial-gradient(closest-side, rgba(31,95,168,0.8), transparent 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="container-site grid gap-y-6 py-7 lg:grid-cols-[1.04fr_0.96fr] lg:items-start lg:gap-x-14 lg:py-16">
    <!-- Photograph. First thing on a phone, top-right on a desktop. -->
    <div class="relative order-1 lg:order-2 lg:col-start-2 lg:row-start-1">
      <Photo
        src={c.hero.photo.src}
        alt={c.hero.photo.alt}
        sizes="(min-width: 1024px) 36rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-[15rem] w-full rounded-2xl object-cover object-[50%_22%] sm:h-[20rem] lg:h-[28rem]"
      />
      {c.hero.proof && (
        <HeroProof proof={c.hero.proof} class="hidden lg:absolute lg:right-4 lg:top-4 lg:block lg:max-w-[15.5rem]" />
      )}
    </div>

    <!-- Copy. -->
    <div class="order-2 lg:order-1 lg:col-start-1 lg:row-span-2 lg:row-start-1 lg:pr-4">
      <p class="inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-[0.66rem] font-bold uppercase tracking-[0.12em] text-white/90 sm:text-[0.74rem] sm:tracking-[0.13em]">
        <span class="h-2 w-2 shrink-0 rounded-full bg-flame" aria-hidden="true"></span>
        {c.hero.eyebrow}
      </p>

      <h1 class="display-1 mt-5 text-white" set:html={c.hero.h1} />

      <div class="prose-lander lede mt-5 max-w-[33rem] text-white/82">
        {c.hero.intro.map((p) => <p>{p}</p>)}
      </div>

      <ul class="mt-6 grid max-w-[34rem] gap-x-6 gap-y-2.5 sm:grid-cols-2">
        {c.hero.benefits.map((b) => (
          <li class="flex items-center gap-2.5 text-[0.96rem] font-medium leading-snug text-white">
            <span class="tick"><Icon name="check" size={12} /></span>
            {b}
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a href={c.hero.cta.href} class="btn btn-flame" data-track="cta_click" data-situation={c.hero.cta.situation}>
          {c.hero.cta.label}
          <Icon name="arrow" size={17} />
        </a>
        <a href={wa} target="_blank" rel="noopener" class="btn btn-wa" data-track="whatsapp_click">
          <Icon name="whatsapp" size={18} />{waLabel}
        </a>
      </div>

      {c.hero.offer && (
        <div class="mt-6 max-w-[33rem] border-t border-white/15 pt-5">
          <p class="text-[0.95rem] text-white/85">
            <span class="font-semibold text-white">{c.hero.offer.name}</span>
            <span class="px-2 text-flame-light" aria-hidden="true">·</span>
            <span class="figure-num inline-block whitespace-nowrap text-[1.15rem] text-white">{c.hero.offer.price}</span>
          </p>
          <p class="mt-1.5 text-[0.76rem] leading-relaxed text-white/55">{c.hero.offer.note}</p>
        </div>
      )}
    </div>

    <!-- Lead form. Above the fold on a desktop, sitting on the lower edge of
         the photograph; after the copy on a phone. -->
    <div id="aanvraag" class="relative z-10 order-3 scroll-mt-24 lg:col-start-2 lg:row-start-2 lg:-mt-24">
      <LeadForm lang={lang} c={c} id="lead-hero" source="Hero" fields="short" />
    </div>

    {c.hero.proof && <HeroProof proof={c.hero.proof} class="order-4 lg:hidden" />}
  </div>

  <Gable />
</section>

<!-- 2. TRUST BAR (brief §8 section 2). Substantiated claims only. -->
<section class="bg-mist">
  <div class="container-site -mt-1 pb-2 pt-6 md:pt-8">
    <div class="card grid divide-y divide-line-soft md:grid-cols-4 md:divide-x md:divide-y-0">
      {c.stats.map((s) => (
        <div class="px-6 py-5 md:px-7 md:py-6">
          <p class="figure-num text-[1.55rem] leading-none text-deep md:text-[1.7rem]">{s.value}</p>
          <p class="mt-2 text-[0.9rem] leading-snug text-ink-soft">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{explain && (
  <!-- 3. RECOGNITION (brief §8 section 3). A wall of situations in the
       visitor's own words, so the section reads "this is us". -->
  <section class="section bg-mist" id={routing ? 'uitleg' : 'situatie'}>
    <div class="container-site grid gap-12 lg:grid-cols-[0.84fr_1.16fr] lg:gap-16">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="tab">{explain.eyebrow}</p>
        <h2 class="display-2 mt-5">{explain.heading}</h2>
        <div class="prose-lander mt-6 text-[1.02rem] leading-relaxed text-ink-soft">
          {explain.body.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
          <a href={explain.cta.href} class="btn btn-flame" data-track="cta_click" data-situation={explain.cta.situation}>
            {explain.cta.label}
            <Icon name="arrow" size={16} />
          </a>
          <a href={wa} target="_blank" rel="noopener" class="btn btn-outline" data-track="whatsapp_click">
            <Icon name="whatsapp" size={17} class="text-wa" />{waLabel}
          </a>
        </div>
      </div>

      <div>
        <ul class="grid gap-3.5 sm:grid-cols-2">
          {explain.points.map((p) =>
            explain.pointsStyle === 'quotes' ? (
              <li class="card px-6 py-5">
                <span class="block text-flame"><Icon name="quote" size={20} /></span>
                <p class="mt-2.5 font-display text-[1.05rem] font-semibold leading-snug text-deep">{p}</p>
              </li>
            ) : (
              <li class="card flex items-start gap-3 px-6 py-5 text-[0.98rem] leading-snug">
                <span class="tick-quiet mt-0.5"><Icon name="check" size={12} /></span>
                {p}
              </li>
            ),
          )}
        </ul>

        <div class="mt-5">
          <Photo
            src={explain.photo.src}
            alt={explain.photo.alt}
            sizes="(min-width: 1024px) 44rem, 100vw"
            class="h-[15rem] w-full rounded-2xl object-cover sm:h-[21rem]"
          />
          <div class="card-deep relative mx-4 -mt-12 p-6 text-[0.97rem] leading-relaxed sm:mx-8 sm:max-w-lg md:p-7">
            {explain.photoNote}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

{checker && (
  <!-- 4. THE SITUATION CHECKER.
       Three questions the visitor answers in place. It is not a gate in front
       of the form (brief §5 forbids that) — it is the interactive element the
       client asked for, and its answers travel with the lead so the first call
       starts from something real. The result panel ships with copy in the HTML;
       JS only swaps it. -->
  <section class="section bg-haze" id="check">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab">{checker.eyebrow}</p>
          <h2 class="display-2 mt-5">{checker.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{checker.intro}</p>
      </div>

      <div
        class="mt-10 grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-8"
        data-checker
        data-result-key={checker.resultKey}
        data-results={JSON.stringify(checker.results)}
        data-default={JSON.stringify(checker.resultDefault)}
      >
        <div class="card p-6 md:p-9">
          {checker.questions.map((q, qi) => (
            <fieldset class={qi > 0 ? 'mt-8 border-t border-line pt-8' : ''}>
              <legend class="flex items-center gap-3 font-display text-[1.06rem] font-bold text-deep">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-flame-soft text-[0.8rem] font-bold text-flame-ink">
                  {qi + 1}
                </span>
                {q.label}
              </legend>
              <div class="mt-4 flex flex-wrap gap-2.5">
                {q.options.map((opt) => (
                  <label class="opt">
                    <input type="radio" name={`check-${q.id}`} value={opt} data-question={q.label} />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>

        <div class="flex flex-col gap-5">
          <div class="card-deep p-7 md:p-8">
            <p class="tab-light">{checker.note}</p>
            <h3 class="mt-4 text-[1.3rem] text-white" data-check-title>{checker.resultDefault.title}</h3>
            <p class="mt-3 text-[0.97rem] leading-relaxed text-white/80" data-check-body>
              {checker.resultDefault.body}
            </p>
            <a
              href={checker.cta.href}
              class="btn btn-flame mt-7 w-full"
              data-track="cta_click"
              data-situation={checker.cta.situation}
              data-check-cta
            >
              {checker.cta.label}
              <Icon name="arrow" size={16} />
            </a>
          </div>

          {checker.photo && (
            <Photo
              src={checker.photo.src}
              alt={checker.photo.alt}
              sizes="(min-width: 1024px) 28rem, 100vw"
              class="hidden h-[14rem] w-full rounded-2xl object-cover lg:block"
            />
          )}
        </div>
      </div>
    </div>
  </section>
)}

{packages && (
  <!-- 5. CHOOSE THE RIGHT LEVEL OF ASSISTANCE. Two clearly defined services,
       one lead form behind both (brief §9: never eight competing boxes). The
       primary goal is the only dark object on a light page, so the eye has
       nowhere else to go. -->
  <section class="section bg-mist" id="begeleiding">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab">{packages.eyebrow}</p>
          <h2 class="display-2 mt-5">{packages.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{packages.intro}</p>
      </div>

      <div class="mt-12 grid items-start gap-6 lg:grid-cols-2 lg:gap-8">
        {packages.cards.map((card) => (
          <article
            class={`flex h-full flex-col overflow-hidden ${
              card.featured ? 'card-deep ring-2 ring-flame lg:-mt-8' : 'card'
            }`}
          >
            {cardBadges && (
              <p
                class={`px-7 py-3 text-[0.72rem] font-bold uppercase tracking-[0.14em] md:px-9 ${
                  card.featured ? 'bg-flame text-white' : 'border-b border-line-soft bg-haze text-flame-ink'
                }`}
              >
                {card.badge ?? ' '}
              </p>
            )}

            <div class="flex flex-1 flex-col p-7 md:p-9">
              <h3 class={`text-[1.4rem] md:text-[1.55rem] ${card.featured ? 'text-white' : ''}`}>{card.title}</h3>
              <p
                class={`figure-num mt-4 text-[2.3rem] leading-none md:text-[2.6rem] ${
                  card.featured ? 'text-flame-light' : 'text-deep'
                }`}
              >
                {card.price}
              </p>
              <p class={`mt-4 text-[0.97rem] leading-relaxed ${card.featured ? 'text-white/75' : 'text-ink-soft'}`}>
                {card.body}
              </p>

              {card.includesHeading && (
                <p
                  class={`mt-8 border-t pt-4 text-[0.72rem] font-bold uppercase tracking-[0.15em] ${
                    card.featured ? 'border-white/20 text-white/65' : 'border-line text-ink-soft'
                  }`}
                >
                  {card.includesHeading}
                </p>
              )}
              <ul class="mt-5 grid flex-1 gap-2.5">
                {card.includes.map((i) => (
                  <li
                    class={`flex items-start gap-3 text-[0.95rem] leading-relaxed ${
                      card.featured ? 'text-white/90' : ''
                    }`}
                  >
                    <span class={card.featured ? 'tick-light mt-0.5' : 'tick-quiet mt-0.5'}>
                      <Icon name="check" size={12} />
                    </span>
                    {i}
                  </li>
                ))}
              </ul>

              <a
                href={card.cta.href}
                class={`btn mt-9 w-full ${card.featured ? 'btn-flame' : 'btn-outline'}`}
                data-track="cta_click"
                data-situation={card.cta.situation}
              >
                {card.cta.label}
                <Icon name="arrow" size={16} />
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-9 max-w-3xl text-[0.82rem] leading-relaxed text-ink-soft">{packages.note}</p>
    </div>
  </section>
)}

{compare && (
  <!-- 6. SELF vs. WITH US. The client asked for "why choose us" to be
       answered properly. A comparison answers it with facts instead of
       adjectives, and it is the section that converts the researcher. -->
  <section class="section bg-haze" id="waarom-wij">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab">{compare.eyebrow}</p>
          <h2 class="display-2 mt-5">{compare.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{compare.intro}</p>
      </div>

      <div class="card mt-10 overflow-hidden">
        <div class="hidden grid-cols-[1.1fr_1fr_1.15fr] border-b border-line md:grid">
          <p class="px-7 py-4 text-[0.72rem] font-bold uppercase tracking-[0.15em] text-ink-soft">&nbsp;</p>
          <p class="px-7 py-4 text-[0.72rem] font-bold uppercase tracking-[0.15em] text-ink-soft">
            {compare.selfLabel}
          </p>
          <p class="bg-deep px-7 py-4 text-[0.72rem] font-bold uppercase tracking-[0.15em] text-flame-light">
            {compare.usLabel}
          </p>
        </div>

        {compare.rows.map((row) => (
          <div class="grid border-b border-line last:border-b-0 md:grid-cols-[1.1fr_1fr_1.15fr]">
            <p class="px-7 pt-6 font-display text-[1.02rem] font-bold text-deep md:py-6">{row.topic}</p>
            <p class="flex items-start gap-3 px-7 pt-3 text-[0.94rem] leading-relaxed text-ink-soft md:py-6">
              <span class="mt-[0.15rem] shrink-0 text-ink-soft/60 md:hidden">
                <Icon name="check" size={14} />
              </span>
              <span>
                <span class="font-semibold text-ink md:hidden">{compare.selfLabel}: </span>
                {row.self}
              </span>
            </p>
            <p class="mt-3 flex items-start gap-3 bg-deep px-7 py-5 text-[0.94rem] leading-relaxed text-white/90 md:mt-0 md:py-6">
              <span class="tick mt-0.5 shrink-0"><Icon name="check" size={11} /></span>
              <span>
                <span class="font-semibold text-white md:hidden">{compare.usLabel}: </span>
                {row.us}
              </span>
            </p>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-2xl text-[0.86rem] leading-relaxed text-ink-soft">{compare.note}</p>
        <a href={compare.cta.href} class="btn btn-flame shrink-0" data-track="cta_click" data-situation={compare.cta.situation}>
          {compare.cta.label}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>
)}

{journey && (
  <!-- 7. ONE COORDINATED TRAJECTORY. The route: one line, one stop per step,
       and a picture above every stop so the process reads as a story that ends
       at the front door, not at a decision letter. A scroller on a phone. -->
  <section class="section bg-mist" id="traject">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab">{journey.eyebrow}</p>
          <h2 class="display-2 mt-5">{journey.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{journey.intro}</p>
      </div>

      <ol
        class={`mt-12 grid snap-x snap-mandatory auto-cols-[76%] grid-flow-col gap-4 overflow-x-auto pb-2 [scrollbar-width:none] sm:auto-cols-[46%] md:auto-cols-auto md:grid-flow-row md:gap-x-10 md:overflow-visible ${journeyCols}`}
        style="--route-ring: #fbf7f1"
      >
        {journey.items.map((s, i) => (
          <li class="snap-start">
            {journey.photos?.[i] && (
              <Photo
                src={journey.photos[i].src}
                alt={journey.photos[i].alt}
                sizes="(min-width: 768px) 16rem, 76vw"
                class="aspect-[4/3] w-full rounded-xl object-cover"
              />
            )}
            <div class="route-stop mt-5">
              <span class="route-dot">{i + 1}</span>
              {i < journey.items.length - 1 && <span class="route-line hidden md:block"></span>}
              <h3 class="text-[1.1rem] md:pt-0.5">{s.title}</h3>
              <p class="mt-2 text-[0.94rem] leading-relaxed text-ink-soft">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="card-deep mt-12 flex flex-col gap-6 p-7 md:flex-row md:items-center md:justify-between md:gap-12 md:p-9">
        <p class="max-w-2xl font-display text-[1.25rem] font-bold leading-snug md:text-[1.45rem]">{journey.outcome}</p>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <a href={journey.cta.href} class="btn btn-flame" data-track="cta_click" data-situation={journey.cta.situation}>
            {journey.cta.label}
            <Icon name="arrow" size={16} />
          </a>
          <a href={wa} target="_blank" rel="noopener" class="btn btn-outline-light" data-track="whatsapp_click">
            <Icon name="whatsapp" size={17} />{waLabel}
          </a>
        </div>
      </div>
    </div>
  </section>
)}

{relationship && (
  <!-- 8. RELATIONSHIP FORM. A CSS-only tab set: married, registered,
       unmarried. Three answers in the space of one, and the first panel is in
       the HTML so nothing waits for JS. -->
  <section class="section bg-haze" id="relatievorm">
    <div class="container-site">
      <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-end lg:gap-16">
        <div>
          <p class="tab">{relationship.eyebrow}</p>
          <h2 class="display-2 mt-5">{relationship.heading}</h2>
        </div>
        <p class="lede text-ink-soft lg:pb-1">{relationship.intro}</p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
        <div class="tabset relative">
          {relationship.tabs.map((_tab, i) => (
            <input type="radio" name="relatievorm" id={`rel-${i}`} checked={i === 0} />
          ))}
          <div class="tab-list grid gap-2.5 sm:grid-cols-3">
            {relationship.tabs.map((t, i) => (
              <label class="tab-btn" for={`rel-${i}`}>{t.label}</label>
            ))}
          </div>
          <div class="tab-panels card mt-5 p-7 md:p-9">
            {relationship.tabs.map((t) => (
              <div class="tab-panel">
                <h3 class="text-[1.3rem]">{t.title}</h3>
                <p class="mt-3.5 text-[0.98rem] leading-relaxed text-ink-soft">{t.body}</p>
                <ul class="mt-6 grid gap-2.5">
                  {t.points.map((p) => (
                    <li class="flex items-start gap-3 text-[0.95rem] leading-relaxed">
                      <span class="tick-quiet mt-0.5"><Icon name="check" size={12} /></span>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-5">
          {relationship.photo && (
            <Photo
              src={relationship.photo.src}
              alt={relationship.photo.alt}
              sizes="(min-width: 1024px) 28rem, 100vw"
              class="h-[14rem] w-full rounded-2xl object-cover lg:h-[18rem]"
            />
          )}
          <div class="card-deep p-7 md:p-8">
            <p class="text-[0.97rem] leading-relaxed text-white/85">{relationship.note}</p>
            <a
              href={relationship.cta.href}
              class="btn btn-flame mt-6 w-full"
              data-track="cta_click"
              data-situation={relationship.cta.situation}
            >
              {relationship.cta.label}
              <Icon name="arrow" size={16} />
            </a>
          </div>
        </div>
