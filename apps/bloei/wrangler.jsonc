{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Heette tot 19-10-2026 `bloei-concept`, naar het enige adres dat er toen was.
  // De oude Worker is na het verplaatsen van die host weggehaald; staat hij er
  // toch nog, dan houdt hij niets meer vast.
  "name": "bloei",
  "account_id": "aec64586d4d04a644f4f9b8225d7ca28",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // De canonicals en de sitemap noemen elke pagina met een schuine streep aan
    // het eind (/assortiment/). Cloudflare moet dezelfde vorm serveren, anders
    // wijst elke canonical naar een adres dat eerst nog een omleiding is.
    "html_handling": "force-trailing-slash",
    // Elke pagina is als eigen bestand gebakken, dus er valt voor een
    // SPA-terugval niets te doen behalve 200 antwoorden op een adres dat niet
    // bestaat. Dat is een zachte 404, en die kost indexruimte.
    "not_found_handling": "404-page",
    // De Worker moet paginaverzoeken zien, niet alleen de API: anders krijgt de
    // HTML zijn Cache-Control niet mee en draait een eventuele omleiding naar de
    // canonieke host nooit. De bestanden met een hash in hun naam gaan er wel
    // omheen, die hebben er niets te halen.
    "run_worker_first": ["/*", "!/assets/*", "!/img/*", "!/favicon.svg", "!/logo-email.png"]
  },
  // Drie hosts, één winnaar. De kale is de canonieke (zie SITE_URL in
  // site.config.mjs); `www` en het oude conceptadres hangen hier bewust aan en
  // sturen met één 301 door via ANDERE_HOSTS in worker/index.ts.
  //
  // Waarom `www` erbij moet terwijl hij alleen doorstuurt: een host die hier
  // niet staat bestaat niet, en dan krijgt de helft van de bezoekers die uit
  // gewoonte www typt een foutpagina in plaats van een omleiding.
  //
  // Waarom het conceptadres blijft: het gaf tot de verhuizing een 200 met een
  // complete kopie van deze site. Het is gedeeld, dus het staat in iemands
  // tabblad en mogelijk in de index. Loskoppelen maakt er een dood adres van;
  // aan laten hangen geeft de waarde door aan het echte domein.
  //
  // custom_domain en geen gewone route: bij het koppelen zet Cloudflare zelf het
  // DNS-record klaar, wat een gewone route niet doet.
  "routes": [
    { "pattern": "bloei-ouddorp.nl", "custom_domain": true },
    { "pattern": "www.bloei-ouddorp.nl", "custom_domain": true },
    { "pattern": "bloei-concept.jouwconcept.app", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "binding": "FORM_UPLOADS",
      "bucket_name": "jiw-form-uploads-prod"
    }
  ],
  // Verstuurd vanaf het eigen afzenderdomein notify.bloei-ouddorp.nl, sinds
  // 19-10-2026. Dat stond tot dan op het gedeelde notify.jouwidealewebsite.nl:
  // goed genoeg voor een concept, maar dan komt de bevestiging van de winkel
  // aan vanaf het domein van het bureau, en dat is precies het soort verschil
  // tussen afzender en inhoud waar een spamfilter op let.
  //
  // Het domein is in Cloudflare Email Service aangemeld en ingeschakeld, met
  // DKIM, SPF en een DMARC op p=reject. Let op waar die records hangen: onder
  // `cf-bounce.notify.bloei-ouddorp.nl` en `_dmarc.notify.bloei-ouddorp.nl`,
  // NIET onder `notify.bloei-ouddorp.nl` zelf. Een lookup op die laatste naam
  // geeft niets terug en dat is geen bewijs dat er iets mist.
  //
  // Het deel voor de @ is vrij: `no-reply@` naar iets anders veranderen is deze
  // regel plus LEAD_SENDER hieronder, geen DNS-werk.
  //
  // De apex heeft zijn eigen Purelymail-records (MX, SPF, DKIM, DMARC) voor de
  // mailbox van de winkel. Dat staat hier los van en mag niet aangeraakt worden.
  "send_email": [
    {
      "name": "LEAD_EMAIL",
      "allowed_sender_addresses": ["no-reply@notify.bloei-ouddorp.nl"]
    }
  ],
  // Geen TURNSTILE_SECRET_KEY: dit formulier draait met `turnstile: false` en
  // leunt op het verborgen veld in worker/index.ts, dus er is geen widget om
  // tegen te controleren.
  // LET OP: de ontvanger is sinds 19-10-2026 de mailbox van de winkel zelf
  // (`info@bloei-ouddorp.nl`, op de Purelymail-records van de apex). Daarmee
  // geldt hier wat bij elke andere klantensite geldt: NOOIT een testaanvraag
  // tegen deze config, want die komt in hun inbox. Moet er getest worden, zet
  // LEAD_RECIPIENT eerst terug op `hallo@jouwidealewebsite.nl`.
  // In de bevestiging aan de klant staat dit adres niet: de winkel heeft ons
  // nog geen adres doorgegeven om te publiceren (zie WINKEL in site.config.mjs).
  "vars": {
    "SITE_ID": "bloei",
    "LEAD_RECIPIENT": "info@bloei-ouddorp.nl",
    "LEAD_SENDER": "no-reply@notify.bloei-ouddorp.nl"
  }
}
