{
  "name": "@jiw/3-diaspora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3065 --host=0.0.0.0",
    "build": "pnpm sitemap && vite build",
    "preview": "vite preview --port=4365",
    "clean": "rm -rf dist dist-worker",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "sitemap": "node scripts/sitemap.mjs",
    "ship": "pnpm build && wrangler deploy",
    "ship:dry-run": "pnpm build && wrangler deploy --dry-run --outdir=dist-worker"
  },
  "dependencies": {
    "@jiw/cloudflare-forms": "workspace:*",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "typescript": "~5.8.2"
  }
}
