# Cloudflare Workers Static Assets leest dit bestand.
#
# De bestanden in /assets/ dragen een hash in hun naam: verandert de inhoud, dan
# verandert de naam, dus ze mogen een jaar blijven staan. De foto's en de video
# staan onder een vaste naam en veranderen zelden; wordt er ooit een vervangen,
# dan hoort er een ?v=JJJJMMDD achter elke verwijzing (zie CLAUDE.md).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable

/logo-email.png
  Cache-Control: public, max-age=31536000, immutable

# Een dag: lang genoeg om niet bij elk bezoek opgehaald te worden, kort genoeg
# dat een nieuwe pagina binnen een dag in de sitemap staat.
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# Op alles: een site zonder deze regels is niet onveilig, maar wel een site die
# in een iframe van iemand anders kan staan, en die zijn adres meestuurt naar
# elke plek waar een bezoeker heen klikt.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
