---
import Layout from '../components/Layout.astro';
import PrivacyView from '../components/PrivacyView.astro';
import { getContent } from '../lib/content';
import { SECTIONS } from '../lib/i18n';

const lang = 'en' as const;
const p = getContent(lang).core.privacy;
---

<Layout title={p.metaTitle} description={p.intro[0] ?? p.title} lang={lang} path={SECTIONS.privacy} noindex>
  <PrivacyView lang={lang} />
</Layout>
