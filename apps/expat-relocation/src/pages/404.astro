---
import Layout from '../components/Layout.astro';
import { getContent } from '../lib/content';

const lang = 'en' as const;
const nf = getContent(lang).core.notFound;
---

<Layout title={nf.title} description={nf.text} lang={lang} path="/404" noindex>
  <section class="container-site flex min-h-[55vh] flex-col items-center justify-center py-20 text-center">
    <span class="font-display text-7xl text-gold">404</span>
    <h1 class="mt-6 font-display text-3xl md:text-4xl">{nf.title}</h1>
    <p class="mx-auto mt-4 max-w-md leading-relaxed">{nf.text}</p>
    <a href="/" class="btn btn-navy mt-9">{nf.label}</a>
  </section>
</Layout>
