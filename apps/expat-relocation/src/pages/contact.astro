---
import Layout from '../components/Layout.astro';
import ContactView from '../components/ContactView.astro';
import { getContent } from '../lib/content';
import { SECTIONS } from '../lib/i18n';

const lang = 'en' as const;
const ct = getContent(lang).core.contact;
---

<Layout title={ct.metaTitle} description={ct.metaDescription} lang={lang} path={SECTIONS.contact}>
  <ContactView lang={lang} />
</Layout>
