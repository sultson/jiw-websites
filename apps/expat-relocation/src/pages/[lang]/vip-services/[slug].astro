---
import Layout from '../../../components/Layout.astro';
import PackageView from '../../../components/PackageView.astro';
import { packageSlugs, packageProps } from '../../../lib/pages';
import { serviceJsonLd, faqJsonLd } from '../../../lib/seo';
import { NON_DEFAULT_LANGS, localizePath, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.flatMap((lang) => packageSlugs().map((slug) => ({ params: { lang, slug } })));
}
const lang = Astro.params.lang as Lang;
const { pkg, siblings, path } = packageProps(lang, Astro.params.slug);
---

<Layout
  title={pkg.metaTitle}
  description={pkg.metaDescription}
  lang={lang}
  path={path}
  image={pkg.image}
  jsonLd={[serviceJsonLd(pkg.name, pkg.metaDescription, localizePath(path, lang), lang), faqJsonLd(pkg.faq.items)]}
>
  <PackageView lang={lang} pkg={pkg} siblings={siblings} />
</Layout>
