---
import Layout from '../../components/Layout.astro';
import HomeView from '../../components/HomeView.astro';
import { getContent } from '../../lib/content';
import { NON_DEFAULT_LANGS, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = getContent(lang).core.home;
---

<Layout title={c.metaTitle} description={c.metaDescription} lang={lang} path={'/'}>
  <HomeView lang={lang} />
</Layout>
