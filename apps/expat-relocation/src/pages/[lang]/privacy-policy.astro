---
import Layout from '../../components/Layout.astro';
import PrivacyView from '../../components/PrivacyView.astro';
import { getContent } from '../../lib/content';
import { NON_DEFAULT_LANGS, SECTIONS, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const p = getContent(lang).core.privacy;
---

<Layout title={p.metaTitle} description={p.intro[0] ?? p.title} lang={lang} path={SECTIONS.privacy} noindex>
  <PrivacyView lang={lang} />
</Layout>
