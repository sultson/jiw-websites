---
import Layout from '../../../components/Layout.astro';
import ServiceView from '../../../components/ServiceView.astro';
import { sectionServiceSlugsForLang, serviceProps } from '../../../lib/pages';
import { serviceJsonLd, faqJsonLd } from '../../../lib/seo';
import { NON_DEFAULT_LANGS, localizePath, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.flatMap((lang) =>
    sectionServiceSlugsForLang(lang, 'immigration').map((slug) => ({ params: { lang, slug } }))
  );
}
const lang = Astro.params.lang as Lang;
const { section, service, basePath, siblings, path } = serviceProps(lang, 'immigration', Astro.params.slug);
const specialist = service.slug === 'artist-visa-netherlands' || service.slug === 'athlete-visa-netherlands';
const availableLangs = specialist ? (['en', 'nl'] as const) : undefined;
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  lang={lang}
  path={path}
  image={service.image}
  availableLangs={availableLangs}
  jsonLd={[serviceJsonLd(service.title, service.metaDescription, localizePath(path, lang), lang), faqJsonLd(service.faq.items)]}
>
  <ServiceView lang={lang} service={service} basePath={basePath} sectionTitle={section.title} sectionImage={section.image} siblings={siblings} />
</Layout>
