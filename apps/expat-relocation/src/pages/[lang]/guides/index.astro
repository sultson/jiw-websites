---
import Layout from '../../../components/Layout.astro';
import GuidesHubView from '../../../components/GuidesHubView.astro';
import { getContent } from '../../../lib/content';
import { NON_DEFAULT_LANGS, SECTIONS, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const g = getContent(lang).guides;
---

<Layout title={g.metaTitle} description={g.metaDescription} lang={lang} path={SECTIONS.guides}>
  <GuidesHubView lang={lang} />
</Layout>
