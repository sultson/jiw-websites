---
import Layout from '../../../components/Layout.astro';
import GuideView from '../../../components/GuideView.astro';
import { guideSlugs, guideProps } from '../../../lib/pages';
import { NON_DEFAULT_LANGS, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LANGS.flatMap((lang) => guideSlugs().map((slug) => ({ params: { lang, slug } })));
}
const lang = Astro.params.lang as Lang;
const { guide, siblings, path } = guideProps(lang, Astro.params.slug);
---

<Layout title={guide.metaTitle} description={guide.metaDescription} lang={lang} path={path}>
  <GuideView lang={lang} guide={guide} siblings={siblings} />
</Layout>
