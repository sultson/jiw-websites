---
import Layout from '../../components/Layout.astro';
import HubView from '../../components/HubView.astro';
import { getContent } from '../../lib/content';
import { SECTIONS } from '../../lib/i18n';

const lang = 'en' as const;
const section = getContent(lang).relocation;
---

<Layout title={section.metaTitle} description={section.metaDescription} lang={lang} path={SECTIONS.relocation} image={section.image}>
  <HubView lang={lang} section={section} basePath={SECTIONS.relocation} />
</Layout>
