---
import { type Lang } from '../lib/i18n';
import { getContent } from '../lib/content';
import PageHero from './PageHero.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = getContent(lang).core.privacy;
---

<PageHero title={p.title} />

<article class="container-site py-14 md:py-18">
  <div class="mx-auto max-w-2xl">
    {p.intro.map((para) => (
      <p class="mt-4 leading-relaxed first:mt-0">{para}</p>
    ))}
    {p.sections.map((s) => (
      <section class="mt-10">
        <h2 class="font-display text-2xl">{s.heading}</h2>
        {s.paragraphs.map((para) => (
          <p class="mt-3 leading-relaxed">{para}</p>
        ))}
      </section>
    ))}
  </div>
</article>
