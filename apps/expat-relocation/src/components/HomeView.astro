---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { site } from '../data/site';
import { SECTIONS, localizePath, type Lang } from '../lib/i18n';
import { getContent } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const h = c.core.home;
const l = (p: string) => localizePath(p, lang);

/* The three entry paths are ordered here rather than in the content files so all
   six languages stay in step. Relocation and VIP lead, immigration follows: the
   brand is a boutique relocation consultancy that also handles immigration. */
const PATH_ORDER = ['relocation', 'vip', 'immigration'];
const paths = [...h.paths.items].sort(
  (a, b) => PATH_ORDER.indexOf(a.key) - PATH_ORDER.indexOf(b.key)
);
---

<!-- 1. Hero: edge-to-edge video, left-aligned copy -->
<section class="relative flex min-h-[92svh] items-center overflow-hidden bg-navy pt-24">
  <video
    id="hero-video"
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/hero-poster.jpg"
  >
    <source src="/hero.mp4" type="video/mp4" />
  </video>
  <!-- Poster overlay: fades out once the video is actually rendering frames, so the
       thumbnail-to-video switch is a soft crossfade instead of a hard cut. -->
  <img
    id="hero-poster-overlay"
    src="/images/hero-poster.jpg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ease-out"
    width="1280"
    height="720"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/50 to-navy/20"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-navy/80 via-navy/40 to-transparent"></div>
  <div class="container-site relative py-20">
    <div class="max-w-3xl">
      <p class="flex items-center gap-3">
        <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
        <span class="eyebrow">{site.tagline}</span>
      </p>
      <h1 class="mt-6 font-display text-4xl leading-[1.08] text-white sm:text-5xl lg:text-6xl">
        {h.hero.h1}
      </h1>
      <p class="mt-7 max-w-xl text-[1.02rem] leading-relaxed text-white/85">{h.hero.sub}</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={l(SECTIONS.contact)} class="btn btn-white">
          {h.hero.ctaPrimary}
          <Icon name="arrow" size={15} />
        </a>
        <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn btn-gold">
          <Icon name="whatsapp" size={15} />
          {h.hero.ctaWhatsapp}
        </a>
      </div>
      <p class="mt-8 flex items-center gap-2.5 text-[0.85rem] text-white/70">
        <span class="flex items-center gap-0.5 text-gold" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={13} />)}
        </span>
        {h.hero.trust}
      </p>
    </div>
  </div>
</section>

<!-- 2. Three paths, presented as cards -->
<section id="paths" class="container-site py-16 md:py-24">
  <div class="max-w-2xl">
    <h2 class="font-display text-3xl md:text-4xl">{h.paths.heading}</h2>
    <span class="gold-rule mt-6"></span>
    <p class="mt-5 leading-relaxed">{h.paths.sub}</p>
  </div>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {paths.map((item) => (
      <a href={l(item.path)} class="card group flex flex-col bg-sand">
        <img src={item.image} alt={item.imageAlt} class="aspect-[16/10] w-full object-cover" width="800" height="500" loading="lazy" />
        <div class="flex flex-1 flex-col p-7">
          <h3 class="font-display text-2xl transition-colors group-hover:text-gold">{item.title}</h3>
          <p class="mt-2.5 flex-1 text-[0.94rem] leading-relaxed">{item.text}</p>
          <span class="link-editorial mt-6 self-start">{item.label}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- 3. Most requested services -->
<section class="border-y border-line-warm band-sand">
  <div class="container-site py-16 md:py-22">
    <div class="text-center">
      <h2 class="font-display text-3xl md:text-4xl">{h.mostRequested.heading}</h2>
      <p class="mt-4 text-[0.95rem] text-ink-soft">{h.mostRequested.sub}</p>
    </div>
    <div class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-3">
      {h.mostRequested.items.map((item) => (
        <a
          href={l(item.path)}
          class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-5 py-2.5 text-[0.85rem] font-medium text-navy transition-colors hover:border-gold hover:text-gold"
        >
          {item.label}
          <Icon name="arrow" size={14} class="text-gold" />
        </a>
      ))}
    </div>
  </div>
</section>

<!-- 4. Ports, harbours & offshore (dark band) -->
<section class="bg-navy">
  <div class="container-site py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow">{h.portBlock.eyebrow}</span>
      <h2 class="mt-4 font-display text-3xl text-white md:text-4xl">{h.portBlock.heading}</h2>
      {h.portBlock.text.map((p) => (
        <p class="mx-auto mt-5 leading-relaxed text-white/80">{p}</p>
      ))}
    </div>
    <img
      src="/images/europoort.jpg?v=20260731"
      alt="Container terminals in the port of Rotterdam"
      class="mt-12 aspect-[21/9] w-full rounded-3xl object-cover"
      width="1600"
      height="686"
      loading="lazy"
    />
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      {h.portBlock.areas.map((area) => (
        <div class="border-t border-gold/60 pt-5">
          <h3 class="font-display text-xl text-white">{area.title}</h3>
          <p class="mt-2 text-[0.92rem] leading-relaxed text-white/75">{area.text}</p>
        </div>
      ))}
    </div>
    <div class="mt-14 grid gap-x-12 gap-y-8 border-t border-white/15 pt-12 sm:grid-cols-2">
      {h.portBlock.advantages.map((adv) => (
        <div>
          <h3 class="font-display text-lg text-white">{adv.title}</h3>
          <p class="mt-1.5 text-[0.9rem] leading-relaxed text-white/70">{adv.text}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-center gap-3">
      {h.portBlock.links.map((link) => (
        <a href={l(link.path)} class="rounded-full border border-white/25 px-5 py-2.5 text-[0.8rem] tracking-[0.06em] text-white transition-colors hover:border-gold hover:text-gold-soft">
          {link.label}
        </a>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href={l(SECTIONS.industrial)} class="link-editorial link-editorial-light">{h.portBlock.label}</a>
    </div>
  </div>
</section>

<!-- 5. VIP band: full-bleed navy with photo backdrop and gold CTA -->
<section class="relative overflow-hidden bg-navy">
  <img
    src="/images/vip-welcome.jpg?v=20260731"
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-30"
    width="1600"
    height="1067"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/90 to-navy/50"></div>
  <div class="container-site relative py-16 md:py-24">
    <div class="max-w-2xl">
      <p class="flex items-center gap-3">
        <span class="h-px w-8 bg-gold" aria-hidden="true"></span>
        <span class="eyebrow">{h.vipBlock.eyebrow}</span>
      </p>
      <h2 class="mt-4 font-display text-3xl text-white md:text-4xl">{h.vipBlock.heading}</h2>
      {h.vipBlock.text.map((p) => (
        <p class="mt-5 text-[0.97rem] leading-relaxed text-white/80">{p}</p>
      ))}
      <a href={l(SECTIONS.vip)} class="btn btn-gold-fill mt-9">
        {h.vipBlock.label}
        <Icon name="arrow" size={15} />
      </a>
    </div>
  </div>
</section>

<!-- 6. Family relocation -->
<section class="border-y border-line-warm band-sand">
  <div class="container-site py-16 md:py-24">
    <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <span class="eyebrow eyebrow-navy">{h.familyBlock.eyebrow}</span>
        <h2 class="mt-4 font-display text-3xl md:text-4xl">{h.familyBlock.heading}</h2>
        {h.familyBlock.text.map((p) => (
          <p class="mt-5 text-[0.97rem] leading-relaxed">{p}</p>
        ))}
        <div class="mt-6 flex flex-wrap gap-2.5">
          {h.familyBlock.links.map((link) => (
            <a href={l(link.path)} class="rounded-full border border-line bg-white px-4 py-2 text-[0.78rem] text-navy transition-colors hover:border-gold hover:text-gold">
              {link.label}
            </a>
          ))}
        </div>
        <a href={l(h.familyBlock.path)} class="link-editorial mt-7">{h.familyBlock.label}</a>
      </div>
      <img src={h.familyBlock.image} alt={h.familyBlock.imageAlt} class="aspect-[4/3] w-full rounded-3xl object-cover" width="800" height="600" loading="lazy" />
    </div>
  </div>
</section>

<!-- 7. Immigration -->
<section class="container-site py-16 md:py-24">
  <div class="mx-auto max-w-3xl text-center">
    <span class="eyebrow eyebrow-navy">{h.immigrationBlock.eyebrow}</span>
    <h2 class="mt-4 font-display text-3xl md:text-4xl">{h.immigrationBlock.heading}</h2>
    {h.immigrationBlock.text.map((p) => (
      <p class="mx-auto mt-5 max-w-2xl leading-relaxed">{p}</p>
    ))}
  </div>
  <div class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-3">
    {h.immigrationBlock.links.map((link) => (
      <a
        href={l(link.path)}
        class="rounded-full border border-line px-5 py-2.5 text-[0.85rem] font-medium text-navy transition-colors hover:border-gold hover:text-gold"
      >
        {link.label}
      </a>
    ))}
  </div>
  <div class="mt-9 text-center">
    <a href={l(SECTIONS.immigration)} class="link-editorial">{h.immigrationBlock.label}</a>
  </div>
</section>

<!-- 8. Housing: image band with overlay card -->
<section class="relative">
  <img
    src="/images/canal-colour.jpg"
    alt=""
    class="h-105 w-full object-cover md:h-130"
    width="1600"
    height="1067"
    loading="lazy"
  />
  <div class="container-site">
    <div class="relative z-10 -mt-28 max-w-xl rounded-3xl bg-white p-8 shadow-lift md:-mt-36 md:p-12">
      <span class="eyebrow eyebrow-navy">{h.housingBlock.eyebrow}</span>
      <h2 class="mt-3 font-display text-3xl">{h.housingBlock.heading}</h2>
      {h.housingBlock.text.map((p) => (
        <p class="mt-4 text-[0.95rem] leading-relaxed">{p}</p>
      ))}
      <div class="mt-6 flex flex-wrap gap-2.5">
        {h.housingBlock.links.map((link) => (
          <a href={l(link.path)} class="rounded-full border border-line px-4 py-2 text-[0.78rem] text-navy transition-colors hover:border-gold hover:text-gold">
            {link.label}
          </a>
        ))}
      </div>
      <a href={l(SECTIONS.housing)} class="link-editorial mt-7">{h.housingBlock.label}</a>
    </div>
  </div>
</section>

<!-- 9. Business -->
<section class="container-site py-16 md:py-24">
  <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-2 md:gap-16">
    <div>
      <span class="eyebrow eyebrow-navy">{h.businessBlock.eyebrow}</span>
      <h2 class="mt-4 font-display text-3xl md:text-4xl">{h.businessBlock.heading}</h2>
      {h.businessBlock.text.map((p) => (
        <p class="mt-5 leading-relaxed">{p}</p>
      ))}
      <a href={l(SECTIONS.business)} class="link-editorial mt-7">{h.businessBlock.label}</a>
    </div>
    <img src="/images/business-plan.jpg" alt="" class="aspect-[4/3] w-full rounded-3xl object-cover" width="800" height="600" loading="lazy" />
  </div>
</section>

<!-- 10. Life here: a full-bleed photo strip, static, no captions -->
<section aria-hidden="true" class="grid grid-cols-2 md:grid-cols-4">
  {[
    { src: '/images/cyclist-canal.jpg', alt: '' },
    { src: '/images/tulips-canal.jpg', alt: '' },
    { src: '/images/family-arrival.jpg?v=20260731', alt: '' },
    { src: '/images/couple-moving-in.jpg?v=20260731', alt: '' },
  ].map((img) => (
    <img
      src={img.src}
      alt={img.alt}
      class="aspect-4/3 w-full object-cover md:aspect-square"
      width="800"
      height="600"
      loading="lazy"
    />
  ))}
</section>

<!-- 11. Why boutique (dark band) -->
<section class="bg-navy">
  <div class="container-site py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <span class="eyebrow">{h.whyBoutique.eyebrow}</span>
      <h2 class="mt-4 font-display text-3xl text-white md:text-4xl">{h.whyBoutique.heading}</h2>
      {h.whyBoutique.text.map((p) => (
        <p class="mx-auto mt-5 leading-relaxed text-white/75">{p}</p>
      ))}
    </div>
    <div class="mx-auto mt-12 grid max-w-4xl gap-x-14 gap-y-10 sm:grid-cols-2">
      {h.whyBoutique.points.map((point) => (
        <div>
          <h3 class="font-display text-xl text-white">{point.title}</h3>
          <p class="mt-2 text-[0.94rem] leading-relaxed text-white/70">{point.text}</p>
        </div>
      ))}
    </div>
    <div class="mx-auto mt-14 grid max-w-3xl grid-cols-3 border-y border-white/15 py-8 text-center">
      {h.whyBoutique.stats.map((stat) => (
        <div>
          <p class="font-display text-3xl text-gold-soft md:text-4xl">{stat.value}</p>
          <p class="mt-1.5 text-[0.72rem] uppercase tracking-[0.14em] text-white/60">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 11. Reviews: star-led cards -->
<section class="border-y border-line-warm band-sand">
  <div class="container-site py-16 md:py-24">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <span class="eyebrow eyebrow-navy">{h.reviews.eyebrow}</span>
        <h2 class="mt-4 font-display text-3xl md:text-4xl">{h.reviews.heading}</h2>
      </div>
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1 text-gold" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} />)}
        </span>
        <p class="text-[0.9rem] text-ink-soft">{h.reviews.sub}</p>
      </div>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {h.reviews.items.map((review) => (
        <figure class="card flex h-full flex-col bg-white p-7 md:p-8">
          <div class="flex items-center gap-1 text-gold" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
          </div>
          <blockquote class="mt-5 flex-1 font-display text-xl leading-relaxed text-navy">“{review.quote}”</blockquote>
          <figcaption class="mt-6 border-t border-line pt-4">
            <p class="font-medium text-navy">{review.name}</p>
            <p class="mt-0.5 text-[0.85rem] text-ink-soft">{review.route}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- 12. WhatsApp CTA -->
<section class="bg-navy">
  <div class="container-site py-16 text-center md:py-20">
    <span class="gold-rule mx-auto"></span>
    <h2 class="mx-auto mt-6 max-w-2xl font-display text-3xl text-white md:text-4xl">{h.whatsappCta.heading}</h2>
    <p class="mx-auto mt-4 max-w-xl leading-relaxed text-white/70">{h.whatsappCta.text}</p>
    <a href={site.whatsappUrl} target="_blank" rel="noopener" class="btn btn-whatsapp mt-9">
      <Icon name="whatsapp" size={16} />
      {h.whatsappCta.label}
    </a>
  </div>
</section>

<!-- 13. Contact form: details left, form right -->
<section class="border-t border-line-warm band-sand" id="contact-form">
  <div class="container-site py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div>
        <span class="eyebrow eyebrow-navy">{h.contactBlock.eyebrow}</span>
        <h2 class="mt-4 font-display text-3xl md:text-4xl">{h.contactBlock.heading}</h2>
        <p class="mt-4 max-w-md text-[0.95rem] leading-relaxed text-ink-soft">{h.contactBlock.text}</p>
        <div class="mt-10 space-y-5">
          <a href={`tel:${site.phone.e164}`} class="group flex items-center gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold">
              <Icon name="phone" size={18} />
            </span>
            <span class="font-medium text-navy transition-colors group-hover:text-gold">{site.phone.display}</span>
          </a>
          <a href={`mailto:${site.email}`} class="group flex items-center gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold">
              <Icon name="mail" size={18} />
            </span>
            <span class="font-medium text-navy transition-colors group-hover:text-gold">{site.email}</span>
          </a>
          <a href={site.whatsappUrl} target="_blank" rel="noopener" class="group flex items-center gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold">
              <Icon name="whatsapp" size={18} />
            </span>
            <span class="font-medium text-navy transition-colors group-hover:text-gold">{site.whatsapp.display}</span>
          </a>
        </div>
      </div>
      <div>
        <LeadForm lang={lang} kind="relocation" id="lead-home" />
      </div>
    </div>
  </div>
</section>

<script>
  // Crossfade the hero poster overlay away once the video is actually playing.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const overlay = document.getElementById('hero-poster-overlay');
  const fadeOut = () => overlay?.classList.add('opacity-0');
  if (video && overlay) {
    if (!video.paused && video.currentTime > 0.05 && video.readyState >= 3) {
      fadeOut();
    } else {
      video.addEventListener('playing', fadeOut, { once: true });
    }
  }
</script>
