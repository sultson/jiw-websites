---
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import PageHero from './PageHero.astro';
import { type Lang } from '../lib/i18n';
import { getContent } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const a = c.core.about;
const reviews = c.core.home.reviews;
/* Johanna's story in her own words: the first section sits beside her portrait,
   the rest alternate bands, with her quote on navy halfway through. */
const [first, ...rest] = a.sections;
const before = rest.slice(0, 1);
const after = rest.slice(1);
---

<PageHero
  eyebrow={a.eyebrow}
  title={a.title}
  image="/images/cyclist-canal.jpg"
  imageAlt="Cyclist beside a colourful canal in a Dutch city"
/>

<!-- Portrait + the opening of her story -->
<section class="container-site py-16 md:py-24">
  <div class="mx-auto grid max-w-5xl gap-12 md:grid-cols-[2fr_3fr] md:gap-16">
    <img src={a.image} alt={a.imageAlt} class="aspect-[3/4] w-full rounded-3xl object-cover shadow-card md:sticky md:top-36 md:self-start" width="896" height="1200" loading="eager" fetchpriority="high" />
    <div>
      {a.intro.map((p) => (
        <p class="mt-5 text-[1.05rem] leading-relaxed first:mt-0">{p}</p>
      ))}
      {first && (
        <>
          <h2 class="mt-12 font-display text-2xl md:text-3xl">{first.heading}</h2>
          <span class="gold-rule mt-5"></span>
          {first.text.map((p) => (
            <p class="mt-4 leading-relaxed">{p}</p>
          ))}
        </>
      )}
    </div>
  </div>
</section>

{before.map((section) => (
  <section class="band-champagne border-y border-line-warm">
    <div class="container-site py-16 md:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-3xl md:text-4xl">{section.heading}</h2>
        <span class="gold-rule mt-6"></span>
        {section.text.map((p) => (
          <p class="mt-5 leading-relaxed">{p}</p>
        ))}
      </div>
    </div>
  </section>
))}

<!-- Her quote -->
<section class="bg-navy">
  <div class="container-site py-16 text-center md:py-20">
    <span class="gold-rule mx-auto"></span>
    <blockquote class="mx-auto mt-8 max-w-3xl font-display text-2xl italic leading-snug text-white md:text-4xl">“{a.quote}”</blockquote>
    <p class="mt-6 text-[0.72rem] uppercase tracking-[0.3em] text-gold-soft">Johanna</p>
  </div>
</section>

{after.map((section, i) => (
  <section class:list={['border-b border-line-warm', i % 2 === 1 && 'band-champagne']}>
    <div class="container-site py-16 md:py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-3xl md:text-4xl">{section.heading}</h2>
        <span class="gold-rule mt-6"></span>
        {section.text.map((p) => (
          <p class="mt-5 leading-relaxed">{p}</p>
        ))}
      </div>
    </div>
  </section>
))}

<!-- Reviews -->
<section class="border-t border-line-warm band-sand">
  <div class="container-site py-16 md:py-24">
    <div class="text-center">
      <h2 class="font-display text-3xl md:text-4xl">{a.reviews.heading}</h2>
      <p class="mt-4 text-[0.95rem] text-ink-soft">{a.reviews.sub}</p>
    </div>
    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      {reviews.items.map((review) => (
        <figure class="card flex h-full flex-col bg-white p-7 md:p-8">
          <div class="flex items-center gap-1 text-gold" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
          </div>
          <blockquote class="mt-5 flex-1 font-display text-xl leading-relaxed text-navy">“{review.quote}”</blockquote>
          <figcaption class="mt-6 border-t border-line pt-4">
            <p class="font-medium text-navy">{review.name}</p>
            <p class="mt-0.5 text-[0.85rem] text-ink-soft">{review.route}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<CtaBand lang={lang} cta={a.cta} />
