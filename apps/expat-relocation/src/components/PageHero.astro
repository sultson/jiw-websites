---
/**
 * Every inner page opens on colour: a full-bleed photograph under a navy
 * scrim, not a white sheet. Without an image it falls back to a navy band so
 * the top of the page still carries weight.
 */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string[];
  image?: string;
  imageAlt?: string;
  /** Optional chips under the intro (sibling services, quick links). */
  links?: { label: string; path: string }[];
}
const { eyebrow, title, intro = [], image, imageAlt = '', links = [] } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy">
  {image && (
    <img
      src={image}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="photo-scrim"></div>
  <div class="container-site relative py-20 md:py-28">
    <div class="max-w-3xl">
      {eyebrow && (
        <p class="flex items-center gap-3">
          <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
          <span class="eyebrow">{eyebrow}</span>
        </p>
      )}
      <h1 class="mt-5 font-display text-4xl leading-[1.1] text-white md:text-5xl">{title}</h1>
      {intro.map((p) => (
        <p class="mt-5 max-w-2xl text-[1.02rem] leading-relaxed text-white/85">{p}</p>
      ))}
      {links.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2.5">
          {links.map((link) => (
            <a
              href={link.path}
              class="rounded-full border border-white/25 px-4 py-2 text-[0.78rem] tracking-[0.06em] text-white/90 transition-colors hover:border-gold hover:text-gold-soft"
            >
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
