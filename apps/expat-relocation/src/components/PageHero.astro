---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string[];
  image?: string;
  imageAlt?: string;
}
const { eyebrow, title, intro = [], image, imageAlt = '' } = Astro.props;
---

<section class="border-b border-line bg-ivory">
  <div class="container-site py-14 text-center md:py-20">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="mx-auto mt-4 max-w-3xl font-display text-4xl md:text-5xl">{title}</h1>
    <span class="gold-rule mx-auto mt-7"></span>
    {intro.map((p) => (
      <p class="mx-auto mt-5 max-w-2xl text-[1.02rem] leading-relaxed">{p}</p>
    ))}
  </div>
  {image && (
    <div class="container-site pb-0">
      <img
        src={image}
        alt={imageAlt}
        class="aspect-[5/2] w-full translate-y-14 object-cover shadow-card md:translate-y-20"
        width="1600"
        height="640"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}
</section>
{image && <div class="h-14 md:h-20"></div>}
