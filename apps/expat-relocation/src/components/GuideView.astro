---
import CtaBand from './CtaBand.astro';
import type { GuideContent } from '../content/types';
import { SECTIONS, localizePath, type Lang } from '../lib/i18n';
import { getContent } from '../lib/content';

interface Props {
  lang: Lang;
  guide: GuideContent;
  siblings: { label: string; path: string }[];
}
const { lang, guide: g, siblings } = Astro.props;
const c = getContent(lang);
const l = (p: string) => localizePath(p, lang);
---

<section class="border-b border-line bg-ivory">
  <div class="container-site py-14 text-center md:py-20">
    <span class="eyebrow">{g.eyebrow}</span>
    <h1 class="mx-auto mt-4 max-w-3xl font-display text-4xl md:text-5xl">{g.title}</h1>
    <span class="gold-rule mx-auto mt-7"></span>
  </div>
</section>

<article class="container-site py-14 md:py-20">
  <div class="mx-auto max-w-2xl">
    {g.intro.map((p) => (
      <p class="mt-5 text-[1.05rem] leading-relaxed first:mt-0">{p}</p>
    ))}
    {g.sections.map((section) => (
      <section class="mt-12">
        <h2 class="font-display text-2xl md:text-3xl">{section.heading}</h2>
        {section.paragraphs.map((p) => (
          <p class="mt-4 leading-relaxed">{p}</p>
        ))}
        {section.bullets && (
          <ul class="mt-5 space-y-2.5 border-l-2 border-gold pl-6">
            {section.bullets.map((b) => (
              <li class="text-[0.95rem] leading-relaxed">{b}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</article>

<CtaBand lang={lang} cta={g.cta} />

<section class="container-site py-14 md:py-18">
  <p class="eyebrow eyebrow-navy text-center">{c.core.ui.misc.relatedGuides}</p>
  <div class="mx-auto mt-7 flex max-w-4xl flex-wrap justify-center gap-3">
    {siblings.map((sib) => (
      <a
        href={l(sib.path)}
        class="rounded-full border border-line px-5 py-2.5 text-[0.8rem] tracking-[0.06em] text-navy transition-colors hover:border-gold hover:text-gold"
      >
        {sib.label}
      </a>
    ))}
    <a href={l(SECTIONS.guides)} class="border border-navy bg-navy px-5 py-2.5 text-[0.8rem] tracking-[0.06em] text-white transition-colors hover:bg-navy-2">
      {c.core.ui.cta.allServices}
    </a>
  </div>
</section>
