---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import WhatsAppFloat from './WhatsAppFloat.astro';
import { site } from '../data/site';
import {
  LANGS,
  BANNER_STRINGS,
  CONSENT_STRINGS,
  DEFAULT_LANG,
  localizePath,
  type Lang,
} from '../lib/i18n';
import { OG_LOCALES } from '../lib/i18n';
import { absoluteUrl, orgJsonLd, websiteJsonLd } from '../lib/seo';
import { getContent } from '../lib/content';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Canonical English path of this page (no language prefix). */
  path: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: unknown[];
  /** Limit hreflang and language switching when a page is not yet translated everywhere. */
  availableLangs?: readonly Lang[];
}
const { title, description, lang, path, image = '/images/og.jpg', noindex = false, jsonLd = [], availableLangs = LANGS } = Astro.props;

const c = getContent(lang);
const consent = CONSENT_STRINGS[lang];
const canonical = absoluteUrl(localizePath(path, lang));
const ogImage = absoluteUrl(image);
// Meta titles are authored per page. Appending a second full-length brand suffix
// made already descriptive titles repetitive and much more likely to be rewritten.
const fullTitle = title;

// Map of lang → localized URL for hreflang + the banner script.
const altUrls = Object.fromEntries(availableLangs.map((l) => [l, absoluteUrl(localizePath(path, l))]));
---

<!doctype html>
<html lang={lang} class="scroll-pt-32">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {availableLangs.map((l) => <link rel="alternate" hreflang={l} href={altUrls[l]} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizePath(path, DEFAULT_LANG))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#00143a" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd())} />
    {lang === DEFAULT_LANG && path === '/' && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd())} />
    )}
    {jsonLd.map((block) => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "ytxck0mceg");
      // Clarity enforces a consent signal for EEA/UK/CH visitors. Without one it
      // sets no cookies (_clck/_clsk), so every page view is recorded as a new
      // user + session. Replay a stored choice on every page load; calls are
      // queued until the tag loads.
      try {
        var eiConsent = localStorage.getItem('ei-consent');
        if (eiConsent === 'granted' || eiConsent === 'denied') {
          window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: eiConsent });
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:bg-navy focus:px-5 focus:py-2.5 focus:text-white"
    >
      {c.core.ui.skipToContent}
    </a>

    <!-- Polite language suggestion (H&M-style). Filled by the inline script;
         never an automatic redirect. -->
    <div
      id="lang-banner"
      class="hidden items-center justify-center gap-x-5 gap-y-2 flex-wrap border-b border-line bg-ivory px-4 py-2.5 text-[0.8rem] text-navy"
      data-langs={JSON.stringify(altUrls)}
      data-current={lang}
    >
      <span id="lang-banner-text"></span>
      <a id="lang-banner-switch" href="#" class="font-medium underline decoration-gold underline-offset-4"></a>
      <button id="lang-banner-dismiss" type="button" class="cursor-pointer text-ink-soft hover:text-navy"></button>
    </div>

    <Header lang={lang} path={path} availableLangs={availableLangs} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} />

    <!-- Analytics consent notice: small, bottom-left, shown once until a choice
         is made. Accept grants Clarity analytics storage (cookies), so sessions
         are stitched across page views. -->
    <div
      id="consent-bar"
      role="region"
      aria-label={consent.more}
      class="fixed inset-x-3 bottom-3 z-50 hidden max-w-md flex-col gap-3 border border-line bg-paper p-4 text-[0.8rem] leading-relaxed text-ink shadow-lift md:inset-x-auto md:left-6 md:bottom-6"
    >
      <p>
        {consent.text}{' '}
        <a href={localizePath('/privacy-policy', lang)} class="underline decoration-gold underline-offset-4 text-navy">{consent.more}</a>
      </p>
      <div class="flex gap-3">
        <button type="button" data-consent="granted" class="cursor-pointer bg-navy px-4 py-2 font-medium text-white hover:bg-navy-2">{consent.accept}</button>
        <button type="button" data-consent="denied" class="cursor-pointer border border-line px-4 py-2 text-navy hover:border-navy">{consent.decline}</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var bar = document.getElementById('consent-bar');
        if (!bar) return;
        var stored = null;
        try { stored = localStorage.getItem('ei-consent'); } catch (e) {}
        if (stored === 'granted' || stored === 'denied') return;
        bar.classList.remove('hidden');
        bar.classList.add('flex');
        bar.addEventListener('click', function (ev) {
          var btn = ev.target.closest && ev.target.closest('[data-consent]');
          if (!btn) return;
          var choice = btn.getAttribute('data-consent');
          try { localStorage.setItem('ei-consent', choice); } catch (e) {}
          if (window.clarity) window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: choice });
          bar.style.display = 'none';
        });
      })();
    </script>

    <script is:inline define:vars={{ BANNER_STRINGS }}>
      // Language suggestion banner. Uses the browser language, remembers the
      // visitor's decision, and never redirects automatically.
      (function () {
        var banner = document.getElementById('lang-banner');
        if (!banner) return;
        try {
          var stored = localStorage.getItem('ei-lang');
          var current = banner.dataset.current;
          var urls = JSON.parse(banner.dataset.langs || '{}');
          if (stored === 'dismissed' || stored === current) return;
          var supported = Object.keys(urls);
          var candidates = (navigator.languages || [navigator.language || 'en']).map(function (l) {
            return String(l).slice(0, 2).toLowerCase();
          });
          var best = null;
          for (var i = 0; i < candidates.length; i++) {
            if (supported.indexOf(candidates[i]) !== -1) {
              best = candidates[i];
              break;
            }
          }
          if (!best || best === current) return;
          if (stored && stored !== best) return;
          var strings = BANNER_STRINGS[best];
          if (!strings) return;
          document.getElementById('lang-banner-text').textContent = strings.prompt;
          var sw = document.getElementById('lang-banner-switch');
          sw.textContent = strings.switch;
          sw.href = urls[best];
          sw.addEventListener('click', function () {
            try { localStorage.setItem('ei-lang', best); } catch (e) {}
          });
          var dis = document.getElementById('lang-banner-dismiss');
          dis.textContent = strings.dismiss;
          dis.addEventListener('click', function () {
            try { localStorage.setItem('ei-lang', 'dismissed'); } catch (e) {}
            banner.style.display = 'none';
          });
          banner.classList.remove('hidden');
          banner.classList.add('flex');
        } catch (e) {}
      })();
    </script>
  </body>
</html>
