---
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import { SECTIONS, localizePath, type Lang } from '../lib/i18n';
import { getContent } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const v = c.vip;
const l = (p: string) => localizePath(p, lang);
---

<!-- Full-bleed VIP hero -->
<section class="relative bg-navy">
  <img src={v.image} alt={v.imageAlt} class="absolute inset-0 h-full w-full object-cover opacity-45" width="1600" height="1067" loading="eager" fetchpriority="high" />
  <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/50 to-navy/20"></div>
  <div class="container-site relative flex min-h-[64vh] flex-col items-center justify-end pb-16 pt-40 text-center md:pb-20">
    <span class="eyebrow">{v.eyebrow}</span>
    <h1 class="mt-4 max-w-3xl font-display text-4xl text-white md:text-6xl">{v.title}</h1>
    <span class="gold-rule mx-auto mt-7"></span>
  </div>
</section>

<section class="container-site py-16 md:py-20">
  <div class="mx-auto max-w-3xl text-center">
    {v.intro.map((p) => (
      <p class="mt-5 text-[1.05rem] leading-relaxed first:mt-0">{p}</p>
    ))}
  </div>
</section>

<!-- Packages: card grid, the badged package highlighted in navy -->
<section class="container-site pb-16 md:pb-24">
  <div class="grid gap-7 md:grid-cols-2">
    {v.packages.map((p) => (
      <a
        href={l(`${SECTIONS.vip}/${p.slug}`)}
        class:list={[
          'card group flex h-full flex-col',
          p.badge ? 'border-navy bg-navy text-white' : 'bg-sand',
        ]}
      >
        <div class="relative overflow-hidden">
          <img
            src={p.image}
            alt={p.imageAlt}
            class="aspect-[16/9] w-full object-cover"
            width="800"
            height="450"
            loading="lazy"
          />
          {p.badge && (
            <span class="absolute left-4 top-4 rounded-full bg-gold px-3.5 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-navy">
              {p.badge}
            </span>
          )}
        </div>
        <div class="flex flex-1 flex-col p-7 md:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class:list={['font-display text-2xl', p.badge ? 'text-white' : 'text-navy']}>{p.name}</h2>
            <p class:list={['text-[0.78rem] uppercase tracking-[0.14em]', p.badge ? 'text-gold-soft' : 'text-gold']}>{p.investment}</p>
          </div>
          <p class:list={['mt-2 text-[0.92rem]', p.badge ? 'text-white/70' : 'text-ink-soft']}>{p.tagline}</p>
          <ul class="mt-5 flex-1 space-y-2">
            {p.included.items.slice(0, 4).map((item) => (
              <li class:list={['flex items-center gap-2.5 text-[0.9rem]', p.badge ? 'text-white/85' : 'text-ink']}>
                <Icon name="check" size={14} class:list={[p.badge ? 'shrink-0 text-gold-soft' : 'shrink-0 text-gold']} />
                {item.title}
              </li>
            ))}
          </ul>
          <span class:list={['link-editorial mt-7 self-start', p.badge && 'link-editorial-light']}>
            {c.core.ui.cta.readMore}
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- Pricing context -->
<section class="border-t border-line-warm band-sand">
  <div class="container-site py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center font-display text-3xl md:text-4xl">{v.pricingNote.title}</h2>
      <span class="gold-rule mx-auto mt-6"></span>
      {v.pricingNote.text.map((p) => (
        <p class="mt-6 text-[1.02rem] leading-relaxed">{p}</p>
      ))}
      <p class="mt-6 border-l-2 border-gold pl-6 text-[1.02rem] italic leading-relaxed">{v.tailored.text}</p>
    </div>
  </div>
</section>

<CtaBand lang={lang} cta={v.cta} />
