---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import type { PackageContent } from '../content/types';
import { SECTIONS, localizePath, type Lang } from '../lib/i18n';
import { getContent } from '../lib/content';

interface Props {
  lang: Lang;
  pkg: PackageContent;
  siblings: { label: string; path: string }[];
}
const { lang, pkg: p, siblings } = Astro.props;
const c = getContent(lang);
const l = (path: string) => localizePath(path, lang);
---

<!-- Full-bleed package hero -->
<section class="relative bg-navy">
  <img src={p.image} alt={p.imageAlt} class="absolute inset-0 h-full w-full object-cover opacity-40" width="1600" height="1067" loading="eager" fetchpriority="high" />
  <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/55 to-navy/25"></div>
  <div class="container-site relative flex min-h-[70vh] flex-col items-center justify-end pb-16 pt-40 text-center md:pb-20">
    <span class="eyebrow">{c.vip.eyebrow}</span>
    <h1 class="mt-4 max-w-3xl font-display text-4xl text-white md:text-6xl">{p.name}</h1>
    <p class="mt-4 font-display text-xl italic text-gold-soft md:text-2xl">{p.tagline}</p>
    <p class="mt-7 rounded-full border border-gold/50 px-6 py-2.5 text-[0.8rem] uppercase tracking-[0.2em] text-white">
      {p.priceFrom}
    </p>
  </div>
</section>

<section class="container-site py-16 md:py-24">
  <div class="mx-auto max-w-3xl text-center">
    {p.intro.map((para) => (
      <p class="mt-4 text-[1.05rem] leading-relaxed first:mt-0">{para}</p>
    ))}
    <p class="mx-auto mt-7 max-w-2xl border-t border-line pt-6 text-[0.95rem] italic leading-relaxed text-ink-soft">
      {c.vip.tailored.text}
    </p>
  </div>
</section>

<!-- Included -->
<section class="border-y border-line bg-ivory">
  <div class="container-site py-16 md:py-24">
    <h2 class="text-center font-display text-3xl md:text-4xl">{p.included.title}</h2>
    <span class="gold-rule mx-auto mt-6"></span>
    <div class="mx-auto mt-12 grid max-w-5xl gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {p.included.items.map((item) => (
        <div class="flex items-start gap-4">
          <span class="mt-1 shrink-0 text-gold"><Icon name="check" size={18} /></span>
          <div>
            <h3 class="font-medium text-navy">{item.title}</h3>
            <p class="mt-1 text-[0.88rem] leading-relaxed">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- For who + justification -->
<section class="container-site py-16 md:py-24">
  <div class="mx-auto grid max-w-5xl gap-14 md:grid-cols-2">
    <div>
      <h2 class="font-display text-3xl">{p.forWho.title}</h2>
      <ul class="mt-7 space-y-4">
        {p.forWho.items.map((item) => (
          <li class="flex items-start gap-3.5">
            <span class="mt-1.5 text-gold"><Icon name="check" size={16} /></span>
            <span class="text-[0.98rem] leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="border-l-2 border-gold pl-8">
      <h2 class="font-display text-3xl">{p.justification.title}</h2>
      {p.justification.text.map((para) => (
        <p class="mt-5 text-[0.98rem] leading-relaxed">{para}</p>
      ))}
    </div>
  </div>
</section>

<!-- Process -->
<section class="border-t border-line">
  <div class="container-site py-16 md:py-24">
    <h2 class="text-center font-display text-3xl md:text-4xl">{p.process.title}</h2>
    <span class="gold-rule mx-auto mt-6"></span>
    <ol class="mx-auto mt-12 grid max-w-5xl gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {p.process.steps.map((step, i) => (
        <li>
          <span class="font-display text-4xl text-gold">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 font-display text-lg">{step.title}</h3>
          <p class="mt-2 text-[0.9rem] leading-relaxed">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- FAQ -->
<section class="border-t border-line bg-ivory">
  <div class="container-site py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-3xl">{p.faq.title}</h2>
      <div class="mt-8 border-t border-line">
        {p.faq.items.map((item) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 font-medium text-navy [&::-webkit-details-marker]:hidden">
              <span class="text-[1.02rem]">{item.q}</span>
              <span class="shrink-0 text-gold transition-transform duration-200 group-open:rotate-180">
                <Icon name="chevronDown" size={18} />
              </span>
            </summary>
            <p class="pb-6 text-[0.95rem] leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- CTA + VIP form -->
<section class="border-t border-line" id="inquiry">
  <div class="container-site py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl md:text-4xl">{p.cta.title}</h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed">{p.cta.text}</p>
    </div>
    <div class="mx-auto mt-10 max-w-3xl">
      <LeadForm lang={lang} kind="vip" preselect={p.name} id={`lead-${p.slug}`} />
    </div>
  </div>
</section>

<!-- Other packages -->
<section class="border-t border-line bg-navy">
  <div class="container-site py-14 text-center md:py-16">
    <p class="eyebrow">{c.core.ui.misc.otherServices}</p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      {siblings.map((sib) => (
        <a
          href={l(sib.path)}
          class="rounded-full border border-white/25 px-5 py-2.5 text-[0.8rem] tracking-[0.06em] text-white transition-colors hover:border-gold hover:text-gold"
        >
          {sib.label}
        </a>
      ))}
      <a href={l(SECTIONS.vip)} class="rounded-full border border-gold bg-gold px-5 py-2.5 text-[0.8rem] tracking-[0.06em] text-navy transition-colors hover:bg-gold-soft">
        {c.core.ui.cta.allServices}
      </a>
    </div>
  </div>
</section>
