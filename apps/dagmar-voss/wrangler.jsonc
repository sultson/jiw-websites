{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dagmar-voss",
  "account_id": "aec64586d4d04a644f4f9b8225d7ca28",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  // worker.mjs doet de hosts: www -> apex, http -> https, en noindex op het
  // conceptadres. De acht paginas zelf komen uit dist/ via de assets-binding.
  "main": "worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Zonder dit draait de worker NIET voor een pad dat in dist/ ligt - assets
    // wint dan en levert het bestand zelf uit. De omleiding van www zou dus
    // nooit afgaan en www.dagmarvoss.nl gaf een gewone 200 met de hele site
    // erop. Zie de kop van worker.mjs en de root CLAUDE.md.
    "run_worker_first": true,
    // Een adres per pagina, met de slash: /coaching/. Dat is de vorm die de
    // canonical, de sitemap en elke interne link al gebruiken, dus /coaching
    // komt met een omleiding op de juiste terecht in plaats van er met een 200
    // naast te gaan staan. Cloudflare antwoordt met een 307 en niet met een
    // 301 - niemand linkt naar de vorm zonder slash, dus daar gaat geen kracht
    // door verloren.
    "html_handling": "force-trailing-slash",
    // Een onbekend pad krijgt dist/404.html *met* status 404, niet de
    // startpagina met een 200 - die tweede leest Google als een soft 404.
    "not_found_handling": "404-page"
  },
  // Het kale adres is de site; www leidt ernaartoe. Beide zijn als custom
  // domain aan deze worker gehangen op 10-10-2026.
  //
  // LET OP - de knip is nog niet gemaakt: de nameservers van dagmarvoss.nl
  // staan bij Antagonist (webhostingserver.g1-dns.one/.com) en de zone staat
  // in Cloudflare dus op `pending`. Deze twee routes bestaan, maar ze gaan pas
  // antwoorden als de nameservers naar dean/lindsey.ns.cloudflare.com wijzen.
  // Tot dan levert dagmarvoss.nl Dagmars eigen Carrd-site uit. Zie de README.
  "routes": [
    {
      "pattern": "dagmarvoss.nl",
      "custom_domain": true
    },
    {
      "pattern": "www.dagmarvoss.nl",
      "custom_domain": true
    },
    // Het conceptadres is met de klant gedeeld, dus het moet blijven
    // antwoorden. Het levert de site uit met noindex (worker.mjs), zodat er
    // niet twee indexeerbare kopieen naast elkaar staan.
    {
      "pattern": "dagmarvoss-concept.jouwidealewebsite.nl",
      "custom_domain": true
    }
  ]
}
