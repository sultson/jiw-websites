{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "netherlands-unveiled",
  "account_id": "aec64586d4d04a644f4f9b8225d7ca28",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker has to see page requests, not just the API, or the redirect
    // from www and the jouwidealewebsite subdomain to the canonical host never
    // runs. Images stay on the direct asset path so they skip the Worker.
    // _redirects cannot do this: it only accepts relative URLs.
    "run_worker_first": ["/*", "!/images/*", "!/favicon.svg"]
  },
  "routes": [
    {
      "pattern": "netherlandsunveiled.com/*",
      "zone_name": "netherlandsunveiled.com"
    },
    {
      "pattern": "www.netherlandsunveiled.com/*",
      "zone_name": "netherlandsunveiled.com"
    },
    {
      "pattern": "netherlandsunveiledtours.jouwidealewebsite.nl",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "FORM_UPLOADS",
      "bucket_name": "jiw-form-uploads-prod"
    }
  ],
  "send_email": [
    {
      "name": "LEAD_EMAIL",
      "allowed_sender_addresses": ["afspraak@notify.jouwidealewebsite.nl"]
    }
  ],
  "vars": {
    "SITE_ID": "netherlands-unveiled",
    "LEAD_RECIPIENT": "marion@netherlandsunveiled.com",
    "LEAD_SENDER": "afspraak@notify.jouwidealewebsite.nl",
    "TURNSTILE_SECRET_KEY": "dev"
  }
}
