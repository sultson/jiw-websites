---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | Netherlands Unveiled</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="section" style="min-height: 80vh; display: grid; align-content: center;">
      <p class="eyebrow">404</p>
      <h1 style="font-size: clamp(3rem, 10vw, 7rem);">Page not found</h1>
      <p class="lead" style="margin-top: 1rem;">The page you were looking for is not available.</p>
      <p style="margin-top: 2rem;"><a class="btn btn-primary" href="/">Back to Netherlands Unveiled</a></p>
    </main>
  </body>
</html>
