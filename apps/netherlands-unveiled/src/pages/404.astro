---
import Base from '../layouts/Base.astro';
import { routes } from '../i18n';

// Cloudflare serves this one file for every unmatched path in both languages,
// so it links to both home pages instead of picking one.
const alternates = { en: '/404', fr: '/404' };
---

<Base
  lang="en"
  title="Page not found | Netherlands Unveiled"
  description="The page you were looking for is not available."
  alternates={alternates}
  solidNav
  noindex
>
  <div class="page">
    <section class="section page-head" style="min-height: 60svh; align-content: center;">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">
        The page you were looking for is not available.
        <span lang="fr">La page que vous cherchiez n’est pas disponible.</span>
      </p>
      <p style="margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 0.75rem;">
        <a class="btn btn-primary" href={routes.home.en}>Back to Netherlands Unveiled</a>
        <a class="btn btn-ghost" href={routes.home.fr} lang="fr" hreflang="fr">Retour au site en français</a>
      </p>
    </section>
  </div>
</Base>
