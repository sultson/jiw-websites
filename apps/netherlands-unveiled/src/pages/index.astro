type Lang = keyof typeof content;

const defaultLang = 'en' satisfies Lang;
const t = content[defaultLang];
const languageOptionValues = Object.keys(t.form.languageOptions);
const tourOptionValues = Object.keys(t.form.tourOptions);
const contentJson = JSON.stringify(content).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta property="og:title" content="Netherlands Unveiled" />
    <meta property="og:description" content={t.meta.ogDescription} />
    <meta property="og:image" content="/images/hero.webp" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="site-shell">
      <header class="nav" id="nav">
        <div class="nav-inner">
          <a class="brand" href="#top" aria-label={t.nav.brandAria} data-i18n-attr="aria-label:nav.brandAria">
            <strong>Netherlands Unveiled</strong>
            <span data-i18n="nav.tagline">{t.nav.tagline}</span>
          </a>
          <div class="top-flags" aria-label={t.nav.guidingLanguages} data-i18n-attr="aria-label:nav.guidingLanguages">
            <span aria-label="English">🇺🇸</span>
            <span aria-label="Dutch">🇳🇱</span>
            <span aria-label="German">🇩🇪</span>
            <span aria-label="French">🇫🇷</span>
            <span aria-label="Spanish">🇪🇸</span>
            <span aria-label="Italian">🇮🇹</span>
          </div>
          <div class="lang-toggle" aria-label={t.nav.languageToggleLabel} data-i18n-attr="aria-label:nav.languageToggleLabel">
            <button class="lang-option is-active" type="button" data-lang-button="en" aria-pressed="true">EN</button>
            <button class="lang-option" type="button" data-lang-button="fr" aria-pressed="false">FR</button>
          </div>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-i18n="nav.menu">
            {t.nav.menu}
          </button>
          <nav class="nav-links" id="nav-links" aria-label={t.nav.aria} data-i18n-attr="aria-label:nav.aria">
            <a href="#tours" data-i18n="nav.tours">{t.nav.tours}</a>
            <a href="#about" data-i18n="nav.about">{t.nav.about}</a>
            <a href="#contact" data-i18n="nav.contact">{t.nav.contact}</a>
          </nav>
        </div>
      </header>

      <main id="top">
        <section class="hero" aria-label={t.hero.label} data-i18n-attr="aria-label:hero.label">
          <img src="/images/hero.webp" alt={t.hero.imageAlt} data-i18n-attr="alt:hero.imageAlt" />
          <div class="hero-content">
            <div class="hero-copy">
              <h1 data-i18n="hero.title">{t.hero.title}</h1>
              <p data-i18n="hero.copy">{t.hero.copy}</p>
              <div class="hero-actions">
                <a class="btn btn-primary" href="#contact" data-i18n="hero.primaryCta">{t.hero.primaryCta}</a>
                <a class="btn btn-ghost" href="#tours" data-i18n="hero.secondaryCta">{t.hero.secondaryCta}</a>
              </div>
            </div>
          </div>
          <div class="hero-facts" aria-label={t.hero.factsLabel} data-i18n-attr="aria-label:hero.factsLabel">
            {t.hero.facts.map((fact, index) => (
              <div class="fact">
                <strong data-i18n={`hero.facts.${index}.title`}>{fact.title}</strong>
                <span data-i18n={`hero.facts.${index}.copy`}>{fact.copy}</span>
              </div>
            ))}
          </div>
        </section>

        <section class="section first" id="tours">
          <div class="section-head">
            <h2 data-i18n="toursSection.title">{t.toursSection.title}</h2>
            <p data-i18n="toursSection.copy">{t.toursSection.copy}</p>
          </div>
          <div class="tour-grid">
            {t.tours.map((tour, index) => (
              <article class="tour-card">
                <div class="tour-media">
                  <img src={tour.image} alt={tour.alt} loading="lazy" data-i18n-attr={`alt:tours.${index}.alt`} />
                  {'highlightImage' in tour && (
                    <details class="tour-photo-popout" data-photo-popout data-photo-index={String(index)}>
                      <summary aria-label={tour.photoAria} data-i18n-attr={`aria-label:tours.${index}.photoAria`}>
                        <img src={tour.highlightImage} alt="" loading="lazy" />
                        <span data-photo-label>{tour.photoCta}</span>
                      </summary>
                      <div class="tour-photo-panel">
                        <img src={tour.highlightImage} alt={tour.highlightAlt} loading="lazy" data-i18n-attr={`alt:tours.${index}.highlightAlt`} />
                      </div>
                    </details>
                  )}
                </div>
                <div class="tour-body">
                  <h3 data-i18n={`tours.${index}.title`}>{tour.title}</h3>
                  <p data-i18n={`tours.${index}.copy`}>{tour.copy}</p>
                  <ul>
                    {tour.items.map((item, itemIndex) => (
                      <li data-i18n={`tours.${index}.items.${itemIndex}`}>{item}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="band" id="about">
          <div class="section split">
            <div>
              <p class="eyebrow" data-i18n="about.eyebrow">{t.about.eyebrow}</p>
              <h2 data-i18n="about.title">{t.about.title}</h2>
            </div>
            <div class="about-copy">
              {t.about.copy.map((paragraph, index) => (
                <p data-i18n={`about.copy.${index}`}>{paragraph}</p>
              ))}
              <div class="insight-note">
                <p data-i18n="about.note">{t.about.note}</p>
              </div>
            </div>
          </div>
        </section>

        <section class="section spring-section" aria-label={t.spring.label} data-i18n-attr="aria-label:spring.label">
          <article class="spring-card">
            <div class="spring-content">
              <p class="eyebrow" data-i18n="spring.eyebrow">{t.spring.eyebrow}</p>
              <h2 data-i18n="spring.title">{t.spring.title}</h2>
              {t.spring.copy.map((paragraph, index) => (
                <p data-i18n={`spring.copy.${index}`}>{paragraph}</p>
              ))}
            </div>
          </article>
        </section>

        <section class="section" id="contact">
          <div class="contact-wrap">
            <div class="contact-card">
              <p class="eyebrow" data-i18n="contact.eyebrow">{t.contact.eyebrow}</p>
              <h2 data-i18n="contact.title">{t.contact.title}</h2>
              <p data-i18n="contact.copy">{t.contact.copy}</p>
              <a class="btn btn-messenger" href={messengerUrl} target="_blank" rel="noopener" data-i18n="contact.messenger">
                {t.contact.messenger}
              </a>
            </div>

            <div class="form-card" id="contact-form">
              <div class="form-success" id="form-success" data-i18n="form.success">
                {t.form.success}
              </div>
              <form id="lead-form" data-form-path="/api/forms/contact" novalidate>
                <div class="form-grid">
                  <label>
                    <span data-i18n="form.firstName">{t.form.firstName}</span>
                    <input name="firstName" type="text" autocomplete="given-name" required />
                  </label>
                  <label>
                    <span data-i18n="form.lastName">{t.form.lastName}</span>
                    <input name="lastName" type="text" autocomplete="family-name" />
                  </label>
                  <label>
                    <span data-i18n="form.email">{t.form.email}</span>
                    <input name="email" type="email" autocomplete="email" required />
                  </label>
                  <label>
                    <span data-i18n="form.contactPreference">{t.form.contactPreference}</span>
                    <select name="contactPreference">
                      <option value="Email" data-i18n="form.emailOption">{t.form.emailOption}</option>
                      <option value="Messenger" data-i18n="form.messengerOption">{t.form.messengerOption}</option>
                    </select>
                  </label>
                  <label>
                    <span data-i18n="form.tourInterest">{t.form.tourInterest}</span>
                    <select name="tourInterest" required>
                      <option value="" data-i18n="form.chooseTour">{t.form.chooseTour}</option>
                      {tourOptionValues.map((option) => (
                        <option value={option} data-i18n={`form.tourOptions.${option}`}>
                          {t.form.tourOptions[option as keyof typeof t.form.tourOptions]}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label>
                    <span data-i18n="form.date">{t.form.date}</span>
                    <input name="travelDate" type="text" placeholder={t.form.datePlaceholder} required data-i18n-attr="placeholder:form.datePlaceholder" />
                  </label>
                  <label>
                    <span data-i18n="form.groupSize">{t.form.groupSize}</span>
                    <input name="groupSize" type="text" placeholder={t.form.groupSizePlaceholder} required data-i18n-attr="placeholder:form.groupSizePlaceholder" />
                  </label>
                  <label>
                    <span data-i18n="form.language">{t.form.language}</span>
                    <select name="language">
                      {languageOptionValues.map((option) => (
                        <option value={option} data-i18n={`form.languageOptions.${option}`}>
                          {t.form.languageOptions[option as keyof typeof t.form.languageOptions]}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label class="full">
                    <span data-i18n="form.message">{t.form.message}</span>
                    <textarea name="message" required placeholder={t.form.messagePlaceholder} data-i18n-attr="placeholder:form.messagePlaceholder"></textarea>
                  </label>
                </div>
                <input type="hidden" name="siteLanguage" value={t.form.siteLanguage} data-site-language />
                <input type="hidden" name="cf-turnstile-response" value="dev" />
                <input type="text" name="company" tabindex="-1" autocomplete="off" hidden aria-hidden="true" />
                <p class="form-error" id="form-error"></p>
                <div class="form-footer">
                  <button class="btn btn-primary" type="submit">
                    <span class="btn-label" data-i18n="form.submit">{t.form.submit}</span>
                  </button>
                  <p data-i18n="form.privacy">{t.form.privacy}</p>
                </div>
              </form>
            </div>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <span data-i18n="footer.brand">{t.footer.brand}</span>
          <span data-i18n="footer.copy">{t.footer.copy}</span>
        </div>
      </footer>
    </div>

    <script is:inline type="application/json" id="i18n-data" set:html={contentJson}></script>
    <script>
      const dataNode = document.getElementById('i18n-data');
      const translations: Record<string, unknown> = dataNode?.textContent ? JSON.parse(dataNode.textContent) : {};
      const defaultLang = 'en';
      const nav = document.getElementById('nav');
      const menuButton = document.querySelector('.menu-toggle');
      let currentLang: string = defaultLang;

      const getTranslation = (lang: string, key: string): string | undefined => {
        const parts = key.split('.');
        let value: unknown = translations[lang];

        for (const part of parts) {
          if (typeof value !== 'object' || value === null || !(part in value)) return undefined;
          value = (value as Record<string, unknown>)[part];
        }

        return typeof value === 'string' ? value : undefined;
      };

      const updatePhotoLabels = (lang: string) => {
        document.querySelectorAll('[data-photo-popout]').forEach((details) => {
          if (!(details instanceof HTMLDetailsElement)) return;

          const index = details.getAttribute('data-photo-index');
          const label = details.querySelector('[data-photo-label]');
          if (!index || !label) return;

          const key = details.open ? `tours.${index}.photoClose` : `tours.${index}.photoCta`;
          const value = getTranslation(lang, key);
          if (value) label.textContent = value;
        });
      };

      const applyLanguage = (lang: string) => {
        if (!translations[lang]) return;
        currentLang = lang;
        document.documentElement.lang = lang;
        document.title = getTranslation(lang, 'meta.title') ?? document.title;

        const description = document.querySelector('meta[name="description"]');
        const ogDescription = document.querySelector('meta[property="og:description"]');
        description?.setAttribute('content', getTranslation(lang, 'meta.description') ?? '');
        ogDescription?.setAttribute('content', getTranslation(lang, 'meta.ogDescription') ?? '');

        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const key = element.getAttribute('data-i18n');
          const value = key ? getTranslation(lang, key) : undefined;
          if (value) element.textContent = value;
        });

        document.querySelectorAll('[data-i18n-attr]').forEach((element) => {
          const entries = element.getAttribute('data-i18n-attr')?.split('|') ?? [];
          entries.forEach((entry) => {
            const [attribute, key] = entry.split(':');
            const value = key ? getTranslation(lang, key) : undefined;
            if (attribute && value) element.setAttribute(attribute, value);
          });
        });

        document.querySelectorAll('[data-lang-button]').forEach((button) => {
          const isActive = button.getAttribute('data-lang-button') === lang;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });

        const siteLanguage = document.querySelector('[data-site-language]');
        if (siteLanguage instanceof HTMLInputElement) {
          siteLanguage.value = getTranslation(lang, 'form.siteLanguage') ?? lang;
        }

        updatePhotoLabels(lang);

        try {
          window.localStorage.setItem('netherlands-unveiled-lang', lang);
        } catch {
          // Ignore storage failures; the toggle still works for the current page.
        }
      };

      menuButton?.addEventListener('click', () => {
        const next = nav?.dataset.open !== 'true';
        if (nav) nav.dataset.open = String(next);
        menuButton.setAttribute('aria-expanded', String(next));
      });

      document.querySelectorAll('.nav-links a').forEach((link) => {
        link.addEventListener('click', () => {
          if (nav) nav.dataset.open = 'false';
          menuButton?.setAttribute('aria-expanded', 'false');
        });
      });

      document.querySelectorAll('[data-lang-button]').forEach((button) => {
        button.addEventListener('click', () => {
          const lang = button.getAttribute('data-lang-button');
          if (lang) applyLanguage(lang);
        });
      });

      document.querySelectorAll('[data-photo-popout]').forEach((details) => {
        details.addEventListener('toggle', () => updatePhotoLabels(currentLang));
      });

      try {
        const storedLang = window.localStorage.getItem('netherlands-unveiled-lang');
        if (storedLang && translations[storedLang]) applyLanguage(storedLang);
      } catch {
        applyLanguage(defaultLang);
      }

      const form = document.getElementById('lead-form');
      const success = document.getElementById('form-success');
      const errorBox = document.getElementById('form-error');

      if (form instanceof HTMLFormElement) {
        const submit = form.querySelector('button[type="submit"]');
        const label = form.querySelector('.btn-label');

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (errorBox) errorBox.style.display = 'none';

          const honeypot = form.elements.namedItem('company');
          if (honeypot instanceof HTMLInputElement && honeypot.value) return;

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          submit?.setAttribute('disabled', 'true');
          if (label) label.textContent = getTranslation(currentLang, 'form.submitting') ?? 'Sending...';

          try {
            const path = form.dataset.formPath ?? '/api/forms/contact';
            const response = await fetch(path, { method: 'POST', body: new FormData(form) });
            const data = await response.json().catch(() => ({}));
            const payload = data && typeof data === 'object' ? data : {};
            if (!response.ok || !('ok' in payload) || !payload.ok) {
              const message = 'message' in payload && typeof payload.message === 'string'
                ? payload.message
                : getTranslation(currentLang, 'form.errorDefault') ?? 'Your request could not be sent.';
              throw new Error(message);
            }
            form.style.display = 'none';
            if (success) success.style.display = 'block';
          } catch (error) {
            if (errorBox) {
              errorBox.textContent = error instanceof Error
                ? error.message
                : getTranslation(currentLang, 'form.errorDefault') ?? 'Your request could not be sent.';
              errorBox.style.display = 'block';
            }
            submit?.removeAttribute('disabled');
            if (label) label.textContent = getTranslation(currentLang, 'form.submit') ?? 'Send tour request';
          }
        });
      }
    </script>
  </body>
</html>
