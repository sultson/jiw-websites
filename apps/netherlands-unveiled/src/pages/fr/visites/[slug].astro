---
import TourPage from '../../../components/TourPage.astro';
import { tours } from '../../../content/tours';

export function getStaticPaths() {
  return tours.map((tour) => ({ params: { slug: tour.fr.slug }, props: { tour } }));
}

const { tour } = Astro.props;
---

<TourPage lang="fr" tour={tour} />
