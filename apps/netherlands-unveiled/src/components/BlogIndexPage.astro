---
import Base from '../layouts/Base.astro';
import { blogIndex } from '../content/site';
import { posts } from '../content/blog';
import { absoluteUrl, homeAnchor, localeTag, postPath, routeAlternates, routes, SITE_URL, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = blogIndex[lang];
const alternates = routeAlternates('blog');

const BLOG_WIDTHS = [360, 540, 720];
const blogSrcset = (name: string) =>
  BLOG_WIDTHS.map((width) => `/images/${name}-${width}.webp ${width}w`).join(', ');
const BLOG_SIZES = '(min-width: 1192px) 376px, (min-width: 981px) 31vw, calc(100vw - 32px)';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${absoluteUrl(alternates[lang])}#blog`,
    name: t.page.title,
    description: t.meta.description,
    url: absoluteUrl(alternates[lang]),
    inLanguage: localeTag[lang],
    publisher: { '@id': `${SITE_URL}/#business` },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post[lang].title,
      description: post[lang].excerpt,
      url: absoluteUrl(postPath(lang, post[lang].slug)),
      image: absoluteUrl(`/images/${post.image}-720.webp`),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Netherlands Unveiled', item: absoluteUrl(routes.home[lang]) },
      { '@type': 'ListItem', position: 2, name: t.page.eyebrow, item: absoluteUrl(alternates[lang]) },
    ],
  },
];
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  alternates={alternates}
  active="blog"
  solidNav
  schema={schema}
>
  <div class="page">
    <section class="section page-head">
      <p class="eyebrow">{t.page.eyebrow}</p>
      <h1>{t.page.title}</h1>
      <p class="lead">{t.page.lead}</p>
    </section>

    <section class="section blog-section">
      <div class="blog-grid">
        {posts.map((post) => {
          const copy = post[lang];
          return (
            <article class="blog-card">
              <a class="blog-card-link" href={postPath(lang, copy.slug)}>
                <img
                  src={`/images/${post.image}-540.webp`}
                  srcset={blogSrcset(post.image)}
                  sizes={BLOG_SIZES}
                  width="720"
                  height="900"
                  alt={copy.alt}
                  loading="lazy"
                  decoding="async"
                />
                <div class="blog-body">
                  <p class="blog-topic">{copy.topic}</p>
                  <h2>{copy.title}</h2>
                  <p>{copy.excerpt}</p>
                  <span class="text-link">{t.page.readMore}</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </section>

    <section class="section page-cta">
      <a class="btn btn-primary" href={homeAnchor(lang, '#contact')}>{t.page.cta}</a>
    </section>
  </div>
</Base>
