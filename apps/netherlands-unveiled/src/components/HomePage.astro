---
import Base from '../layouts/Base.astro';
import ContactForm from './ContactForm.astro';
import VideoEmbed from './VideoEmbed.astro';
import { home, toursIndex } from '../content/site';
import { posts } from '../content/blog';
import { tours } from '../content/tours';
import {
  absoluteUrl,
  localeTag,
  postPath,
  routeAlternates,
  routes,
  SITE_URL,
  tourPath,
  type Lang,
} from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const alternates = routeAlternates('home');

const messengerUrl = 'https://m.me/100075943650762';
const VIDEO_ID = '631831905';

// The spring section is the strongest page on the site for Keukenhof searches,
// so it links straight through to the article on the same subject.
const keukenhofPost = posts.find((post) => post.id === 'keukenhof');

// Home cards and tour pages share the same photo, which is what ties a card to
// its own landing page without a second id to keep in sync.
const tourPageFor = (image: string) => {
  const tour = tours.find((entry) => entry.image === image);
  return tour ? tourPath(lang, tour[lang].slug) : null;
};

// Responsive variants are generated by scripts/optimize-images.mjs.
const TOUR_WIDTHS = [400, 600, 800, 1064];
const tourSrcset = (name: string) =>
  TOUR_WIDTHS.map((width) => `/images/${name}-${width}.webp ${width}w`).join(', ');
// Cards are 3-up inside a 1160px container until 980px, full width below it.
const TOUR_SIZES = '(min-width: 1192px) 376px, (min-width: 981px) 31vw, calc(100vw - 32px)';

const HERO_SRCSET = '/images/hero-1200.webp 1200w, /images/hero-1600.webp 1600w';
// The hero is 2.11:1 stretched over a much taller box with object-fit: cover, so
// it needs a good deal more intrinsic width than the viewport is wide.
const HERO_SIZES = '(max-width: 560px) 1600px, 130vw';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TravelAgency',
    '@id': `${SITE_URL}/#business`,
    name: 'Netherlands Unveiled',
    description: t.meta.description,
    url: absoluteUrl(alternates[lang]),
    image: absoluteUrl('/images/hero-1600.webp'),
    priceRange: '$$',
    areaServed: [
      { '@type': 'Country', name: 'Netherlands' },
      { '@type': 'City', name: 'Amsterdam' },
      { '@type': 'City', name: 'The Hague' },
      { '@type': 'City', name: 'Rotterdam' },
      { '@type': 'City', name: 'Delft' },
      { '@type': 'City', name: 'Nijmegen' },
    ],
    availableLanguage: ['en', 'nl', 'de', 'fr', 'es', 'it'],
    employee: {
      '@type': 'Person',
      name: 'Marion Baumgarten',
      jobTitle: lang === 'fr' ? 'Guide et directrice de circuit' : 'Tour guide and tour director',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'Netherlands Unveiled',
    url: SITE_URL,
    inLanguage: localeTag[lang],
    publisher: { '@id': `${SITE_URL}/#business` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Tour Director Marion Baumgarten',
    description: t.about.copy[1],
    thumbnailUrl: absoluteUrl('/images/about-marion-video-1280.webp'),
    uploadDate: '2021-10-14',
    duration: 'PT1M37S',
    embedUrl: `https://player.vimeo.com/video/${VIDEO_ID}`,
    contentUrl: `https://vimeo.com/${VIDEO_ID}`,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.toursSection.title,
    itemListElement: tours.map((tour, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'TouristTrip',
        name: tour[lang].title,
        description: tour[lang].excerpt,
        image: absoluteUrl(`/images/${tour.image}-${tour.widths[tour.widths.length - 1]}.webp`),
        url: absoluteUrl(tourPath(lang, tour[lang].slug)),
        touristType: lang === 'fr' ? 'Groupes et voyageurs individuels' : 'Groups and individual travellers',
        provider: { '@id': `${SITE_URL}/#business` },
      },
    })),
  },
];
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  alternates={alternates}
  schema={schema}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/hero-1600.webp"
    imagesrcset={HERO_SRCSET}
    imagesizes={HERO_SIZES}
    fetchpriority="high"
  />

  <section class="hero" aria-label={t.hero.label}>
    <img
      src="/images/hero-1600.webp"
      srcset={HERO_SRCSET}
      sizes={HERO_SIZES}
      width="1600"
      height="758"
      alt={t.hero.imageAlt}
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-content">
      <div class="hero-copy">
        <h1>{t.hero.title}</h1>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">{t.hero.primaryCta}</a>
          <a class="btn btn-ghost" href="#tours">{t.hero.secondaryCta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="tours">
    <div class="section-head">
      <h2>{t.toursSection.title}</h2>
      <p>{t.toursSection.copy}</p>
    </div>
    <div class="tour-grid">
      {t.tours.map((tour) => (
        <article class="tour-card">
          <img
            class="tour-media"
            src={`/images/${tour.image}-800.webp`}
            srcset={tourSrcset(tour.image)}
            sizes={TOUR_SIZES}
            width="800"
            height="600"
            alt={tour.alt}
            loading="lazy"
            decoding="async"
          />
          <div class="tour-body">
            <h3>{tour.title}</h3>
            <p>{tour.copy}</p>
            {tour.items.length > 0 && (
              <ul>
                {tour.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {tourPageFor(tour.image) && (
              <a class="text-link" href={tourPageFor(tour.image)}>{toursIndex[lang].page.readMore}</a>
            )}
          </div>
        </article>
      ))}
    </div>
    <p class="tours-all">
      <a class="text-link" href={routes.tours[lang]}>{toursIndex[lang].page.title}</a>
    </p>
  </section>

  <section class="band" id="nijmegen" aria-label={t.nijmegen.label}>
    <div class="section feature">
      <div class="feature-copy">
        <p class="eyebrow">{t.nijmegen.eyebrow}</p>
        <h2>{t.nijmegen.title}</h2>
        {t.nijmegen.copy.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <a class="btn btn-primary" href="#contact">{t.nijmegen.cta}</a>
      </div>
      <figure class="feature-media">
        <img
          src="/images/nijmegen-tour-group-1000.webp"
          srcset="/images/nijmegen-tour-group-640.webp 640w, /images/nijmegen-tour-group-1000.webp 1000w"
          sizes="(min-width: 981px) 540px, calc(100vw - 32px)"
          width="1000"
          height="625"
          alt={t.nijmegen.imageAlt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section spring-section" aria-label={t.spring.label}>
    <article class="spring-card">
      <div class="spring-content">
        <p class="eyebrow">{t.spring.eyebrow}</p>
        <h2>{t.spring.title}</h2>
        {t.spring.copy.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {keukenhofPost && (
          <a class="text-link" href={postPath(lang, keukenhofPost[lang].slug)}>{t.spring.readMore}</a>
        )}
      </div>
    </article>
  </section>

  <section class="band" id="about">
    <div class="section">
      <div class="section-head solo">
        <h2>{t.about.title}</h2>
      </div>
      <div class="about-grid">
        <VideoEmbed
          videoId={VIDEO_ID}
          poster="about-marion-video"
          posterAlt={t.about.video.posterAlt}
          playLabel={t.about.video.play}
          length={t.about.video.length}
          caption={t.about.video.caption}
          openLabel={t.about.video.openOnVimeo}
          videoTitle="Tour Director Marion Baumgarten"
        />
        <div class="about-copy">
          {t.about.copy.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <div class="insight-note">
            <p>{t.about.note}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="reviews">
    <div class="section-head solo">
      <h2>{t.reviews.title}</h2>
    </div>
    <div class="review-grid">
      {t.reviews.items.map((review) => (
        <figure class="review-card">
          <blockquote>{review.quote}</blockquote>
          <figcaption>
            <strong>{review.name}</strong>
            <span>{review.from}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section" id="contact">
    <div class="contact-wrap">
      <div class="contact-card">
        <p class="eyebrow">{t.contact.eyebrow}</p>
        <h2>{t.contact.title}</h2>
        <p>{t.contact.copy}</p>
        <a class="btn btn-messenger" href={messengerUrl} target="_blank" rel="noopener">
          {t.contact.messenger}
        </a>
      </div>

      <ContactForm lang={lang} />
    </div>
  </section>
</Base>
