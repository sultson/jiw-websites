---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---
<Layout lang="nl" title="Pagina niet gevonden | Pedicure Flow Ine" description="Deze pagina bestaat niet." path="/404" alternate="/en">
  <main class="not-found"><Image src={logo} alt="Pedicure Flow Ine" width={300} /><p>404</p><h1>Deze pagina bestaat niet.</h1><a class="button" href="/">Terug naar home</a></main>
</Layout>
<style>.not-found{display:grid;min-height:100vh;place-content:center;justify-items:center;gap:1.5rem;padding:2rem;text-align:center}.not-found img{width:16rem}.not-found>p{color:var(--rose);font-weight:800;letter-spacing:.15em}.not-found h1{font-size:clamp(2rem,6vw,4rem)}</style>
