{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "resq-protec",
  "account_id": "aec64586d4d04a644f4f9b8225d7ca28",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-24",
  "observability": { "enabled": true },
  // No production workers.dev address; version previews on (`wrangler versions upload
  // --preview-alias <name>`) so a variant can be tried without touching the concept hosts.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Pages go through the Worker (host redirects + noindex on concept hosts); static
    // files are served straight from the asset store.
    "run_worker_first": ["/*", "!/_astro/*", "!/images/*", "!/fonts/*", "!/downloads/*", "!/vendor/*", "!/favicon.svg", "!/favicon.png"]
  },
  // Live on rescuewatercraft.eu since 23-10-2026 (apex canonical; www 301s onto it here
  // and via a zone redirect rule). The concept hosts stay attached and 301 onto the apex,
  // path preserved, because LIVE is "true".
  "routes": [
    { "pattern": "resqprotec.jouwidealewebsite.nl", "custom_domain": true },
    { "pattern": "rescuewatercraft.jouwidealewebsite.nl", "custom_domain": true }
    ,{ "pattern": "rescuewatercraft.eu", "custom_domain": true }
    ,{ "pattern": "www.rescuewatercraft.eu", "custom_domain": true }
    // The client's old .nl domain: everything 301s to the Dutch pages on .eu (DUTCH_HOSTS).
    // Its zone also carries the Purelymail records for info@rescuewatercraft.nl; leave them.
    ,{ "pattern": "rescuewatercraft.nl", "custom_domain": true }
    ,{ "pattern": "www.rescuewatercraft.nl", "custom_domain": true }
  ],
  "r2_buckets": [{ "binding": "WEBSITE_ASSETS", "bucket_name": "jiw-large-website-assets" }, { "binding": "FORM_UPLOADS", "bucket_name": "jiw-form-uploads-prod" }],
  "send_email": [{ "name": "LEAD_EMAIL", "allowed_sender_addresses": ["no-reply@notify.rescuewatercraft.eu"] }],
  "vars": {
    "SITE_ID": "resq-protec",
    // The client's own mailbox since 23-10-2026, and the reply-to on the visitor's
    // confirmation. NEVER send a test submission against this config: point it back at
    // hallo@jouwidealewebsite.nl first.
    "LEAD_RECIPIENT": "info@rescuewatercraft.nl",
    "LEAD_SENDER": "no-reply@notify.rescuewatercraft.eu",
    "CANONICAL_HOST": "rescuewatercraft.eu",
    "LIVE": "true",
    // The language on `/`; the others live under /<lang>. The build reads this too
    // (tools/default-lang.mjs), so pages, sitemap, hreflang x-default and the Worker agree.
    "DEFAULT_LANG": "en",
    // Hosts whose every URL 301s to the Dutch version on CANONICAL_HOST.
    "DUTCH_HOSTS": "rescuewatercraft.nl,www.rescuewatercraft.nl"
  }
}
