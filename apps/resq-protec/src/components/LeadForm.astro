---
import { pick, type Lang } from '../data/content';
const { lang='nl', kind='contact', items=[] }=Astro.props as {lang:Lang;kind:'course'|'equipment'|'contact';items?:string[]};
const t=(nl:string,en:string,de:string)=>pick(lang,nl,en,de);
const labels={course:t('Opleiding of training','Course or training','Ausbildung oder Training'),equipment:t('Product of categorie','Product or category','Produkt oder Kategorie'),contact:t('Onderwerp','Subject','Betreff')};
---
<form class="lead-form" data-lead-form method="post" action={`/api/forms/${lang==='nl'?'':`${lang}/`}${kind}`}>
  <input type="hidden" name="language" value={lang}/><input type="hidden" name="__jiw_confirmation_locale" value={lang}/><input type="hidden" name="pageUrl" value="" data-page-url />
  <div class="field-row"><label>{t('Voornaam','First name','Vorname')}<input name="firstName" autocomplete="given-name" required /></label><label>{t('Achternaam','Last name','Nachname')}<input name="lastName" autocomplete="family-name" required /></label></div>
  <div class="field-row"><label>{t('E-mailadres','Email address','E-Mail-Adresse')}<input type="email" name="email" autocomplete="email" required /></label><label>{t('Telefoonnummer','Phone number','Telefonnummer')}<input type="tel" name="phone" autocomplete="tel" required /></label></div>
  <label>{labels[kind]}{items.length?<select name="subject" required><option value="">{t('Maak een keuze','Select an option','Bitte auswählen')}</option>{items.map(item=><option value={item}>{item}</option>)}</select>:<input name="subject" required />}</label>
  <label>{t('Organisatie','Organisation','Organisation')}<input name="organisation" autocomplete="organization" /></label>
  <label>{t('Uw vraag of toelichting','Your question or notes','Ihre Frage oder Anmerkungen')}<textarea name="message" rows="5" required></textarea></label>
  <label class="consent"><input type="checkbox" name="privacyConsent" value={t('Akkoord','Agreed','Einverstanden')} required/><span>{t('Ik ga akkoord met het verwerken van mijn gegevens om mijn aanvraag te beantwoorden.','I agree to the processing of my data to answer my request.','Ich bin mit der Verarbeitung meiner Daten zur Beantwortung meiner Anfrage einverstanden.')}</span></label>
  <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
  <!-- Turnstile widget "Resqprotec formulieren" (managed, only shows itself when it needs an interaction). The worker verifies the token; a post without one sends no mail. -->
  <div class="cf-turnstile" data-sitekey="0x4AAAAAAD2h-XD8dN6PHeWG" data-language={lang} data-appearance="interaction-only" data-size="flexible"></div>
  <button class="button" type="submit">{t('Aanvraag versturen','Send request','Anfrage senden')}</button><p class="form-status" role="status" aria-live="polite"></p>
</form>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
const say={
  nl:{sending:'Bezig met versturen…',failed:'Aanvraag mislukt.',done:'Bedankt. Uw aanvraag is ontvangen. U ontvangt een bevestiging per e-mail.',error:'Er ging iets mis.',check:'De spamcontrole is nog niet klaar of verlopen. Probeer het over een paar seconden opnieuw.'},
  en:{sending:'Sending…',failed:'Request failed.',done:'Thank you. Your request has been received. A confirmation is on its way to your inbox.',error:'Something went wrong.',check:'The spam check is not ready yet or has expired. Please try again in a few seconds.'},
  de:{sending:'Wird gesendet…',failed:'Anfrage fehlgeschlagen.',done:'Vielen Dank. Ihre Anfrage ist eingegangen. Sie erhalten eine Bestätigung per E-Mail.',error:'Etwas ist schiefgelaufen.',check:'Die Spamprüfung ist noch nicht bereit oder abgelaufen. Bitte versuchen Sie es in einigen Sekunden erneut.'},
};
type Turnstile={getResponse(container:Element):string|undefined;reset(container:Element):void};
const turnstile=()=>(window as unknown as {turnstile?:Turnstile}).turnstile;
// The managed check runs in the background and can still be busy when someone is quick;
// wait up to 8 seconds for its token rather than posting without one.
const tokenFor=async(widget:Element|null)=>{for(let i=0;i<40;i++){const token=widget&&turnstile()?.getResponse(widget);if(token)return token;await new Promise(r=>setTimeout(r,200));}return '';};
document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach(form=>{
  const page=form.querySelector<HTMLInputElement>('[data-page-url]'); if(page) page.value=location.href;
  form.addEventListener('submit',async e=>{e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type=submit]');const status=form.querySelector<HTMLElement>('.form-status');const s=say[document.documentElement.lang as keyof typeof say]??say.en;if(!button||!status)return;button.disabled=true;status.textContent=s.sending;const widget=form.querySelector('.cf-turnstile');try{const body=new FormData(form);body.set('cf-turnstile-response',await tokenFor(widget));const response=await fetch(form.action,{method:'POST',body});const data=await response.json() as {ok?:boolean;error?:string;message?:string};if(!response.ok)throw new Error(data.error==='turnstile'?s.check:data.message||s.failed);form.reset();status.textContent=s.done;}catch(error){status.textContent=error instanceof Error?error.message:s.error;}finally{button.disabled=false;
    // A token is good for one verification, so every attempt needs a fresh one.
    if(widget)turnstile()?.reset(widget);}});
});
</script>
<style>
.lead-form{display:grid;gap:18px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.lead-form label{display:grid;gap:7px;font-size:.74rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase}.lead-form input,.lead-form select,.lead-form textarea{width:100%;border:1px solid #b9b9b6;border-radius:0;background:white;padding:13px 14px;color:var(--ink);outline:none;text-transform:none}.lead-form input:focus,.lead-form select:focus,.lead-form textarea:focus{border-color:var(--ink);box-shadow:0 0 0 3px rgba(198,208,64,.55)}.consent{grid-template-columns:auto 1fr!important;align-items:start;text-transform:none!important;font-weight:400!important;letter-spacing:0!important}.consent input{width:18px;height:18px;margin-top:3px;accent-color:var(--green-ink)}.lead-form .button{justify-self:start}.form-status{margin:0;font-size:.9rem}.button:disabled{opacity:.55}.lead-form .hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}@media(max-width:600px){.field-row{grid-template-columns:1fr}.lead-form .button{width:100%}}
</style>
