---
import Layout from './Layout.astro'; import Icon from './Icon.astro';
import { copy, routes, type Lang } from '../data/content';
const { lang='nl' }=Astro.props as {lang:Lang}; const c=copy[lang],r=routes[lang];
const advantages=lang==='nl'?['Lage operationele kosten','Snel inzetbaar','Zeer wendbaar','Eenvoudig aan te leren','Geen schroefwerking','Lage diepgang','Laag gewicht']:['Low operating costs','Rapid deployment','Highly manoeuvrable','Easy to learn','No exposed propeller','Shallow draft','Low weight'];
const audiences=lang==='nl'?['Gemeenten','Brandweer','Veiligheidsregio’s','Politie','Defensie','Rijkswaterstaat']:['Municipalities','Fire services','Safety regions','Police','Defence','Rijkswaterstaat'];
const news=lang==='nl'?[['29 okt 2022','Samenwerking met TOHATSU Nederland','/images/updates/img_2419.webp'],['12 dec 2020','Veiligheidstraining voor K3 Delta','/images/updates/img_2560.webp'],['29 nov 2020','NIKTA-gecertificeerd opleidingscentrum','/images/updates/img_2642.webp']]:[['29 Oct 2022','Partnership with TOHATSU Netherlands','/images/updates/img_2419.webp'],['12 Dec 2020','Safety training for K3 Delta','/images/updates/img_2560.webp'],['29 Nov 2020','NIKTA-certified training centre','/images/updates/img_2642.webp']];
const partner=lang==='nl'?{
  eyebrow:'Strategische samenwerking',
  title:'Samenwerking met Reddingsbrigade Nederland',
  lead:'Rescue Watercraft B.V. werkt nauw samen met Reddingsbrigade Nederland om organisaties een compleet totaalpakket te bieden op het gebied van professionele reddingswaterscooters. Dankzij deze samenwerking kunnen wij onze klanten volledig ontzorgen: van advies en aanschaf tot training, onderhoud en service.',
  alt:'Rescue Watercraft Operator op een reddingswaterscooter',
  caption:'Rescue Watercraft Operator',
  primary:'Vraag advies aan', secondary:'Naar opleidingen en trainingen',
  stages:['Advies','Aanschaf','Training','Onderhoud','Service'],
  seal:['Rescue Watercraft Operator','Certificaat'],
  mapAlt:'Kaart van IJmuiden met de haven en de monding van het Noordzeekanaal',
  coords:'52.46° N · 4.61° O',
  pillars:[
    ['Werkplaats in IJmuiden','Reddingsbrigade Nederland beschikt over een uitstekend uitgeruste werkplaats in IJmuiden. Vanuit deze locatie wordt het onderhoud uitgevoerd aan de volledige vloot van de reddingsbrigade en aan vaartuigen van diverse overheidsorganisaties. Door de jarenlange praktijkervaring en specialistische kennis van waterscooters is Reddingsbrigade Nederland een waardevolle partner voor Rescue Watercraft B.V. en onze klanten.'],
    ['Service de hele levensduur','Deze samenwerking is bewust aangegaan om een hoog serviceniveau te kunnen garanderen gedurende de volledige levensduur van de waterscooter. Hierdoor bent u verzekerd van deskundig advies, professioneel onderhoud en snelle ondersteuning wanneer dat nodig is.'],
    ['Certificaat Rescue Watercraft Operator','Rescue Watercraft B.V. en Reddingsbrigade Nederland verzorgen gezamenlijk een unieke opleidingslijn. De speciaal ontwikkelde training leidt deelnemers op tot Rescue Watercraft Operator. Na het succesvol afronden van deze opleiding ontvangen deelnemers het officiële certificaat Rescue Watercraft Operator, waarmee zij aantonen veilig, verantwoord en professioneel met een reddingswaterscooter te kunnen werken.'],
  ],
  close:'Door onze expertise te combineren met de praktijkervaring van Reddingsbrigade Nederland bieden wij een unieke totaaloplossing. Samen staan wij voor kwaliteit, veiligheid, vakmanschap en betrouwbaarheid, zodat hulpdiensten en professionele organisaties kunnen vertrouwen op de beste producten, opleidingen, service en ondersteuning.',
  mediaLabel:'Reportage · Brandweer Zuid-Limburg',
  mediaText:'Brandweer Maastricht nam als eerste korps in Nederland een reddingswaterscooter in gebruik, opgeleid door instructeurs van Reddingsbrigade Nederland.',
  mediaSource:'Bekijken op YouTube',
}:{
  eyebrow:'Strategic partnership',
  title:'Partnership with Reddingsbrigade Nederland',
  lead:'Rescue Watercraft B.V. works closely with Reddingsbrigade Nederland, the Dutch national lifesaving organisation, to offer organisations a complete package for professional rescue watercraft. This partnership allows us to take care of everything: from advice and purchase to training, maintenance and service.',
  alt:'Rescue Watercraft Operator on a rescue watercraft',
  caption:'Rescue Watercraft Operator',
  primary:'Request advice', secondary:'Go to courses and training',
  stages:['Advice','Purchase','Training','Maintenance','Service'],
  seal:['Rescue Watercraft Operator','Certificate'],
  mapAlt:'Map of IJmuiden showing the harbour and the mouth of the North Sea Canal',
  coords:'52.46° N · 4.61° E',
  pillars:[
    ['Workshop in IJmuiden','Reddingsbrigade Nederland operates a fully equipped workshop in IJmuiden. From this location it maintains the organisation’s entire fleet as well as vessels belonging to various government bodies. Years of practical experience and specialist watercraft knowledge make Reddingsbrigade Nederland a valuable partner for Rescue Watercraft B.V. and our clients.'],
    ['Service across the full lifespan','We entered this partnership deliberately, to guarantee a high level of service throughout the full lifespan of the watercraft. You are assured of expert advice, professional maintenance and fast support whenever it is needed.'],
    ['Rescue Watercraft Operator certificate','Rescue Watercraft B.V. and Reddingsbrigade Nederland jointly deliver a unique training programme. The purpose-built course qualifies participants as Rescue Watercraft Operator. On successful completion, participants receive the official Rescue Watercraft Operator certificate, demonstrating that they can operate a rescue watercraft safely, responsibly and professionally.'],
  ],
  close:'By combining our expertise with the practical experience of Reddingsbrigade Nederland, we offer a unique complete solution. Together we stand for quality, safety, craftsmanship and reliability, so that emergency services and professional organisations can rely on the best products, training, service and support.',
  mediaLabel:'Report · Brandweer Zuid-Limburg',
  mediaText:'Maastricht fire service was the first in the Netherlands to put a rescue watercraft into service, trained by instructors from Reddingsbrigade Nederland.',
  mediaSource:'Watch on YouTube (in Dutch)',
};
const sealTicks=Array.from({length:72},(_,i)=>{const a=i*5*Math.PI/180;return [200+Math.cos(a)*86,122+Math.sin(a)*86,200+Math.cos(a)*92,122+Math.sin(a)*92].map(n=>n.toFixed(1));});
const railTicks=Array.from({length:41},(_,i)=>(44+i*7.8).toFixed(1));
const clients:[string,string,number,number][]=[['Royal Van Lent Shipyard','/images/clients/roal-van-lent-jpg.jpg',199,126],['Veolia','/images/clients/veolia-jpg.jpg',186,66],['AAB Training en Opleiding','/images/clients/1551086139946-jpg.jpg',200,200],['FrieslandCampina','/images/clients/frieslandcampina-jpg.jpg',198,69],['Hoogheemraadschap van Delfland','/images/clients/logo-hoogheemraadschap-delfland-waterstudio-1200x721-1-jpg.jpg',198,70],['Hoogheemraadschap van Rijnland','/images/clients/hoogheemraadschap-van-rijnland-jpg.jpg',197,66],['K3Delta','/images/clients/k3-delta-logo-768x576-1-jpg.jpg',197,65],['CBT','/images/clients/cbt-jpg.jpg',196,112],['Brandweer Noord- en Oost-Gelderland','/images/clients/brandweer-noord-en-oost-gelderland-jpg.jpg',199,53],['Brandweer Midden- en West-Brabant','/images/clients/midden-west-brw-jpg.jpg',200,73],['Brandweer Brabant-Noord','/images/clients/brw-brn-jpg.jpg',199,56],['Mourik','/images/clients/mourik-jpg.jpg',191,65]];
---
<Layout lang={lang} title={lang==='nl'?'Rescue Watercraft | Professionele waterredding':'Rescue Watercraft | Professional water rescue'} description={c.heroText} canonicalPath={r.home==='/'?'':r.home}>
  <section class="hero">
    <picture><img src="/images/hero.webp" srcset="/images/hero-640.webp 640w, /images/hero-1200.webp 1200w, /images/hero.webp 2200w" sizes="100vw" alt={lang==='nl'?'Reddingswaterscooter met Rescue Raft tijdens een oefening':'Rescue watercraft and Rescue Raft during training'} width="2200" height="1400" fetchpriority="high" /></picture>
    <div class="hero-shade"></div><div class="container hero-content"><h1>{c.heroTitle}</h1><p>{c.heroText}</p><div class="hero-actions"><a class="button light" href="#watercraft">{c.heroPrimary}<Icon name="arrow"/></a><a class="button outline" href={r.contact}>{c.heroSecondary}</a></div><div class="hero-quality"><img src="/images/nikta-certificate.webp" alt="NIKTA gecertificeerd examenbureau" width="1500" height="1500"/><span>{lang==='nl'?'NIKTA-gecertificeerd examenbureau':'NIKTA-certified examination centre'}</span></div></div>
  </section>
  <section class="client-proof" aria-labelledby="client-proof-title"><div class="container"><p class="eyebrow" id="client-proof-title">{c.heroEyebrow}</p><div class="client-logos"><div class="client-logos-track"><div class="client-logo-group">{clients.map(([name,image,width,height])=><div class="client-logo"><span><img src={image} alt={name} width={width} height={height} loading="lazy"/></span></div>)}</div><div class="client-logo-group" aria-hidden="true">{clients.map(([,image,width,height])=><div class="client-logo"><span><img src={image} alt="" width={width} height={height} loading="lazy"/></span></div>)}</div></div></div></div></section>
  <section class="quick"><a href={r.courses}><span>01</span><div><p>{lang==='nl'?'Kennis voor de praktijk':'Knowledge for the field'}</p><h2>{c.coursesTitle}</h2></div><Icon name="arrow" size={28}/></a><a href={r.equipment}><span>02</span><div><p>{lang==='nl'?'Materieel waarop u vertrouwt':'Equipment you can rely on'}</p><h2>{c.equipmentTitle}</h2></div><Icon name="arrow" size={28}/></a></section>
  <section class="section watercraft" id="watercraft"><div class="container split"><div><p class="eyebrow">Rescue Watercraft</p><h2>{lang==='nl'?'Een totaalconcept voor professionele waterredding.':'A complete concept for professional water rescue.'}</h2><p class="lead">{lang==='nl'?'Door het unieke ontwerp van de Rescue Raft en rescue sled in combinatie met een reddingswaterscooter kunnen drenkelingen veilig en snel uit het water worden gehaald, zonder dat een redder zelf te water hoeft.':'The unique Rescue Raft and rescue sled combined with a rescue watercraft enables casualties to be recovered safely and quickly, without requiring a rescuer to enter the water.'}</p><p>{lang==='nl'?'Onze professionals zijn al jarenlang actief in het veiligheidsdomein. Rescue Watercraft begeleidt persoonlijk het hele traject: advies, aankoop, onderhoud, Rescue Watercraft-instructies, opleiding en certificering. Ook voor Rescue Seadoo- en Seadoo rescue-toepassingen en uitrusting zoals het IONIC-droogpak kijken we naar inzetbaarheid én een lage Total Cost of Ownership.':'Our team brings years of professional safety-domain experience. Rescue Watercraft personally supports the complete lifecycle: advice, purchase, maintenance, Rescue Watercraft instructions, training and certification. For Rescue Seadoo and Seadoo rescue applications, and equipment such as the IONIC drysuit, we consider both operational readiness and a low Total Cost of Ownership.'}</p><a class="text-link" href={r.contact}>{lang==='nl'?'Vraag een demonstratie aan':'Request a demonstration'} <Icon name="arrow"/></a></div><div><img src="/images/action.webp" alt="Rescue Watercraft met rescue sled" width="900" height="700" loading="lazy"/><div class="stat"><strong>{lang==='nl'?'Totaalpartnerschap':'Total partnership'}</strong><span>{lang==='nl'?'Van aankoop en onderhoud tot opleiding en certificering':'From purchase and maintenance to training and certification'}</span></div></div></div></section>
  <section class="audience"><div class="container"><p>{lang==='nl'?'Voor organisaties die voorbereid moeten zijn op het water':'For organisations that must be ready on the water'}</p><div>{audiences.map(item=><span>{item}</span>)}</div></div></section>
  <section class="section partner" id="reddingsbrigade" aria-labelledby="partner-title"><div class="container">
    <div class="partner-lockup"><span>Rescue Watercraft B.V.</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5 12.5 12.5M12.5 3.5 3.5 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>Reddingsbrigade Nederland</span></div>
    <div class="partner-intro"><figure class="partner-figure"><img src="/images/partner-operator.webp" alt={partner.alt} width="900" height="1350" loading="lazy"/><figcaption>{partner.caption}</figcaption></figure><div><p class="eyebrow">{partner.eyebrow}</p><h2 id="partner-title">{partner.title}</h2><p class="lead">{partner.lead}</p><div class="partner-actions"><a class="button" href={r.contact}>{partner.primary}<Icon name="arrow"/></a><a class="text-link" href={r.courses}>{partner.secondary} <Icon name="arrow"/></a></div></div></div>
    <div class="partner-pillars">
      <article class="pillar"><div class="plate"><img src="/images/ijmuiden-map.webp" alt={partner.mapAlt} width="800" height="500" loading="lazy"/><svg class="plate-pin" viewBox="0 0 48 48" aria-hidden="true"><defs><radialGradient id="pin-halo"><stop offset=".45" stop-color="#0c141b" stop-opacity=".72"/><stop offset="1" stop-color="#0c141b" stop-opacity="0"/></radialGradient></defs><circle cx="24" cy="24" r="24" fill="url(#pin-halo)"/><circle cx="24" cy="24" r="17" fill="none" stroke="#fff" stroke-opacity=".16"/><path d="M24 3v6M24 39v6M3 24h6M39 24h6" stroke="#fff" stroke-opacity=".32" stroke-width="1"/><circle cx="24" cy="24" r="9" fill="none" stroke="#fff" stroke-opacity=".36"/><circle cx="24" cy="24" r="3.6" fill="#d91f2b" stroke="#fff" stroke-width="1.4"/></svg><span class="plate-index">01</span><span class="plate-coords">{partner.coords}</span><span class="plate-credit">© Mapbox © OpenStreetMap</span></div><div class="pillar-body"><h3>{partner.pillars[0][0]}</h3><p>{partner.pillars[0][1]}</p></div></article>
      <article class="pillar"><div class="plate"><svg class="plate-art" viewBox="0 0 400 250" aria-hidden="true">{railTicks.map(x=><line x1={x} y1="100" x2={x} y2="107" stroke="#5b6f7d" stroke-width="1" stroke-opacity=".45"/>)}<line x1="44" y1="118" x2="356" y2="118" stroke="#d91f2b" stroke-width="1.6"/>{partner.stages.map((stage,i)=><g><line x1={44+i*78} y1="126" x2={44+i*78} y2="137" stroke="#3d4e5a" stroke-width="1"/><circle cx={44+i*78} cy="118" r="5" fill="#101820" stroke="#dbe4e9" stroke-width="1.4"/><text class="plate-label" x={44+i*78} y="152" text-anchor="middle">{stage.toUpperCase()}</text></g>)}</svg><span class="plate-index">02</span></div><div class="pillar-body"><h3>{partner.pillars[1][0]}</h3><p>{partner.pillars[1][1]}</p></div></article>
      <article class="pillar"><div class="plate"><svg class="plate-art" viewBox="0 0 400 250" aria-hidden="true"><defs><path id="seal-top" d="M128 122A72 72 0 0 1 272 122"/><path id="seal-bottom" d="M119 122A81 81 0 0 0 281 122"/></defs><circle cx="200" cy="122" r="92" fill="none" stroke="#2d3d49" stroke-width="1"/><circle cx="200" cy="122" r="68" fill="none" stroke="#d91f2b" stroke-width="1" stroke-opacity=".85"/>{sealTicks.map(([x1,y1,x2,y2])=><line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#2d3d49" stroke-width="1"/>)}<text class="seal-text"><textPath href="#seal-top" startOffset="50%" text-anchor="middle">{partner.seal[0].toUpperCase()}</textPath></text><text class="seal-text seal-text-sub"><textPath href="#seal-bottom" startOffset="50%" text-anchor="middle">{partner.seal[1].toUpperCase()}</textPath></text><path d="M124 118l4 4-4 4-4-4zM276 118l4 4-4 4-4-4z" fill="#5b6f7d"/><path d="M166 118c4-16 18-26 38-26h30l-8 26z" fill="#d91f2b"/><path d="M178 130q11-6.5 22 0t22 0" fill="none" stroke="#c4d0d7" stroke-width="1.7" stroke-linecap="round"/><path d="M172 141q14-6.5 28 0t28 0" fill="none" stroke="#c4d0d7" stroke-opacity=".58" stroke-width="1.7" stroke-linecap="round"/><path d="M166 152q17-6.5 34 0t34 0" fill="none" stroke="#c4d0d7" stroke-opacity=".28" stroke-width="1.7" stroke-linecap="round"/></svg><span class="plate-index">03</span></div><div class="pillar-body"><h3>{partner.pillars[2][0]}</h3><p>{partner.pillars[2][1]}</p></div></article>
    </div>
    <p class="partner-close">{partner.close}</p>
    <a class="partner-media" href="https://youtu.be/lJEoJB-DAsk" target="_blank" rel="noreferrer"><span class="partner-media-play"><Icon name="play" size={26}/></span><span class="partner-media-body"><span class="partner-media-label">{partner.mediaLabel}</span><span class="partner-media-text">{partner.mediaText}</span></span><span class="partner-media-source">{partner.mediaSource} <Icon name="arrow" size={17}/></span></a>
  </div></section>
  <section class="benefits section"><div class="container"><div class="section-head"><div><p class="eyebrow">{lang==='nl'?'Operationeel voordeel':'Operational advantage'}</p><h2>{lang==='nl'?'Gebouwd voor de inzet.':'Built for the mission.'}</h2></div><p class="lead">{lang==='nl'?'Een laag gewicht en geringe diepgang maken transport, tewaterlating en manoeuvreren eenvoudig.':'Low weight and shallow draft simplify transport, launching and manoeuvring.'}</p></div><div class="benefit-grid">{advantages.map((item,i)=><div><span>{String(i+1).padStart(2,'0')}</span><Icon name="check"/><h3>{item}</h3></div>)}</div></div></section>
  <section class="section services"><div class="container"><div class="section-head"><div><p class="eyebrow">{lang==='nl'?'Producten & expertise':'Products & expertise'}</p><h2>{lang==='nl'?'Alles voor een veilige inzet.':'Everything for safe deployment.'}</h2></div></div><div class="service-grid"><a href={r.courses}><img src="/images/training.webp" alt="Training waterredding" width="800" height="600" loading="lazy"/><div><p>01</p><h3>{c.coursesTitle}</h3><span>{c.view} <Icon name="arrow"/></span></div></a><a href={r.equipment}><img src="/images/equipment.webp" alt="Professionele waterreddingsuitrusting" width="800" height="600" loading="lazy"/><div><p>02</p><h3>{c.equipmentTitle}</h3><span>{c.view} <Icon name="arrow"/></span></div></a></div></div></section>
  <section class="updates section"><div class="container updates-grid"><div><div class="section-head"><div><p class="eyebrow">Latest</p><h2>{lang==='nl'?'Actueel':'Updates'}</h2></div><a class="text-link" href={r.updates}>{lang==='nl'?'Alle updates':'All updates'} <Icon name="arrow"/></a></div><div class="news" data-social-feed>{news.map(([date,title,image])=><a href={r.updates}><span class="news-media"><img src={image} alt="" width="240" height="160" loading="lazy"/></span><div><time>{date}</time><h3>{title}</h3></div><Icon name="arrow"/></a>)}</div></div><aside><p class="eyebrow">{lang==='nl'?'Open trainingsdata':'Open training dates'}</p><h2>{lang==='nl'?'Momenteel geen openbare data.':'No public dates at present.'}</h2><p>{lang==='nl'?'Rescue Watercraft plant opleidingen meestal in company met de opdrachtgever. Zodra er open inschrijvingsdata zijn, verschijnen die hier. Een datum voor uw team stemmen we persoonlijk af.':'Rescue Watercraft normally schedules in-company programmes with the client. Open enrolment dates will appear here when available. We can arrange a date for your team personally.'}</p><a class="button light" href={`${r.courses}#aanvragen`}>{lang==='nl'?'Datum afstemmen':'Arrange a date'}<Icon name="arrow"/></a></aside></div></section>
</Layout>
<script>
type FeedItem={text:string;url:string;time:string;image?:string};
const feed=document.querySelector<HTMLElement>('[data-social-feed]');
if(feed) fetch('/api/social-feed?channel=facebook&v=2').then(response=>response.ok?response.json():Promise.reject()).then((data:{items?:FeedItem[]})=>{
  if(!data.items?.length)return;
  const formatter=new Intl.DateTimeFormat(document.documentElement.lang==='nl'?'nl-NL':'en-GB',{day:'numeric',month:'short',year:'numeric'});
  const links=data.items.slice(0,3).map(item=>{
    const link=document.createElement('a');link.href=item.url;link.target='_blank';link.rel='noreferrer';
    const media=document.createElement('span');media.className='news-media';if(item.image){const image=document.createElement('img');image.src=item.image;image.alt='';image.loading='lazy';media.append(image)}link.append(media);const body=document.createElement('div');const time=document.createElement('time');const date=new Date(item.time);time.textContent=Number.isNaN(date.getTime())?'Facebook':formatter.format(date);
    const heading=document.createElement('h3');heading.textContent=item.text.length>105?`${item.text.slice(0,102)}…`:item.text;
    const arrow=document.createElement('span');arrow.textContent='→';arrow.setAttribute('aria-hidden','true');
    body.append(time,heading);link.append(body,arrow);return link;
  });
  feed.replaceChildren(...links);
}).catch(()=>{});
</script>
<style>
.hero{position:relative;min-height:min(780px,calc(100vh - 32px));display:flex;align-items:end;color:#fff;overflow:hidden}.hero>picture,.hero>picture img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,17,24,.85) 0%,rgba(8,17,24,.43) 52%,rgba(8,17,24,.08)),linear-gradient(0deg,rgba(8,17,24,.48),transparent 50%)}.hero-content{position:relative;padding-bottom:clamp(48px,7vw,82px)}.hero h1{max-width:850px}.hero-content>p:not(.eyebrow){max-width:640px;font-size:1.17rem}.hero-actions{display:flex;gap:12px;margin-top:32px}.hero-quality{display:flex;align-items:center;gap:10px;margin-top:20px;color:#dce3e7;font-size:.72rem}.hero-quality img{width:44px;height:44px;object-fit:contain}.client-proof{padding:clamp(50px,6vw,76px) 0;background:#fff;border-bottom:1px solid var(--line)}.client-proof h2{font-size:clamp(2rem,3vw,3rem);margin-bottom:30px}.client-logos{width:100%;overflow:hidden;border:1px solid var(--line)}.client-logos-track{display:flex;width:max-content;animation:client-marquee 34s linear infinite}.client-logo-group{display:flex}.client-logo{flex:0 0 220px;width:220px;height:112px;padding:16px 24px;border-right:1px solid var(--line)}.client-logo span{position:relative;display:block;width:100%;height:100%}.client-logo img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;object-position:center;filter:grayscale(1);opacity:.82}.client-logos:hover .client-logos-track,.client-logos:focus-within .client-logos-track{animation-play-state:paused}@keyframes client-marquee{to{transform:translateX(-50%)}}.quick{display:grid;grid-template-columns:1fr 1fr;background:var(--ink);color:white}.quick>a{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px;padding:36px max(28px,calc((100vw - var(--max))/2));padding-right:clamp(24px,5vw,80px);text-decoration:none;border-right:1px solid #36434c}.quick>a:first-child{padding-left:max(28px,ca