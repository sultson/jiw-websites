---
import Layout from './Layout.astro'; import Icon from './Icon.astro';
import { copy, routes, type Lang } from '../data/content';
const { lang='nl' }=Astro.props as {lang:Lang}; const c=copy[lang],r=routes[lang];
const advantages=lang==='nl'?['Lage operationele kosten','Snel inzetbaar','Zeer wendbaar','Eenvoudig aan te leren','Geen schroefwerking','Lage diepgang','Laag gewicht']:['Low operating costs','Rapid deployment','Highly manoeuvrable','Easy to learn','No exposed propeller','Shallow draft','Low weight'];
const audiences=lang==='nl'?['Gemeenten','Brandweer','Veiligheidsregio’s','Politie','Defensie','Rijkswaterstaat']:['Municipalities','Fire services','Safety regions','Police','Defence','Rijkswaterstaat'];
const news=lang==='nl'?[['29 okt 2022','Samenwerking met TOHATSU Nederland','/images/updates/img_2419.webp'],['12 dec 2020','Veiligheidstraining voor K3 Delta','/images/updates/img_2560.webp'],['29 nov 2020','NIKTA-gecertificeerd opleidingscentrum','/images/updates/img_2642.webp']]:[['29 Oct 2022','Partnership with TOHATSU Netherlands','/images/updates/img_2419.webp'],['12 Dec 2020','Safety training for K3 Delta','/images/updates/img_2560.webp'],['29 Nov 2020','NIKTA-certified training centre','/images/updates/img_2642.webp']];
const clients:[string,string,number,number][]=[['Royal Van Lent Shipyard','/images/clients/roal-van-lent-jpg.jpg',199,126],['Veolia','/images/clients/veolia-jpg.jpg',186,66],['AAB Training en Opleiding','/images/clients/1551086139946-jpg.jpg',200,200],['FrieslandCampina','/images/clients/frieslandcampina-jpg.jpg',198,69],['Hoogheemraadschap van Delfland','/images/clients/logo-hoogheemraadschap-delfland-waterstudio-1200x721-1-jpg.jpg',198,70],['Hoogheemraadschap van Rijnland','/images/clients/hoogheemraadschap-van-rijnland-jpg.jpg',197,66],['K3Delta','/images/clients/k3-delta-logo-768x576-1-jpg.jpg',197,65],['CBT','/images/clients/cbt-jpg.jpg',196,112],['Brandweer Noord- en Oost-Gelderland','/images/clients/brandweer-noord-en-oost-gelderland-jpg.jpg',199,53],['Brandweer Midden- en West-Brabant','/images/clients/midden-west-brw-jpg.jpg',200,73],['Brandweer Brabant-Noord','/images/clients/brw-brn-jpg.jpg',199,56],['Mourik','/images/clients/mourik-jpg.jpg',191,65]];
---
<Layout lang={lang} title={lang==='nl'?'Resqprotec | Professionele waterredding':'Resqprotec | Professional water rescue'} description={c.heroText} canonicalPath={r.home==='/'?'':r.home}>
  <section class="hero">
    <picture><img src="/images/hero.webp" srcset="/images/hero-640.webp 640w, /images/hero-1200.webp 1200w, /images/hero.webp 2200w" sizes="100vw" alt={lang==='nl'?'Reddingswaterscooter met Rescue Raft tijdens een oefening':'Rescue watercraft and Rescue Raft during training'} width="2200" height="1400" fetchpriority="high" /></picture>
    <div class="hero-shade"></div><div class="container hero-content"><h1>{c.heroTitle}</h1><p>{c.heroText}</p><div class="hero-actions"><a class="button light" href="#watercraft">{c.heroPrimary}<Icon name="arrow"/></a><a class="button outline" href={r.contact}>{c.heroSecondary}</a></div><div class="hero-quality"><img src="/images/nikta-certificate.webp" alt="NIKTA gecertificeerd examenbureau" width="1500" height="1500"/><span>{lang==='nl'?'NIKTA-gecertificeerd examenbureau':'NIKTA-certified examination centre'}</span></div></div>
  </section>
  <section class="client-proof" aria-labelledby="client-proof-title"><div class="container"><p class="eyebrow" id="client-proof-title">{c.heroEyebrow}</p><div class="client-logos"><div class="client-logos-track"><div class="client-logo-group">{clients.map(([name,image,width,height])=><div class="client-logo"><span><img src={image} alt={name} width={width} height={height} loading="lazy"/></span></div>)}</div><div class="client-logo-group" aria-hidden="true">{clients.map(([,image,width,height])=><div class="client-logo"><span><img src={image} alt="" width={width} height={height} loading="lazy"/></span></div>)}</div></div></div></div></section>
  <section class="quick"><a href={r.courses}><span>01</span><div><p>{lang==='nl'?'Kennis voor de praktijk':'Knowledge for the field'}</p><h2>{c.coursesTitle}</h2></div><Icon name="arrow" size={28}/></a><a href={r.equipment}><span>02</span><div><p>{lang==='nl'?'Materieel waarop u vertrouwt':'Equipment you can rely on'}</p><h2>{c.equipmentTitle}</h2></div><Icon name="arrow" size={28}/></a></section>
  <section class="section watercraft" id="watercraft"><div class="container split"><div><p class="eyebrow">Rescue Watercraft</p><h2>{lang==='nl'?'Een totaalconcept voor professionele waterredding.':'A complete concept for professional water rescue.'}</h2><p class="lead">{lang==='nl'?'Door het unieke ontwerp van de Rescue Raft en rescue sled in combinatie met een reddingswaterscooter kunnen drenkelingen veilig en snel uit het water worden gehaald, zonder dat een redder zelf te water hoeft.':'The unique Rescue Raft and rescue sled combined with a rescue watercraft enables casualties to be recovered safely and quickly, without requiring a rescuer to enter the water.'}</p><p>{lang==='nl'?'Onze professionals zijn al jarenlang actief in het veiligheidsdomein. Resqprotec en Rescue Watercraft begeleiden persoonlijk het hele traject: advies, aankoop, onderhoud, Rescue Watercraft-instructies, opleiding en certificering. Ook voor Rescue Seadoo- en Seadoo rescue-toepassingen en uitrusting zoals het IONIC-droogpak kijken we naar inzetbaarheid én een lage Total Cost of Ownership.':'Our team brings years of professional safety-domain experience. Resqprotec and Rescue Watercraft personally support the complete lifecycle: advice, purchase, maintenance, Rescue Watercraft instructions, training and certification. For Rescue Seadoo and Seadoo rescue applications, and equipment such as the IONIC drysuit, we consider both operational readiness and a low Total Cost of Ownership.'}</p><a class="text-link" href={r.contact}>{lang==='nl'?'Vraag een demonstratie aan':'Request a demonstration'} <Icon name="arrow"/></a></div><div><img src="/images/action.webp" alt="Rescue Watercraft met rescue sled" width="900" height="700" loading="lazy"/><div class="stat"><strong>360°</strong><span>{lang==='nl'?'Van aankoop en onderhoud tot opleiding en certificering':'From purchase and maintenance to training and certification'}</span></div></div></div></section>
  <section class="audience"><div class="container"><p>{lang==='nl'?'Voor organisaties die voorbereid moeten zijn op het water':'For organisations that must be ready on the water'}</p><div>{audiences.map(item=><span>{item}</span>)}</div></div></section>
  <section class="benefits section"><div class="container"><div class="section-head"><div><p class="eyebrow">{lang==='nl'?'Operationeel voordeel':'Operational advantage'}</p><h2>{lang==='nl'?'Gebouwd voor de inzet.':'Built for the mission.'}</h2></div><p class="lead">{lang==='nl'?'Een laag gewicht en geringe diepgang maken transport, tewaterlating en manoeuvreren eenvoudig.':'Low weight and shallow draft simplify transport, launching and manoeuvring.'}</p></div><div class="benefit-grid">{advantages.map((item,i)=><div><span>{String(i+1).padStart(2,'0')}</span><Icon name="check"/><h3>{item}</h3></div>)}</div></div></section>
  <section class="section services"><div class="container"><div class="section-head"><div><p class="eyebrow">{lang==='nl'?'Producten & expertise':'Products & expertise'}</p><h2>{lang==='nl'?'Alles voor een veilige inzet.':'Everything for safe deployment.'}</h2></div></div><div class="service-grid"><a href={r.courses}><img src="/images/training.webp" alt="Training waterredding" width="800" height="600" loading="lazy"/><div><p>01</p><h3>{c.coursesTitle}</h3><span>{c.view} <Icon name="arrow"/></span></div></a><a href={r.equipment}><img src="/images/equipment.webp" alt="Professionele waterreddingsuitrusting" width="800" height="600" loading="lazy"/><div><p>02</p><h3>{c.equipmentTitle}</h3><span>{c.view} <Icon name="arrow"/></span></div></a></div></div></section>
  <section class="updates section"><div class="container updates-grid"><div><div class="section-head"><div><p class="eyebrow">Latest</p><h2>{lang==='nl'?'Actueel':'Updates'}</h2></div><a class="text-link" href={r.updates}>{lang==='nl'?'Alle updates':'All updates'} <Icon name="arrow"/></a></div><div class="news" data-social-feed>{news.map(([date,title,image])=><a href={r.updates}><span class="news-media"><img src={image} alt="" width="240" height="160" loading="lazy"/></span><div><time>{date}</time><h3>{title}</h3></div><Icon name="arrow"/></a>)}</div></div><aside><p class="eyebrow">{lang==='nl'?'Open trainingsdata':'Open training dates'}</p><h2>{lang==='nl'?'Momenteel geen openbare data.':'No public dates at present.'}</h2><p>{lang==='nl'?'Resqprotec plant opleidingen meestal in company met de opdrachtgever. Zodra er open inschrijvingsdata zijn, verschijnen die hier. Een datum voor uw team stemmen we persoonlijk af.':'Resqprotec normally schedules in-company programmes with the client. Open enrolment dates will appear here when available. We can arrange a date for your team personally.'}</p><a class="button light" href={`${r.courses}#aanvragen`}>{lang==='nl'?'Datum afstemmen':'Arrange a date'}<Icon name="arrow"/></a></aside></div></section>
</Layout>
<script>
type FeedItem={text:string;url:string;time:string;image?:string};
const feed=document.querySelector<HTMLElement>('[data-social-feed]');
if(feed) fetch('/api/social-feed?channel=facebook&v=2').then(response=>response.ok?response.json():Promise.reject()).then((data:{items?:FeedItem[]})=>{
  if(!data.items?.length)return;
  const formatter=new Intl.DateTimeFormat(document.documentElement.lang==='nl'?'nl-NL':'en-GB',{day:'numeric',month:'short',year:'numeric'});
  const links=data.items.slice(0,3).map(item=>{
    const link=document.createElement('a');link.href=item.url;link.target='_blank';link.rel='noreferrer';
    const media=document.createElement('span');media.className='news-media';if(item.image){const image=document.createElement('img');image.src=item.image;image.alt='';image.loading='lazy';media.append(image)}link.append(media);const body=document.createElement('div');const time=document.createElement('time');const date=new Date(item.time);time.textContent=Number.isNaN(date.getTime())?'Facebook':formatter.format(date);
    const heading=document.createElement('h3');heading.textContent=item.text.length>105?`${item.text.slice(0,102)}…`:item.text;
    const arrow=document.createElement('span');arrow.textContent='→';arrow.setAttribute('aria-hidden','true');
    body.append(time,heading);link.append(body,arrow);return link;
  });
  feed.replaceChildren(...links);
}).catch(()=>{});
</script>
<style>
.hero{position:relative;min-height:min(780px,calc(100vh - 32px));display:flex;align-items:end;color:#fff;overflow:hidden}.hero>picture,.hero>picture img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,17,24,.85) 0%,rgba(8,17,24,.43) 52%,rgba(8,17,24,.08)),linear-gradient(0deg,rgba(8,17,24,.48),transparent 50%)}.hero-content{position:relative;padding-bottom:clamp(48px,7vw,82px)}.hero h1{max-width:850px}.hero-content>p:not(.eyebrow){max-width:640px;font-size:1.17rem}.hero-actions{display:flex;gap:12px;margin-top:32px}.hero-quality{display:flex;align-items:center;gap:10px;margin-top:20px;color:#dce3e7;font-size:.72rem}.hero-quality img{width:44px;height:44px;object-fit:contain}.client-proof{padding:clamp(50px,6vw,76px) 0;background:#fff;border-bottom:1px solid var(--line)}.client-proof h2{font-size:clamp(2rem,3vw,3rem);margin-bottom:30px}.client-logos{width:100%;overflow:hidden;border:1px solid var(--line)}.client-logos-track{display:flex;width:max-content;animation:client-marquee 34s linear infinite}.client-logo-group{display:flex}.client-logo{flex:0 0 220px;width:220px;height:112px;padding:16px 24px;border-right:1px solid var(--line)}.client-logo span{position:relative;display:block;width:100%;height:100%}.client-logo img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;object-position:center;filter:grayscale(1);opacity:.82}.client-logos:hover .client-logos-track,.client-logos:focus-within .client-logos-track{animation-play-state:paused}@keyframes client-marquee{to{transform:translateX(-50%)}}.quick{display:grid;grid-template-columns:1fr 1fr;background:var(--ink);color:white}.quick>a{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:28px;padding:36px max(28px,calc((100vw - var(--max))/2));padding-right:clamp(24px,5vw,80px);text-decoration:none;border-right:1px solid #36434c}.quick>a:first-child{padding-left:max(28px,calc((100vw - var(--max))/2))}.quick span,.quick p{font-size:.72rem;color:#90a0aa;text-transform:uppercase;letter-spacing:.1em;margin:0}.quick h2{font-size:clamp(1.6rem,2.6vw,2.5rem);margin-top:5px}.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(50px,8vw,110px);align-items:center}.split>div:first-child>p:not(.eyebrow){color:#52616b}.split .text-link{margin-top:22px}.split>div:last-child{position:relative}.split img{aspect-ratio:5/4;object-fit:cover}.stat{position:absolute;left:-40px;bottom:-28px;width:245px;background:var(--red);color:white;padding:22px}.stat strong,.stat span{display:block}.stat strong{font-family:Manrope,sans-serif;font-size:2.1rem}.stat span{font-size:.75rem}.audience{padding:38px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.audience .container{display:grid;grid-template-columns:.8fr 2fr;gap:40px;align-items:center}.audience p{font-weight:700}.audience .container>div{display:flex;flex-wrap:wrap;gap:8px}.audience span{padding:8px 12px;background:var(--mist);font-size:.8rem;font-weight:600}.benefits{background:var(--mist)}.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #c8d1d6;border-left:1px solid #c8d1d6}.benefit-grid>div{min-height:190px;padding:24px;border-right:1px solid #c8d1d6;border-bottom:1px solid #c8d1d6;display:grid;grid-template-columns:1fr auto;align-content:space-between}.benefit-grid span{color:var(--steel);font-size:.72rem}.benefit-grid h3{grid-column:1/-1;max-width:280px}.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.service-grid>a{position:relative;min-height:500px;overflow:hidden;color:white;text-decoration:none}.service-grid img{position:absolute;width:100%;height:100%;object-fit:cover}.service-grid>a:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(8,17,24,.9),rgba(8,17,24,.02) 65%)}.service-grid a>div{position:absolute;z-index:1;left:34px;right:34px;bottom:30px}.service-grid p{font-size:.72rem;letter-spacing:.1em}.service-grid h3{font-size:2.15rem}.service-grid span{display:flex;align-items:center;gap:10px;margin-top:14px;font-size:.78rem;text-transform:uppercase}.updates{background:#111c24;color:#fff}.updates-grid{display:grid;grid-template-columns:1.55fr .8fr;gap:70px}.news :global(a){display:grid;grid-template-columns:118px minmax(0,1fr) auto;align-items:center;min-width:0;gap:20px;padding:14px 0;overflow:hidden;border-top:1px solid #3a4851;text-decoration:none}.news :global(a:last-child){border-bottom:1px solid #3a4851}.news :global(.news-media){position:relative;display:block;width:118px;height:78px;overflow:hidden;background:#263640}.news :global(.news-media img){position:absolute;inset:0;display:block;width:100%;height:100%;max-width:100%;object-fit:contain}.news :global(a>div){min-width:0}.news :global(time){font-size:.72rem;color:#91a0aa;text-transform:uppercase}.news :global(h3){font-size:1.2rem;margin-top:4px;overflow-wrap:anywhere}.updates aside{background:var(--red);padding:42px}.updates aside .eyebrow{color:white;opacity:.8}.updates aside h2{font-size:2.35rem}.updates aside p{color:#ffe7e8}.updates aside .button{margin-top:20px}@media(max-width:800px){.hero{min-height:700px}.hero-actions{flex-direction:column;align-items:stretch}.quick{grid-template-columns:1fr}.quick>a{padding:25px 20px!important;border-bottom:1px solid #36434c}.split,.updates-grid,.audience .container{grid-template-columns:1fr}.stat{left:0}.benefit-grid{grid-template-columns:1fr 1fr}.service-grid{grid-template-columns:1fr}.service-grid>a{min-height:390px}.updates-grid{gap:45px}}@media(max-width:640px){.client-logo{flex-basis:170px;width:170px;height:94px;padding:12px}.client-proof h2{margin-bottom:22px}}@media(prefers-reduced-motion:reduce){.client-logos{overflow-x:auto}.client-logos-track{animation:none}.client-logo-group[aria-hidden="true"]{display:none}}@media(max-width:520px){.benefit-grid{grid-template-columns:1fr}.news a{grid-template-columns:86px 1fr auto}.news :global(a){grid-template-columns:86px minmax(0,1fr) auto;gap:12px}.news :global(.news-media){width:86px;height:72px}.updates aside{padding:28px}}
</style>
