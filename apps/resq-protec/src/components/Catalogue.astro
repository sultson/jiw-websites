---
import Layout from './Layout.astro'; import Icon from './Icon.astro'; import LeadForm from './LeadForm.astro';
import { copy,routes,type Lang } from '../data/content'; import {getCourses,getProducts} from '../data/catalogues';
const {lang='nl',kind}=Astro.props as {lang:Lang;kind:'courses'|'equipment'}; const c=copy[lang],r=routes[lang];
const isCourses=kind==='courses'; const courses=getCourses(lang); const products=getProducts(lang);
const categories=[...new Set((isCourses?courses:products).map(x=>x.category))];
const title=isCourses?c.coursesTitle:c.equipmentTitle; const intro=isCourses?c.coursesIntro:c.equipmentIntro; const path=isCourses?r.courses:r.equipment;
const itemNames=isCourses?courses.map(x=>x.title):products.map(x=>x.name);
const t=lang==='nl'?{category:'Categorie',courses:'opleidingen',products:'producten',details:'Details bekijken',hide:'Details sluiten',source:'Bekijk bronpagina',duration:'Duur',audience:'Doelgroep',availability:'Beschikbaarheid',available:'Op aanvraag; wij controleren uitvoering, maat en levertijd.',specs:'Productinformatie'}:{category:'Category',courses:'courses',products:'products',details:'View details',hide:'Close details',source:'View source page',duration:'Duration',audience:'Audience',availability:'Availability',available:'On request; we confirm model, size and lead time.',specs:'Product information'};
const training=lang==='nl'?{
  caption:'Instructie op het water',
  title:'Praktijkgericht trainen.',
  text:'Deelnemers krijgen uitleg, oefenen manoeuvres en passen die direct toe op het water.',
  coaching:'Persoonlijke coaching',
  practice:'Oefenen onder begeleiding',
}:{
  caption:'Instruction on the water',
  title:'Practical training.',
  text:'Participants receive instruction, practise manoeuvres and apply them directly on the water.',
  coaching:'Personal coaching',
  practice:'Supervised practice',
};
---
<Layout lang={lang} title={`${title} | Rescue Watercraft`} description={intro} canonicalPath={path}>
  <header class:list={['page-hero',isCourses&&'training-hero']}><div class:list={['container',isCourses&&'training-hero-grid']}><div><div class="crumb">Rescue Watercraft / {title}</div><p class="eyebrow">{isCourses?(lang==='nl'?'Vakbekwaamheid':'Professional competence'):(lang==='nl'?'Professioneel materieel':'Professional equipment')}</p><h1>{title}</h1><p class="lead">{intro}</p></div>{isCourses&&<figure class="training-hero-media"><img src="/images/training-instruction.webp" alt={lang==='nl'?'Instructeur geeft uitleg aan deelnemers bij een reddingswaterscooter':'Instructor briefing participants beside a rescue watercraft'} width="1200" height="1600" fetchpriority="high"/><figcaption>{training.caption}</figcaption></figure>}</div></header>
  {isCourses&&<section class="training-story"><div class="container training-story-grid"><div class="training-story-copy"><h2>{training.title}</h2><p class="lead">{training.text}</p></div><div class="training-story-media"><figure><img src="/images/training-coaching.webp" alt={lang==='nl'?'Instructeur coacht een deelnemer vanaf de reddingswaterscooter':'Instructor coaching a participant from the rescue watercraft'} width="1200" height="1600" loading="lazy"/><figcaption>{training.coaching}</figcaption></figure><figure><img src="/images/training-practice.webp" alt={lang==='nl'?'Deelnemer oefent varen op een reddingswaterscooter onder begeleiding':'Participant practising on a rescue watercraft under supervision'} width="1200" height="1600" loading="lazy"/><figcaption>{training.practice}</figcaption></figure></div></div></section>}
  <section class="catalogue section"><div class="container"><div class="tools"><label><span>{c.search}</span><input type="search" placeholder={lang==='nl'?'Zoek in het aanbod…':'Search the catalogue…'} data-search /></label><label><span>{t.category}</span><select data-category><option value="">{c.all}</option>{categories.map(x=><option value={x}>{x}</option>)}</select></label><span class="count"><strong data-count>{isCourses?courses.length:products.length}</strong> {isCourses?t.courses:t.products}</span></div>
    <div class:list={['cards',!isCourses&&'products']} data-grid>
      {isCourses?courses.map((course,i)=><article data-item data-category={course.category} data-text={`${course.title} ${course.category} ${course.summary}`.toLowerCase()}><img class="course-image" src={course.image} alt={course.title} width="900" height="600" loading="lazy"/><div class="card-body"><div class="card-top"><span>{String(i+1).padStart(2,'0')}</span><span>{course.category}</span></div><h2>{course.title}</h2><p>{course.summary}</p><div class="meta">{(course.details.Duur||course.details.Duration)&&<span><Icon name="clock" size={19}/><span><b>{t.duration}</b>{course.details.Duur??course.details.Duration}</span></span>}{(course.details.Doelgroep||course.details.Audience)&&<span><Icon name="users" size={19}/><span><b>{t.audience}</b>{course.details.Doelgroep??course.details.Audience}</span></span>}</div><details><summary>{t.details}</summary><dl>{Object.entries(course.details).filter(([key])=>!['Bron','Doel','Doelgroep','Duur','Audience','Duration'].includes(key)).map(([key,value])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl>{course.source&&<a class="source" href={course.source} target="_blank" rel="noreferrer">{t.source}<Icon name="arrow"/></a>}</details><a class="request" href="#aanvragen" data-subject={course.title}>{c.request}<Icon name="arrow"/></a></div></article>):products.map(product=><article data-item data-category={product.category} data-text={`${product.name} ${product.category} ${product.summary}`.toLowerCase()}><div class="product-image"><img src={product.image} alt={product.name} width="900" height="900" loading="lazy"/></div><div class="product-body"><p class="product-category">{product.category}</p><h2>{product.name}</h2><p class="product-summary">{product.summary}</p><details><summary>{t.details}</summary><h3>{t.specs}</h3><ul>{product.specifications.map(spec=><li>{spec}</li>)}</ul><p><strong>{t.availability}</strong><br/>{t.available}</p><a class="source" href={product.url} target="_blank" rel="noreferrer">{t.source}<Icon name="arrow"/></a></details><a class="request" href="#aanvragen" data-subject={product.name}>{c.request}<Icon name="arrow"/></a></div></article>)}
    </div><p class="empty" data-empty hidden>{c.noResults}</p></div></section>
  <section class="request-section section" id="aanvragen"><div class="container request-grid"><div><p class="eyebrow">{c.request}</p><h2>{isCourses?(lang==='nl'?'Bespreek uw opleidingsvraag.':'Discuss your training needs.'):(lang==='nl'?'Vraag equipment aan.':'Request equipment.')}</h2><p class="lead">{lang==='nl'?'U ontvangt persoonlijk advies over de oplossing die past bij uw organisatie, team en operationele inzet.':'Receive personal advice on the solution that fits your organisation, team and operation.'}</p></div><LeadForm lang={lang} kind={isCourses?'course':'equipment'} items={itemNames} turnstile={!isCourses}/></div></section>
</Layout>
<script>
const search=document.querySelector<HTMLInputElement>('[data-search]');const category=document.querySelector<HTMLSelectElement>('[data-category]');const items=[...document.querySelectorAll<HTMLElement>('[data-item]')];const count=document.querySelector('[data-count]');const empty=document.querySelector<HTMLElement>('[data-empty]');const filter=()=>{const q=(search?.value||'').trim().toLowerCase();const cat=category?.value||'';let shown=0;items.forEach(item=>{const visible=(!q||(item.dataset.text||'').includes(q))&&(!cat||item.dataset.category===cat);item.hidden=!visible;if(visible)shown++;});if(count)count.textContent=String(shown);if(empty)empty.hidden=shown>0;};const initial=new URLSearchParams(location.search).get('category');if(initial&&category&&[...category.options].some(o=>o.value===initial))category.value=initial;search?.addEventListener('input',filter);category?.addEventListener('change',filter);filter();document.querySelectorAll<HTMLElement>('[data-subject]').forEach(link=>link.addEventListener('click',()=>{const select=document.querySelector<HTMLSelectElement>('select[name=subject]');if(select)select.value=link.dataset.subject||'';}));
</script>
<style>
.training-hero{padding-bottom:clamp(58px,7vw,86px)}.training-hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(320px,.7fr);align-items:center;gap:clamp(48px,8vw,110px)}.training-hero-media{position:relative;margin:0;aspect-ratio:4/5;max-height:620px;overflow:hidden;background:#d7dee2}.training-hero-media img{width:100%;height:100%;object-fit:cover;object-position:50% 58%}.training-hero-media figcaption,.training-story-media figcaption{display:flex;align-items:center;gap:9px;color:var(--steel);font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.training-hero-media figcaption{position:absolute;right:0;bottom:0;padding:11px 14px;background:#fff;color:var(--ink)}.training-hero-media figcaption:before,.training-story-media figcaption:before{content:'';width:16px;height:2px;background:var(--red)}.training-story{padding:clamp(56px,7vw,88px) 0;border-bottom:1px solid var(--line)}.training-story-grid{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);align-items:center;gap:clamp(46px,8vw,108px)}.training-story-copy h2{max-width:540px}.training-story-copy .lead{max-width:560px}.training-story-media{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.training-story-media figure{margin:0}.training-story-media img{width:100%;height:clamp(320px,36vw,440px);object-fit:cover}.training-story-media figure:first-child img{object-position:50% 56%}.training-story-media figure:last-child img{object-position:50% 52%}.training-story-media figcaption{margin-top:12px}
.tools{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) auto;align-items:end;gap:18px;margin-bottom:42px;padding-bottom:28px;border-bottom:1px solid var(--line)}.tools label{display:grid;min-width:0;gap:7px}.tools label span{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.tools input,.tools select{width:100%;min-width:0;height:48px;border:1px solid var(--line);padding:0 14px;background:white}.count{padding-bottom:12px;font-size:.83rem;color:var(--steel)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:start}.cards article{display:flex;flex-direction:column;min-width:0;min-height:560px;border:1px solid var(--line);background:white;overflow:hidden}.course-image{width:100%;height:205px;object-fit:cover}.card-body,.product-body{min-width:0;padding:22px;display:flex;flex:1;flex-direction:column}.card-top{display:flex;justify-content:space-between;gap:20px;color:var(--steel);font-size:.67rem;text-transform:uppercase;letter-spacing:.07em}.card-top span:last-child{text-align:right}.cards h2{font-size:1.45rem;margin:20px 0 12px;overflow-wrap:anywhere}.card-body>p,.product-summary{color:#5c6972;font-size:.88rem}.meta{display:grid;gap:10px;margin:8px 0 16px}.meta span{font-size:.75rem;color:#66737c}.meta b{display:block;color:var(--ink);text-transform:uppercase;letter-spacing:.06em}.cards details{min-width:0;margin:4px 0 20px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.cards summary{padding:13px 0;cursor:pointer;font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em}.cards dl{margin:0 0 16px}.cards dl div{margin-bottom:12px}.cards dt,.cards details h3{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em}.cards dd{margin:2px 0 0;color:#5c6972;font-size:.82rem;overflow-wrap:anywhere}.cards details ul,.cards details p{padding-left:18px;color:#5c6972;font-size:.82rem}.cards .source,.cards .request{display:flex;align-items:center;gap:9px;font-size:.73rem;font-weight:700;text-transform:uppercase;text-decoration:none}.cards .source{margin:14px 0}.cards .request{margin-top:auto}.cards a:hover{color:var(--red)}.products{grid-template-columns:repeat(4,1fr)}.products article{min-height:520px}.products .product-image{height:210px;background:var(--mist);display:grid;place-items:center;overflow:hidden}.products .product-image img{width:100%;height:100%;object-fit:contain;padding:12px}.product-category{margin:0;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em}.request-section{background:var(--mist)}.request-grid{display:grid;grid-template-columns:.8fr 1fr;gap:clamp(50px,9vw,120px)}.empty{text-align:center;padding:50px}.catalogue [hidden]{display:none}@media(max-width:1000px){.cards,.products{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.tools{grid-template-columns:minmax(0,1fr)}.count{padding:0}.cards,.products,.request-grid{grid-template-columns:minmax(0,1fr)}.cards article{min-height:0}}
.meta{gap:11px;margin:12px 0 18px}.meta>span{display:grid;grid-template-columns:20px minmax(0,1fr);align-items:start;gap:9px;color:#66737c;font-size:.75rem;line-height:1.45}.meta>span>svg{margin-top:1px;color:var(--red)}.meta>span>span{min-width:0}.meta b{margin-bottom:1px;font-size:.69rem;letter-spacing:.07em}
@media(max-width:900px){.training-hero-grid,.training-story-grid{grid-template-columns:1fr}.training-hero-media{aspect-ratio:4/3;max-height:none}.training-story-copy h2,.training-story-copy .lead{max-width:720px}.training-story-media img{height:280px}}@media(max-width:560px){.training-story{padding:42px 0}.training-story-copy h2{font-size:2rem}.training-story-copy .lead{margin-top:14px}.training-story-media{grid-template-columns:1fr;gap:0}.training-story-media figure:last-child{display:none}.training-story-media img{height:auto;aspect-ratio:16/10}.training-story-media figcaption{display:none}}
</style>
