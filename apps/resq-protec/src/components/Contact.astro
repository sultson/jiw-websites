---
import Layout from './Layout.astro'; import LeadForm from './LeadForm.astro'; import Icon from './Icon.astro'; import {copy,routes,type Lang} from '../data/content';
const {lang='nl'}=Astro.props as {lang:Lang};const c=copy[lang],r=routes[lang];
---
<Layout lang={lang} title={`${c.contactTitle} | Resqprotec`} description={c.contactIntro} canonicalPath={r.contact}>
<header class="page-hero"><div class="container"><div class="crumb">Resqprotec / {c.contactTitle}</div><p class="eyebrow">{lang==='nl'?'Persoonlijk advies':'Personal advice'}</p><h1>{lang==='nl'?'Samen voorbereid op iedere waterredding.':'Prepared together for every water rescue.'}</h1><p class="lead">{c.contactIntro}</p></div></header>
<section class="section"><div class="container contact-grid"><div class="details"><p class="eyebrow">Resqprotec B.V.</p><h2>{lang==='nl'?'Neem direct contact op.':'Contact us directly.'}</h2><div class="contact-links"><a href="tel:+31613365840"><Icon name="phone"/><span><small>{lang==='nl'?'Telefoon':'Phone'}</small>+31 6 133 658 40</span></a><a href="mailto:info@resqprotec.com"><Icon name="mail"/><span><small>E-mail</small>info@resqprotec.com</span></a></div><address>Bellefleurstraat 32<br/>6515 BJ Nijmegen<br/>{lang==='nl'?'Nederland':'The Netherlands'}</address><p class="business">KVK 09163292<br/>BTW NL 001884832B42</p></div><div class="form-card"><LeadForm lang={lang} kind="contact" /></div></div></section>
<section class="photo"><img src="/images/contact.webp" alt={lang==='nl'?'Professionals tijdens een Rescue Watercraft oefening':'Professionals during Rescue Watercraft training'} width="1920" height="700" loading="lazy"/></section>
</Layout>
<style>.contact-grid{display:grid;grid-template-columns:.75fr 1fr;gap:clamp(50px,9vw,130px)}.details h2{max-width:460px}.contact-links{margin:38px 0}.contact-links a{display:flex;align-items:center;gap:18px;padding:20px 0;border-top:1px solid var(--line);text-decoration:none;font-size:1.05rem;font-weight:600}.contact-links a:last-child{border-bottom:1px solid var(--line)}.contact-links small{display:block;color:var(--steel);font-size:.65rem;text-transform:uppercase;letter-spacing:.08em}.details address{font-style:normal}.business{color:var(--steel);font-size:.78rem}.form-card{padding:clamp(24px,4vw,48px);background:var(--mist)}.photo{height:min(50vw,620px)}.photo img{width:100%;height:100%;object-fit:cover}@media(max-width:760px){.contact-grid{grid-template-columns:1fr}.form-card{margin-inline:-14px}}</style>
