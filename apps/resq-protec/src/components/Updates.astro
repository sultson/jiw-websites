---
import Layout from './Layout.astro';
import Icon from './Icon.astro';
import { routes, type Lang } from '../data/content';
const { lang='nl' }=Astro.props as {lang:Lang};
const r=routes[lang];
const fallback=lang==='nl'?
  [{date:'29 oktober 2022',title:'Samenwerking met TOHATSU Nederland',image:'/images/updates/img_2419.webp'},{date:'12 december 2020',title:'Veiligheidstraining voor K3 Delta',image:'/images/updates/img_2560.webp'},{date:'29 november 2020',title:'NIKTA-gecertificeerd opleidingscentrum',image:'/images/updates/img_2642.webp'}]:
  [{date:'29 October 2022',title:'Partnership with TOHATSU Netherlands',image:'/images/updates/img_2419.webp'},{date:'12 December 2020',title:'Safety training for K3 Delta',image:'/images/updates/img_2560.webp'},{date:'29 November 2020',title:'NIKTA-certified training centre',image:'/images/updates/img_2642.webp'}];
---
<Layout lang={lang} title={`${lang==='nl'?'Actueel':'Updates'} | Rescue Watercraft`} description={lang==='nl'?'Nieuws, trainingen en praktijkmomenten van Rescue Watercraft.':'News, training and field updates from Rescue Watercraft.'} canonicalPath={r.updates}>
  <header class="updates-hero"><div class="container"><h1>{lang==='nl'?'Actueel':'Updates'}</h1></div></header>
  <section class="updates-section"><div class="container"><div class="feed" data-updates-feed>{fallback.map(item=><article><div class="feed-media"><img src={item.image} alt="" width="1200" height="800" loading="lazy"/></div><div><time>{item.date}</time><p class="feed-copy">{item.title}</p><a class="post-link" href="https://www.facebook.com/resqprotec" target="_blank" rel="noreferrer">{lang==='nl'?'Bekijk':'View'} <Icon name="arrow" size={17}/></a></div></article>)}</div></div></section>
</Layout>
<script>
type FeedItem={text:string;url:string;time:string;image?:string};
const feed=document.querySelector<HTMLElement>('[data-updates-feed]');
const cleanPostCopy=(text:string)=>text.replace(/https?:\/\/\S+/gi,'').replace(/\s+/g,' ').trim();
const extractPostUrl=(text:string)=>(text.match(/https?:\/\/[^\s]+/i)?.[0]??'').replace(/[),.!?]+$/,'');
const compactUrl=(value:string)=>{try{const url=new URL(value);const label=`${url.hostname.replace(/^www\./,'')}${decodeURIComponent(url.pathname).replace(/\/$/,'')}`;return label.length>76?`${label.slice(0,73)}…`:label;}catch{return value;}};
if(feed)fetch('/api/social-feed?channel=facebook&v=2').then(response=>response.ok?response.json():Promise.reject()).then((data:{items?:FeedItem[]})=>{
  if(!data.items?.length)return;const locale=document.documentElement.lang==='nl'?'nl-NL':'en-GB';
  const cards=data.items.map(item=>{const article=document.createElement('article');const media=document.createElement('div');media.className='feed-media';if(item.image){const image=document.createElement('img');image.alt='';image.loading='lazy';image.addEventListener('error',()=>image.remove());image.src=item.image;media.append(image)}article.append(media);
    const body=document.createElement('div');const time=document.createElement('time');const date=new Date(item.time);time.textContent=Number.isNaN(date.getTime())?'Facebook':new Intl.DateTimeFormat(locale,{day:'numeric',month:'long',year:'numeric'}).format(date);body.append(time);const cleaned=cleanPostCopy(item.text);if(cleaned){const copy=document.createElement('p');copy.className='feed-copy';copy.textContent=cleaned.length>260?`${cleaned.slice(0,257)}…`:cleaned;body.append(copy)}const sourceUrl=extractPostUrl(item.text);if(sourceUrl){const source=document.createElement('a');source.className='post-source';source.href=sourceUrl;source.target='_blank';source.rel='noreferrer';source.textContent=compactUrl(sourceUrl);body.append(source)}if(!cleaned&&!sourceUrl){const copy=document.createElement('p');copy.className='feed-copy';copy.textContent=document.documentElement.lang==='nl'?'Bekijk de update.':'View the update.';body.append(copy)}const link=document.createElement('a');link.className='post-link';link.href=item.url;link.target='_blank';link.rel='noreferrer';link.textContent=document.documentElement.lang==='nl'?'Bekijk →':'View →';body.append(link);article.append(body);return article;});feed.replaceChildren(...cards);
}).catch(()=>{});
</script>
<style>
.updates-hero{padding:clamp(38px,5vw,64px) 0;background:var(--mist);border-bottom:1px solid var(--line)}.updates-hero h1{font-size:clamp(2.8rem,5vw,4.7rem)}.updates-section{padding:clamp(48px,7vw,88px) 0}.feed{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;align-items:start}.feed :global(article){min-width:0;display:flex;align-self:stretch;flex-direction:column;overflow:hidden;border:1px solid var(--line);background:#fff}.feed :global(.feed-media){position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:linear-gradient(135deg,#243542,#101820)}.feed :global(.feed-media)::before{content:'RW';position:absolute;inset:0;display:grid;place-items:center;color:#506470;font-size:1rem;font-weight:700;letter-spacing:.18em}.feed :global(.feed-media img){position:absolute;z-index:1;inset:0;display:block;width:100%;height:100%;max-width:100%;object-fit:cover}.feed :global(article>div:not(.feed-media)){min-width:0;padding:24px;display:flex;flex:1;flex-direction:column}.feed :global(time){font-size:.72rem;color:var(--steel);text-transform:uppercase;letter-spacing:.07em}.feed :global(.feed-copy){display:-webkit-box;margin:12px 0 20px;overflow:hidden;color:#34454f;font-size:1rem;font-weight:500;line-height:1.55;overflow-wrap:anywhere;-webkit-box-orient:vertical;-webkit-line-clamp:7}.feed :global(.post-source){display:block;margin:10px 0 20px;color:var(--steel);font-size:.72rem;font-weight:500;line-height:1.45;text-decoration:underline;text-decoration-color:#aab7bf;text-underline-offset:3px;overflow-wrap:anywhere}.feed :global(.post-link){display:inline-flex;align-items:center;gap:8px;margin-top:auto;font-size:.72rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;text-decoration:none}@media(max-width:900px){.feed{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.updates-hero{padding:30px 0}.updates-hero h1{font-size:2.7rem}.updates-section{padding:36px 0}.feed{grid-template-columns:minmax(0,1fr)}.feed :global(article){display:grid;grid-template-columns:108px minmax(0,1fr)}.feed :global(.feed-media){height:100%;min-height:156px;aspect-ratio:auto}.feed :global(article>div:not(.feed-media)){padding:18px}.feed :global(.feed-copy){margin:8px 0 14px;font-size:.92rem;-webkit-line-clamp:4}.feed :global(.post-source){margin:7px 0 14px;font-size:.68rem}}
</style>
