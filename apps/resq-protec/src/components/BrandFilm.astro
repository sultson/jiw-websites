---
import { pick, type Lang } from '../data/content';
const { lang }=Astro.props as {lang:Lang};
const t=(nl:string,en:string,de:string)=>pick(lang,nl,en,de);
---
<section class="brandfilm" id="film" aria-labelledby="brandfilm-title">
  <div class="container">
    <div class="film-head">
      <h2 id="brandfilm-title">{t('Zie ons in actie.','See us in action.','Sehen Sie uns im Einsatz.')}</h2>
      <svg class="film-arrow" viewBox="0 0 120 90" aria-hidden="true"><path d="M6 10c38-6 78 6 92 40 4 10 5 20 4 30"/><path d="m90 70 12 12 10-14"/></svg>
    </div>
    <div class="film-player">
      <video id="brandfilm-player" controls playsinline preload="none" poster="/images/brandfilm-poster-1280.webp?v=20261022" aria-label={t('Rescue Watercraft brandfilm','Rescue Watercraft brand film','Rescue Watercraft Imagefilm')} data-language={lang} width="1920" height="1080">
        <source src="/api/brandfilm" type="video/mp4"/>
        <a href="/api/brandfilm">{t('Bekijk de brandfilm','Watch the brand film','Imagefilm ansehen')}</a>
      </video>
      <button type="button" class="film-sound" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z"/><path class="wave" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"/></svg>{t('Geluid aan','Sound on','Ton an')}</button>
    </div>
  </div>
</section>
<script>
  // Fetched with the player, not imported: an imported stylesheet is render-blocking.
  const loadPlayerCss=()=>new Promise<void>(resolve=>{if(document.querySelector('link[data-vjs]'))return resolve();const link=document.createElement('link');link.rel='stylesheet';link.href='/vendor/video-js-8.23.8.min.css';link.dataset.vjs='';link.onload=link.onerror=()=>resolve();document.head.append(link);});
  const video=document.querySelector<HTMLVideoElement>('#brandfilm-player');
  const frame=document.querySelector<HTMLElement>('.film-player');
  if(video&&frame){
    // Keep native controls available until the enhanced player is ready.
    let enhancing:Promise<void>|undefined;
    const enhance=()=>enhancing??=(async()=>{
      try{
        const [{default:videojs}]=await Promise.all([import('video.js'),loadPlayerCss()]);
        const [{default:dutch},{default:german}]=await Promise.all([import('video.js/dist/lang/nl.json'),import('video.js/dist/lang/de.json')]);
        videojs.addLanguage('nl',dutch);videojs.addLanguage('de',german);
        video.classList.add('video-js','vjs-big-play-centered');
        const player=videojs(video,{controls:true,autoplay:false,preload:'none',fluid:true,aspectRatio:'16:9',responsive:true,language:video.dataset.language,playbackRates:[0.75,1,1.25,1.5],controlBar:{volumePanel:{inline:false}},userActions:{hotkeys:true}});
        await new Promise<void>(resolve=>player.ready(()=>resolve()));
      }catch{video.controls=true;}
    })();
    // Plays muted while in view, stops once fully scrolled away. A pause the visitor makes sticks until they press play again.
    const quiet=matchMedia('(prefers-reduced-motion: reduce)').matches||(navigator as Navigator&{connection?:{saveData?:boolean}}).connection?.saveData===true;
    let ours=false,held=false,started=false,rolling=false,visible=false;
    // Only a pause after real playback counts as the visitor's; an aborted play() also fires one.
    video.addEventListener('playing',()=>{rolling=true;held=false;});
    video.addEventListener('pause',()=>{if(rolling&&!ours&&!video.ended)held=true;ours=false;rolling=false;});
    const start=async()=>{
      await enhance();
      if(held||!video.paused)return;
      if(!started){video.muted=true;started=true;}
      video.play().catch(()=>{setTimeout(()=>{if(visible&&video.paused&&!held)video.play().catch(()=>{});},400);});
    };
    const sound=frame.querySelector<HTMLButtonElement>('.film-sound')!;
    const syncSound=()=>{sound.hidden=!(video.muted&&started);};
    video.addEventListener('volumechange',syncSound);video.addEventListener('playing',syncSound);
    sound.addEventListener('click',()=>{video.muted=false;if(video.paused)video.play().catch(()=>{});});
    const stop=()=>{if(!video.paused){ours=true;video.pause();}};
    if('IntersectionObserver' in window){
      new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting))void enhance();},{rootMargin:'300px'}).observe(frame);
      if(!quiet)new IntersectionObserver(entries=>{for(const entry of entries){visible=entry.intersectionRatio>=.5;if(visible)void start();else if(!entry.isIntersecting)stop();}},{threshold:[0,.5]}).observe(frame);
    }else{void enhance();}
  }
</script>
<style>
.brandfilm{padding:clamp(48px,6vw,84px) 0;background:var(--mist)}
.film-head{position:relative;width:min(100%,960px);margin:0 auto clamp(22px,3vw,34px);padding-right:110px}
.film-head h2{font-size:clamp(2.3rem,5vw,4.2rem);font-style:italic;letter-spacing:-.03em}
.film-arrow{position:absolute;right:8px;bottom:-30px;width:clamp(70px,9vw,104px);height:auto;fill:none;stroke:var(--green-deep);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
.film-player{position:relative;width:min(100%,960px);margin-inline:auto;aspect-ratio:16/9;background:#000;border:1px solid #34352c}
.film-player>video{display:block;width:100%;height:100%;object-fit:contain}
.film-sound{position:absolute;z-index:5;top:14px;right:14px;display:inline-flex;align-items:center;gap:9px;padding:9px 14px 9px 11px;border:0;background:var(--green);color:var(--ink);font-size:.74rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background .15s}
.film-sound:hover{background:#fff}
.film-sound:focus-visible{outline:2px solid #fff;outline-offset:2px}
.film-sound[hidden]{display:none}
.film-sound svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.film-sound svg path:first-child{fill:currentColor}
.film-player :global(.video-js){width:100%;font-family:var(--text);color:#fff}.film-player :global(.vjs-poster img){object-fit:cover}.film-player :global(.vjs-big-play-button){width:72px;height:72px;line-height:68px;border:2px solid var(--green);border-radius:50%;background:#0a0b07cc;margin-left:-36px;margin-top:-36px;color:var(--green)}.film-player :global(.vjs-control-bar){background:#0a0b07eb}.film-player :global(.vjs-play-progress),.film-player :global(.vjs-volume-level){background:var(--green)}.film-player :global(button:focus-visible){outline:2px solid var(--green);outline-offset:-2px}
@media(max-width:800px){.film-player :global(.vjs-control){min-width:32px}.film-player :global(.vjs-control-bar){font-size:12px}.film-head{padding-right:0}.film-arrow{display:none}.film-sound{top:10px;right:10px;padding:8px 12px 8px 9px}}
</style>
