---
import '../styles/global.css'; import Icon from './Icon.astro'; import { copy,routes,type Lang } from '../data/content';
const {lang='nl',title,description,canonicalPath='',image='/images/hero.webp?v=20260829'}=Astro.props as {lang?:Lang;title:string;description:string;canonicalPath?:string;image?:string};
const c=copy[lang],r=routes[lang],opposite=lang==='nl'?'en':'nl';const navRoutes=[r.home,r.courses,r.equipment,r.updates,r.contact];
const alternateMap:Record<string,string>={'/':'/en','/opleidingen-en-trainingen':'/en/courses-and-training','/equipment':'/en/equipment','/actueel':'/en/updates','/contact':'/en/contact','/en':'/','/en/courses-and-training':'/opleidingen-en-trainingen','/en/equipment':'/equipment','/en/updates':'/actueel','/en/contact':'/contact'};
const site='https://resqprotec.jouwidealewebsite.nl';
const courseMenu=lang==='nl'?['Reddingsdiensten en overheid','Veiligheid, maritiem en industrie','EHBO en BHV']:['Emergency services and government','Safety, maritime and industry','First aid and emergency response'];
const equipmentMenu=lang==='nl'?['Beschermmmiddelen','Droogpakken','Reddingsmaterialen','Helmen']:['Protective equipment','Drysuits','Rescue equipment','Helmets'];
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={`${site}${canonicalPath}`}/><link rel="alternate" hreflang={opposite} href={`${site}${alternateMap[canonicalPath]??'/en'}`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={`${site}${image}`}/><meta property="og:type" content="website"/><meta name="theme-color" content="#0f0f0f"/><link rel="icon" href="/favicon.svg?v=20260828" type="image/svg+xml"/><link rel="icon" href="/favicon.png?v=20260828" type="image/png" sizes="512x512"/><link rel="apple-touch-icon" href="/favicon.png?v=20260828"/><link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/roboto-900.woff2" as="font" type="font/woff2" crossorigin/><script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Rescue Watercraft B.V.',url:site,email:'info@rescuewatercraft.nl',telephone:'+31613365840',address:{'@type':'PostalAddress',streetAddress:'Bellefleurstraat 32',postalCode:'6515 BJ',addressLocality:'Nijmegen',addressCountry:'NL'}})}/></head>
<body><a class="skip" href="#main">{lang==='nl'?'Naar inhoud':'Skip to content'}</a><a class="latest-strip" href={r.updates} data-latest-strip><span>{lang==='nl'?'Bekijk het laatste nieuws van Rescue Watercraft':'See the latest news from Rescue Watercraft'}</span><time></time></a>
<header class="site-header"><div class="header-inner container"><a href={r.home} class="logo" aria-label="Rescue Watercraft home"><img src="/images/logo-rw.svg" alt="Rescue Watercraft" width="5052" height="1351"/></a><nav aria-label={lang==='nl'?'Hoofdnavigatie':'Main navigation'}><ul><li><a href={r.home}>{c.nav[0]}</a></li><li class="has-menu"><a href={r.courses}>{c.nav[1]} <span aria-hidden="true">⌄</span></a><div class="dropdown">{courseMenu.map(x=><a href={`${r.courses}?category=${encodeURIComponent(x)}`}>{x}</a>)}<a class="all-link" href={r.courses}>{lang==='nl'?'Alle opleidingen bekijken':'View all courses'}</a></div></li><li class="has-menu"><a href={r.equipment}>{c.nav[2]} <span aria-hidden="true">⌄</span></a><div class="dropdown">{equipmentMenu.map(x=><a href={`${r.equipment}?category=${encodeURIComponent(x)}`}>{x}</a>)}<a class="all-link" href={r.equipment}>{lang==='nl'?'Alle equipment bekijken':'View all equipment'}</a></div></li><li><a href={r.updates}>{c.nav[3]}</a></li><li><a href={r.contact}>{c.nav[4]}</a></li></ul></nav><div class="header-actions"><a class="lang" href={alternateMap[canonicalPath]??'/en'}>{opposite.toUpperCase()}</a><a class="contact-button" href={r.contact}>{c.nav[4]} <Icon name="arrow" size={17}/></a><button class="menu-toggle" aria-label={lang==='nl'?'Menu openen':'Open menu'} aria-expanded="false"><Icon name="menu"/></button></div></div><div class="mobile-menu" hidden><nav><ul>{c.nav.map((label,i)=><li><a href={navRoutes[i]}>{label}</a></li>)}</ul></nav><a class="lang-mobile" href={alternateMap[canonicalPath]??'/en'}>{opposite==='en'?'English':'Nederlands'}</a></div></header>
<main id="main"><slot/></main><footer><div class="container footer-grid"><div><img class="footer-logo" src="/images/logo-rw.svg" alt="Rescue Watercraft" width="5052" height="1351"/><p>Advancing Global Water Rescue</p></div><div><h3>{lang==='nl'?'Navigatie':'Navigation'}</h3>{c.nav.map((label,i)=><a href={navRoutes[i]}>{label}</a>)}</div><div><h3>Contact</h3><a href="tel:+31613365840">+31 6 133 658 40</a><a href="mailto:info@rescuewatercraft.nl">info@rescuewatercraft.nl</a><span>Bellefleurstraat 32<br/>6515 BJ Nijmegen</span></div><div><h3>{lang==='nl'?'Kwaliteit & netwerk':'Quality & network'}</h3><div class="quality-logos"><img class="nikta" src="/images/nikta-certificate.webp" alt="NIKTA certified examination centre" width="1500" height="1500"/><img class="ils" src="/images/partners/international-life-saving-federation.webp" alt="International Life Saving Federation" width="500" height="500" loading="lazy"/><img class="ils-europe" src="/images/partners/international-life-saving-federation-europe.webp" alt="International Life Saving Federation of Europe" width="447" height="447" loading="lazy"/></div></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Rescue Watercraft B.V.</span><span>KVK 09163292 · BTW NL 001884832B42</span></div></footer>
<script>const toggle=document.querySelector('.menu-toggle');const menu=document.querySelector<HTMLElement>('.mobile-menu');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));if(menu)menu.hidden=open;});type FeedItem={text:string;url:string;time:string};const strip=document.querySelector<HTMLAnchorElement>('[data-latest-strip]');if(strip)fetch('/api/social-feed?channel=facebook&v=2').then(r=>r.ok?r.json():Promise.reject()).then((data:{items?:FeedItem[]})=>{const item=data.items?.[0];if(!item)return;strip.href=item.url;strip.target='_blank';strip.rel='noreferrer';const span=strip.querySelector('span'),time=strip.querySelector('time');if(span)span.textContent=item.text.length>78?`${item.text.slice(0,75)}…`:item.text;if(time&&item.time){const diff=Math.max(1,Math.floor((Date.now()-new Date(item.time).getTime())/60000));const nl=document.documentElement.lang==='nl';time.textContent=diff<60?`${diff}m${nl?' geleden':' ago'}`:diff<1440?`${Math.floor(diff/60)}u${nl?' geleden':' ago'}`:`${Math.floor(diff/1440)}d${nl?' geleden':' ago'}`;}}).catch(()=>{});</script></body></html>
<style>
.skip{position:absolute;left:-9999px}.skip:focus{left:10px;top:10px;z-index:99;background:white;padding:10px}.latest-strip{height:32px;padding:0 max(20px,calc((100vw - var(--max))/2));display:flex;align-items:center;gap:7px;background:var(--ink-deep);color:#fff;text-decoration:none;font-size:.74rem;white-space:nowrap;overflow:hidden}.latest-strip span{overflow:hidden;text-overflow:ellipsis}.latest-strip:hover span{box-shadow:inset 0 -1px 0 var(--green)}.latest-strip time{color:var(--grey);flex:none}.latest-strip time:not(:empty):before{content:'·';margin-right:7px}.site-header{height:88px;background:#fff;border-bottom:1px solid var(--line);position:relative;z-index:20}.header-inner{height:100%;display:flex;align-items:center;justify-content:space-between}.logo img{width:216px;height:auto}.site-header ul{list-style:none;margin:0;padding:0;display:flex;gap:24px}.site-header nav a{font-size:.73rem;font-weight:600;letter-spacing:.05em;text-decoration:none;text-transform:uppercase;box-shadow:inset 0 -2px 0 transparent;transition:box-shadow .15s}.site-header nav>ul>li>a:hover{box-shadow:inset 0 -2px 0 var(--green)}.has-menu{position:relative}.dropdown{position:absolute;top:100%;left:-18px;width:285px;padding:15px 18px 16px;background:#fff;border:1px solid var(--line);box-shadow:0 14px 30px rgba(15,15,15,.12);visibility:hidden;opacity:0;transform:translateY(8px);transition:opacity .15s,transform .15s;z-index:30}.has-menu:hover .dropdown,.has-menu:focus-within .dropdown{visibility:visible;opacity:1;transform:none}.dropdown a{display:block;padding:9px 0;font-weight:400;text-transform:none!important;letter-spacing:0!important}.dropdown a:hover{box-shadow:inset 0 -2px 0 var(--green)}.dropdown .all-link{margin-top:7px;padding-top:13px;border-top:1px solid var(--line);color:var(--green-ink);font-weight:600}.header-actions{display:flex;align-items:center;gap:18px}.lang{font-size:.75rem;font-weight:600;letter-spacing:.05em;text-decoration:none}.lang:hover{box-shadow:inset 0 -2px 0 var(--green)}.contact-button{height:44px;padding:0 18px;display:flex;align-items:center;gap:10px;background:var(--ink);color:#fff;font-size:.75rem;font-weight:600;letter-spacing:.05em;text-decoration:none;text-transform:uppercase;transition:background .15s,color .15s}.contact-button:hover{background:var(--green);color:var(--ink)}.menu-toggle{display:none;border:0;background:none;padding:10px}.mobile-menu{position:absolute;top:88px;left:0;right:0;background:white;padding:10px 20px 28px;border-bottom:1px solid var(--line)}.mobile-menu nav ul{display:block}.mobile-menu nav a{display:block;padding:16px 0;border-bottom:1px solid var(--line);font-weight:600}.lang-mobile{display:block;margin-top:22px;font-weight:600}footer{background:var(--mist);color:var(--ink);padding:72px 0 24px;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.35fr .7fr;gap:60px}.footer-logo{width:244px;height:auto}.footer-grid p{max-width:330px;color:var(--muted)}.footer-grid h3{font-size:.95rem;letter-spacing:-.005em;margin-bottom:20px}.footer-grid a,.footer-grid span{display:block;margin:8px 0;color:var(--body);text-decoration:none;font-size:.9rem}.footer-grid a:hover{color:var(--ink);box-shadow:inset 0 -1px 0 var(--green)}.nikta{width:96px;height:96px;object-fit:contain}.footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:58px;padding-top:22px;border-top:1px solid var(--line);color:var(--muted);font-size:.76rem}@media(max-width:1100px){.header-inner>nav,.contact-button{display:none}.menu-toggle{display:block}.footer-grid{grid-template-columns:1.5fr 1fr}}@media(max-width:600px){.latest-strip{padding-inline:14px}.site-header{height:74px}.mobile-menu{top:74px}.logo img{width:174px}.footer-grid{grid-template-columns:1fr;gap:30px}.footer-bottom{flex-direction:column}.footer-grid>div:nth-child(2){display:none}}
.quality-logos{display:flex;align-items:center;gap:10px}.quality-logos .nikta,.quality-logos .ils,.quality-logos .ils-europe{width:74px;height:74px;object-fit:contain}@media(min-width:1101px){.footer-grid{grid-template-columns:1.7fr .9fr 1.15fr 1.3fr}}
</style>
