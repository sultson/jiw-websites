---
import '../styles/global.css'; import { getCourses } from '../data/courses'; import { productCategories } from '../data/products'; import Icon from './Icon.astro'; import IntroGate from './IntroGate.astro'; import { copy,routes,langs,langOrder,defaultLang,langNames,alternates,pick,url,SITE,type Lang } from '../data/content';
const {lang='nl',title,description,canonicalPath='',image='/images/hero.webp?v=20260829',schema=[],noindex=false,preload}=Astro.props as {lang?:Lang;title:string;description:string;canonicalPath?:string;image?:string;schema?:Record<string,unknown>[];noindex?:boolean;preload?:{srcset:string;sizes:string}};
const c=copy[lang],r=routes[lang];const navRoutes=[r.home,r.courses,r.equipment,r.updates,r.contact];
const path=canonicalPath||'/';const alt=alternates(path);
const courseMenu=getCourses(lang).map(course=>course.category);
const equipmentMenu=Object.values(productCategories[lang]);
const ogLocale={nl:'nl_NL',en:'en_GB',de:'de_DE'};
const org={'@type':'Organization','@id':`${SITE}/#organization`,name:'Rescue Watercraft B.V.',alternateName:'Rescue Watercraft',url:`${SITE}/`,logo:`${SITE}/images/mail-logo.png`,slogan:'Advancing Global Water Rescue',email:'info@rescuewatercraft.nl',telephone:'+31613365840',vatID:'NL001884832B42',address:{'@type':'PostalAddress',streetAddress:'Bellefleurstraat 32',postalCode:'6515 BJ',addressLocality:'Nijmegen',addressCountry:'NL'},areaServed:'Europe',knowsLanguage:['nl','en','de'],sameAs:['https://www.linkedin.com/company/rescue-watercraft-b-v/'],contactPoint:{'@type':'ContactPoint',contactType:'sales',telephone:'+31613365840',email:'info@rescuewatercraft.nl',availableLanguage:['Dutch','English','German']}};
const website={'@type':'WebSite','@id':`${SITE}/#website`,url:`${SITE}/`,name:'Rescue Watercraft',inLanguage:langs,publisher:{'@id':`${SITE}/#organization`}};
const graph={'@context':'https://schema.org','@graph':[org,website,...schema]};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/>{noindex?<meta name="robots" content="noindex"/>:<link rel="canonical" href={url(path)}/>}{!noindex&&langs.map(l=><link rel="alternate" hreflang={l} href={url(alt[l])}/>)}{!noindex&&<link rel="alternate" hreflang="x-default" href={url(alt[defaultLang])}/>}<meta property="og:site_name" content="Rescue Watercraft"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url(path)}/><meta property="og:image" content={`${SITE}${image}`}/><meta property="og:type" content="website"/><meta property="og:locale" content={ogLocale[lang]}/>{langs.filter(l=>l!==lang).map(l=><meta property="og:locale:alternate" content={ogLocale[l]}/>)}<meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#0f0f0f"/><link rel="icon" href="/favicon.svg?v=20260828" type="image/svg+xml"/><link rel="icon" href="/favicon.png?v=20260828" type="image/png" sizes="512x512"/><link rel="apple-touch-icon" href="/favicon.png?v=20260828"/><link rel="sitemap" type="application/xml" href="/sitemap.xml"/>{preload&&<link rel="preload" as="image" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high"/>}<link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/roboto-900.woff2" as="font" type="font/woff2" crossorigin/><script is:inline type="application/ld+json" set:html={JSON.stringify(graph)}/><script is:inline>/* Microsoft Clarity, cookies off in the project settings so no consent banner. Only on the live host, so local and preview visits stay out of the data. */if(location.hostname==='rescuewatercraft.eu')(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","z26i323f5t");</script></head>
<body><a class="skip" href="#main">{pick(lang,'Naar inhoud','Skip to content','Zum Inhalt')}</a><a class="latest-strip" href={r.updates} data-latest-strip><span>{pick(lang,'Bekijk het laatste nieuws van Rescue Watercraft','See the latest news from Rescue Watercraft','Die neuesten Nachrichten von Rescue Watercraft')}</span><time></time></a>
<header class="site-header"><div class="header-inner container"><a href={r.home} class="logo" aria-label="Rescue Watercraft home"><img src="/images/logo-rw.svg" alt="Rescue Watercraft" width="5052" height="1351"/></a><nav aria-label={pick(lang,'Hoofdnavigatie','Main navigation','Hauptnavigation')}><ul><li><a href={r.home}>{c.nav[0]}</a></li><li class="has-menu"><a href={r.courses}>{c.nav[1]} <span aria-hidden="true">⌄</span></a><div class="dropdown">{courseMenu.map(x=><a href={`${r.courses}?category=${encodeURIComponent(x)}`}>{x}</a>)}<a class="all-link" href={r.courses}>{pick(lang,'Alle opleidingen bekijken','View all courses','Alle Ausbildungen ansehen')}</a></div></li><li class="has-menu"><a href={r.equipment}>{c.nav[2]} <span aria-hidden="true">⌄</span></a><div class="dropdown">{equipmentMenu.map(x=><a href={`${r.equipment}?category=${encodeURIComponent(x)}`}>{x}</a>)}<a class="all-link" href={r.equipment}>{pick(lang,'Alle equipment bekijken','View all equipment','Alle Ausrüstung ansehen')}</a></div></li><li><a href={r.updates}>{c.nav[3]}</a></li><li><a href={r.contact}>{c.nav[4]}</a></li></ul></nav><div class="header-actions"><a class="linkedin" href="https://www.linkedin.com/company/rescue-watercraft-b-v" target="_blank" rel="noreferrer" aria-label={pick(lang,'Rescue Watercraft op LinkedIn','Rescue Watercraft on LinkedIn','Rescue Watercraft auf LinkedIn')}><svg class="li-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a><nav class="langs" aria-label={pick(lang,'Taal','Language','Sprache')}>{langOrder.map(l=><a href={alt[l]} hreflang={l} lang={l} aria-current={l===lang?'true':undefined} title={langNames[l]}>{l.toUpperCase()}</a>)}</nav><a class="contact-button" href={r.contact}>{c.nav[4]} <Icon name="arrow" size={17}/></a><button class="menu-toggle" aria-label={pick(lang,'Menu openen','Open menu','Menü öffnen')} aria-expanded="false"><Icon name="menu"/></button></div></div><div class="mobile-menu" hidden><nav><ul>{c.nav.map((label,i)=><li><a href={navRoutes[i]}>{label}</a></li>)}</ul></nav><div class="lang-mobile">{langOrder.filter(l=>l!==lang).map(l=><a href={alt[l]} hreflang={l} lang={l}>{langNames[l]}</a>)}</div></div></header>
<main id="main"><slot/></main><footer><div class="container footer-grid"><div><img class="footer-logo" src="/images/logo-rw.svg" alt="Rescue Watercraft" width="5052" height="1351"/><p>Advancing Global Water Rescue</p><p class="footer-terms">{c.footerTerms}</p></div><div><h3>{pick(lang,'Navigatie','Navigation','Navigation')}</h3>{c.nav.map((label,i)=><a href={navRoutes[i]}>{label}</a>)}</div><div><h3>Contact</h3><a href="tel:+31613365840">+31 6 133 658 40</a><a href="mailto:info@rescuewatercraft.nl">info@rescuewatercraft.nl</a><a class="footer-linkedin" href="https://www.linkedin.com/company/rescue-watercraft-b-v" target="_blank" rel="noreferrer"><svg class="li-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>LinkedIn</a><span>Bellefleurstraat 32<br/>6515 BJ Nijmegen</span></div><div><h3>{pick(lang,'Kwaliteit & netwerk','Quality & network','Qualität & Netzwerk')}</h3><div class="quality-logos"><img class="ils-europe" src="/images/partners/ils-europe-160.webp" alt="International Life Saving Federation of Europe" width="160" height="160" loading="lazy"/></div></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Rescue Watercraft B.V.</span><span>{pick(lang,'KVK 09163292 · BTW NL 001884832B42','Chamber of Commerce 09163292 · VAT NL 001884832B42','Handelsregister (KVK) 09163292 · USt-IdNr. NL001884832B42')}</span></div></footer>
<IntroGate lang={lang}/>
<script>const toggle=document.querySelector('.menu-toggle');const menu=document.querySelector<HTMLElement>('.mobile-menu');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));if(menu)menu.hidden=open;});type FeedItem={text:string;url:string;time:string};const strip=document.querySelector<HTMLAnchorElement>('[data-latest-strip]');if(strip)fetch('/api/social-feed?channel=linkedin&v=3').then(r=>r.ok?r.json():Promise.reject()).then((data:{items?:FeedItem[]})=>{const item=data.items?.[0];if(!item)return;strip.href=item.url;strip.target='_blank';strip.rel='noreferrer';const span=strip.querySelector('span'),time=strip.querySelector('time');const lang=document.documentElement.lang;const text=item.text||(lang==='nl'?'Bekijk de nieuwste update op LinkedIn':lang==='de'?'Das neueste Update auf LinkedIn ansehen':'View the latest update on LinkedIn');if(span)span.textContent=text.length>78?`${text.slice(0,75)}…`:text;if(time&&item.time){const diff=Math.max(1,Math.floor((Date.now()-new Date(item.time).getTime())/60000));const rtf=new Intl.RelativeTimeFormat(lang,{numeric:'always',style:'short'});time.textContent=diff<60?rtf.format(-diff,'minute'):diff<1440?rtf.format(-Math.floor(diff/60),'hour'):rtf.format(-Math.floor(diff/1440),'day');}}).catch(()=>{});</script></body></html>
<style>
.skip{position:absolute;left:-9999px}.skip:focus{left:10px;top:10px;z-index:99;background:white;padding:10px}.latest-strip{height:32px;padding:0 max(20px,calc((100vw - var(--max))/2));display:flex;align-items:center;gap:7px;background:var(--ink-deep);color:#fff;text-decoration:none;font-size:.74rem;white-space:nowrap;overflow:hidden}.latest-strip span{overflow:hidden;text-overflow:ellipsis}.latest-strip:hover span{box-shadow:inset 0 -1px 0 var(--green)}.latest-strip time{color:var(--grey);flex:none}.latest-strip time:not(:empty):before{content:'·';margin-right:7px}.site-header{height:88px;background:#fff;border-bottom:1px solid var(--line);position:relative;z-index:20}.header-inner{height:100%;display:flex;align-items:center;justify-content:space-between}.logo img{width:216px;height:auto}.site-header ul{list-style:none;margin:0;padding:0;display:flex;gap:24px}.site-header nav a{font-size:.73rem;font-weight:600;letter-spacing:.05em;text-decoration:none;text-transform:uppercase;box-shadow:inset 0 -2px 0 transparent;transition:box-shadow .15s}.site-header nav>ul>li>a:hover{box-shadow:inset 0 -2px 0 var(--green)}.has-menu{position:relative}.dropdown{position:absolute;top:100%;left:-18px;width:285px;padding:15px 18px 16px;background:#fff;border:1px solid var(--line);box-shadow:0 14px 30px rgba(15,15,15,.12);visibility:hidden;opacity:0;transform:translateY(8px);transition:opacity .15s,transform .15s;z-index:30}.has-menu:hover .dropdown,.has-menu:focus-within .dropdown{visibility:visible;opacity:1;transform:none}.dropdown a{display:block;padding:9px 0;font-weight:400;text-transform:none!important;letter-spacing:0!important}.dropdown a:hover{box-shadow:inset 0 -2px 0 var(--green)}.dropdown .all-link{margin-top:7px;padding-top:13px;border-top:1px solid var(--line);color:var(--green-ink);font-weight:600}.header-actions{display:flex;align-items:center;gap:18px}.langs{display:flex;gap:10px}.langs a{font-size:.75rem;font-weight:600;letter-spacing:.05em;text-decoration:none;color:var(--muted)}.langs a[aria-current]{color:var(--ink);box-shadow:inset 0 -2px 0 var(--green)}.langs a:hover{color:var(--ink);box-shadow:inset 0 -2px 0 var(--green)}.contact-button{height:44px;padding:0 18px;display:flex;align-items:center;gap:10px;background:var(--ink);color:#fff;font-size:.75rem;font-weight:600;letter-spacing:.05em;text-decoration:none;text-transform:uppercase;transition:background .15s,color .15s}.contact-button:hover{background:var(--green);color:var(--ink)}.menu-toggle{display:none;border:0;background:none;padding:10px}.mobile-menu{position:absolute;top:88px;left:0;right:0;background:white;padding:10px 20px 28px;border-bottom:1px solid var(--line)}.mobile-menu nav ul{display:block}.mobile-menu nav a{display:block;padding:16px 0;border-bottom:1px solid var(--line);font-weight:600}.lang-mobile{display:flex;gap:22px;margin-top:22px;font-weight:600}.footer-grid p.footer-terms{margin-top:14px;font-size:.78rem;line-height:1.55}footer{background:var(--mist);color:var(--ink);padding:72px 0 24px;border-top:1px solid var(--line)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.35fr .7fr;gap:60px}.footer-logo{width:244px;height:auto}.footer-grid p{max-width:330px;color:var(--muted)}.footer-grid h3{font-size:.95rem;letter-spacing:-.005em;margin-bottom:20px}.footer-grid a,.footer-grid span{display:block;margin:8px 0;color:var(--body);text-decoration:none;font-size:.9rem}.footer-grid a:hover{color:var(--ink);box-shadow:inset 0 -1px 0 var(--green)}.nikta{width:96px;height:96px;object-fit:contain}.footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:58px;padding-top:22px;border-top:1px solid var(--line);color:var(--muted);font-size:.76rem}@media(max-width:1100px){.header-inner>nav,.contact-button{display:none}.menu-toggle{display:block}.footer-grid{grid-template-columns:1.5fr 1fr}}@media(max-width:600px){.latest-strip{padding-inline:14px}.site-header{height:74px}.mobile-menu{top:74px}.logo img{width:174px}.footer-grid{grid-template-columns:1fr;gap:30px}.footer-bottom{flex-direction:column}.footer-grid>div:nth-child(2){display:none}}
.quality-logos{display:flex;align-items:center;gap:10px}.quality-logos .nikta,.quality-logos .ils,.quality-logos .ils-europe{width:74px;height:74px;object-fit:contain}@media(min-width:1101px){.footer-grid{grid-template-columns:1.7fr .9fr 1.15fr 1.3fr}}
.linkedin{display:flex;color:var(--ink);transition:color .15s}.linkedin:hover{color:var(--green-ink)}.footer-grid a.footer-linkedin{display:flex;align-items:center;gap:9px}.footer-linkedin .li-icon{color:#0a66c2}@media(max-width:600px){.linkedin{display:none}}
</style>
