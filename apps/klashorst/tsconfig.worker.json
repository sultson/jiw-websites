{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    // The Worker renders the museum's first screen with the site's own
    // components, so it compiles the site's JSX too.
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["worker"]
}
