{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "klashorst",
  "account_id": "aec64586d4d04a644f4f9b8225d7ca28",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every page a visitor can land on, as well as the API: the Worker has to
    // see the navigation to inline the CMS content into the HTML and to write
    // the blog post's own title and photograph into the head before it is sent.
    // The English site is the same pages one directory in, so it needs the same
    // treatment. /beheer/* too, or the Studio's own routes fall through to the
    // site's SPA handling.
    "run_worker_first": [
      "/",
      "/blog",
      "/blog/*",
      "/en",
      "/en/*",
      "/robots.txt",
      "/sitemap.xml",
      "/api/*",
      "/beheer",
      "/beheer/*"
    ]
  },
  "routes": [
    {
      "pattern": "klashorst.jouwidealewebsite.nl",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "FORM_UPLOADS",
      "bucket_name": "jiw-form-uploads-prod"
    }
  ],
  "send_email": [
    {
      "name": "LEAD_EMAIL",
      "allowed_sender_addresses": ["contact@notify.jouwidealewebsite.nl"]
    }
  ],
  "vars": {
    "SITE_ID": "klashorst",
    // "true" once this replaces klashorstmuseum.nl. Until then every page is
    // noindex and robots.txt disallows everything, so the concept build can
    // never compete with the site it is a proposal for.
    "SITE_INDEXABLE": "false",
    "LEAD_RECIPIENT": "hallo@jouwidealewebsite.nl",
    "LEAD_SENDER": "contact@notify.jouwidealewebsite.nl",
    "TURNSTILE_SECRET_KEY": "dev",
    // Empty would mean the site renders its bundled copy, which is a working
    // site rather than a broken one. Not a secret: it is public read-only.
    "SANITY_PROJECT_ID": "banas90d",
    "SANITY_DATASET": "production",
    // Shared with the Studio's preview tab, so it lives in that bundle too.
    // All it unlocks is unpublished museum copy; the token that reads it is a
    // Worker secret (SANITY_READ_TOKEN) and never leaves the Worker.
    "PREVIEW_KEY": "9ZdDXvc80iVY6m1jvTmvamKW"
  }
}
