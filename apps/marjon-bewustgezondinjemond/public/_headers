# Cloudflare Workers Static Assets leest dit bestand.
#
# De bestanden in /assets/ dragen een hash in hun naam: verandert de inhoud, dan
# verandert de naam, dus ze mogen een jaar blijven staan. De foto's staan onder
# een vaste naam en veranderen zelden; wordt er ooit een vervangen, dan hoort er
# een ?v=JJJJMMDD achter elke verwijzing (zie CLAUDE.md).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/logo-email.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# De downloadpagina met haar logobestanden (scripts/merk-publiceren.mjs). Die
# hoort niet in de zoekresultaten tussen haar echte pagina's: hij is voor haar
# en voor een drukker, niet voor iemand die naar een mondhygiënist zoekt.
# X-Robots-Tag en niet een Disallow in robots.txt - bij een Disallow mag Google
# de pagina niet ophalen en ziet hij de noindex dus nooit, en dan kan het adres
# alsnog kaal in de resultaten staan.
# Twee regels: /logo/* dekt de bestanden, maar niet het adres /logo zelf - daar
# staat geen schuine streep achter (html_handling in wrangler.jsonc haalt die
# weg), dus dat is een eigen pad.
/logo
  X-Robots-Tag: noindex, nofollow

/logo/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600

# De fotokeuzepagina (scripts/fotokeuze.mjs), om dezelfde reden uit de
# zoekresultaten: hij is voor Marjon om een herofoto uit te kiezen, niet voor een
# bezoeker. Twee regels om dezelfde reden als bij /logo - /fotokeuze zelf is een
# ander pad dan /fotokeuze/*.
/fotokeuze
  X-Robots-Tag: noindex, nofollow

/fotokeuze/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600

# Een dag: lang genoeg om niet bij elk bezoek opgehaald te worden, kort genoeg
# dat een nieuwe pagina binnen een dag in de sitemap staat.
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# Op alles: een site zonder deze regels is niet onveilig, maar wel een site die
# in een iframe van iemand anders kan staan, en die zijn adres meestuurt naar
# elke plek waar een bezoeker heen klikt.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
