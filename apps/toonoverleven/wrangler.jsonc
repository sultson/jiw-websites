{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "toonoverleven",
  "account_id": "aec64586d4d04a644f4f9b8225d7ca28",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // De site heeft nu tweeënzeventig vastgestelde bestemmingen plus het
    // nieuws, en die lijst hier bijhouden is een lijst die stilletjes achterloopt
    // zodra het bestuur een pagina toevoegt. Dus andersom: alles gaat langs de
    // Worker, behalve de mappen die gewoon bestanden zijn. De Worker moet elke
    // navigatie zien om de inhoud uit het beheer in de HTML te zetten en om de
    // eigen kop en foto van een pagina in de head te schrijven voordat hij
    // verstuurd wordt.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/img/*",
      "!/docs/*",
      "!/static/*",
      "!/vendor/*"
    ]
  },
  "routes": [
    {
      "pattern": "toonoverleven.jouwidealewebsite.nl",
      "custom_domain": true
    },
    // toonoverleven.nl komt binnen als Cloudflare for SaaS custom hostname op
    // onze zone (CNAME naar connect.jouwidealewebsite.nl). www is de site; de
    // Worker stuurt het kale domein met een 301 door naar www.
    { "pattern": "toonoverleven.nl/*", "zone_name": "jouwidealewebsite.nl" },
    { "pattern": "www.toonoverleven.nl/*", "zone_name": "jouwidealewebsite.nl" }
  ],
  "r2_buckets": [
    {
      "binding": "FORM_UPLOADS",
      "bucket_name": "jiw-form-uploads-prod"
    }
  ],
  "send_email": [
    {
      "name": "LEAD_EMAIL",
      "allowed_sender_addresses": ["contact@notify.jouwidealewebsite.nl"]
    }
  ],
  "vars": {
    "SITE_ID": "toonoverleven",
    // De site is www.toonoverleven.nl. Terug op "false" en elke pagina is weer
    // noindex en robots.txt verbiedt alles, in één deploy.
    "SITE_INDEXABLE": "true",
    "LEAD_RECIPIENT": "info@toonoverleven.nl",
    "LEAD_SENDER": "contact@notify.jouwidealewebsite.nl",
    "TURNSTILE_SECRET_KEY": "dev",
    // Leeg zou betekenen dat de site zijn eigen tekst rendert, en dat is een
    // werkende site in plaats van een kapotte. Geen geheim: openbaar en
    // alleen-lezen.
    "SANITY_PROJECT_ID": "z4gex0g7",
    "SANITY_DATASET": "production",
    // Gedeeld met het tabblad Voorbeeld in het beheer, dus die sleutel staat
    // ook in die bundel. Hij opent niets anders dan ongepubliceerde teksten van
    // deze site; het token dat ze leest is een geheim van de Worker.
    "PREVIEW_KEY": "iOn8UC59pa0hFXXd-pb8VWkN"
  }
}
