{
  "name": "@jiw/hulskersschilderwerken",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node tools/gen-mail-logo.mjs && node build.mjs --prod && node tools/vooraf.mjs",
    "build:dev": "node tools/gen-mail-logo.mjs && node build.mjs && node tools/vooraf.mjs --dev",
    "dev": "pnpm build:dev && wrangler dev --port=3075",
    "ship": "pnpm build && wrangler deploy",
    "ship:dry-run": "pnpm build && wrangler deploy --dry-run",
    "lint": "tsc --noEmit -p tsconfig.worker.json",
    "controleer": "node controleer.mjs",
    "meet": "node meet.mjs",
    "handtekening": "node tools/handtekening-kijk.mjs",
    "proef": "node proef.mjs",
    "indexnow": "node tools/indexnow.mjs"
  },
  "dependencies": {
    "@jiw/cloudflare-forms": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "~5.8.2"
  }
}
