{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "demo",
  "account_id": "aec64586d4d04a644f4f9b8225d7ca28",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-04-24",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every navigation goes past the Worker so it can put the Sanity content in
    // the HTML; the build's own files and the Studio's assets do not.
    "run_worker_first": ["/*", "!/assets/*", "!/static/*", "!/vendor/*"]
  },
  "routes": [
    { "pattern": "demo.jouwconcept.app", "custom_domain": true },
    { "pattern": "www.adriaantotaalonderhoud.nl/*", "zone_name": "jouwconcept.app" },
    { "pattern": "www.shorts.nu/*", "zone_name": "jouwconcept.app" }
  ],
  "vars": {
    // Public and read-only, not a secret.
    "SANITY_PROJECT_ID": "kkxa1yec",
    "SANITY_DATASET": "production",
    // Shared with the Studio's Voorbeeld tab. It only unlocks unpublished
    // demo copy; the token that reads drafts is the secret SANITY_READ_TOKEN.
    "PREVIEW_KEY": "hdCHRjtN1I-9HKZziLBWfAti"
  }
}
