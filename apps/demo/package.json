{
  "name": "@jiw/demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3076 --host=0.0.0.0",
    "build": "vite build && node scripts/build-studio.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
